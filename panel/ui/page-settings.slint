// 第 4 页（横屏 1142x404）：设置。台面仪表宽幅版——左列控制项，右列系统与电源。
// 选中态 = 底部 3px 主墨线（与竖屏同一语汇）；不画大色块、不用圆角卡片。
// 亮度：滑块直接调背光（Rust 侧写 /sys/class/backlight），拖动中 Ui.bright-drag 置位，
// 避免 4s 轮询的旧值把旋钮拽回去。
import { Theme } from "theme.slint";
import { Sys, Ui, Wifi } from "data.slint";
import { Mono, SheetHead, SegItem, ActionBtn, KeyRow } from "widgets.slint";

// 亮度滑块：视觉高度 = 轨道 8 + 旋钮 22，命中区由调用方给（44 / 56）。
// value 由调用方单向绑定（Ui.brightness）——拖动只回调 changed，由页面写回全局，
// 所以旋钮位置永远等于真实值（含 Rust 侧的下限钳位），不存在「滑杆值」与「屏幕值」两套状态。
component BrightSlider inherits Rectangle {
    in property <float> value: 50.0;
    in property <color> tint: Theme.accent;
    callback changed(float);
    callback grabbed();
    callback released();
    property <length> knob: 22px;
    property <length> track-x: root.knob / 2;
    property <length> track-w: root.width - root.knob;
    property <float> pct: Math.max(2.0, Math.min(root.value, 100.0));

    // 触摸点到百分比的换算：两端各留半个旋钮的死区
    public function pct-at(x: length) -> float {
        Math.max(2.0, Math.min(100.0, (x - root.track-x) / root.track-w * 100.0))
    }

    Rectangle {
        x: root.track-x;
        y: (root.height - 8px) / 2;
        width: root.track-w;
        height: 8px;
        border-radius: 4px;
        background: Theme.track;
        Rectangle {
            // x 必须显式写 0：子元素宽度用 parent.width 表达时，Slint 会自动生成
            // 「居中」的 x（生成代码 (parent.width - width)/2），填充块就跑到轨道正中间去了
            x: 0px;
            width: parent.width * root.pct / 100;
            height: 100%;
            border-radius: 4px;
            // 纯色，不要渐变：渐变的坐标系是填充矩形自身，宽度随进度变化 ⇒ 同一个像素
            // 的颜色会跟着进度漂移，半透明→实色的过渡带落在轨道中段就是一条脏色带
            // （8px 高的半透明渐变在暗轨道上还出色阶）。已滑过区域就该是一个选中色。
            background: root.tint;
        }
    }
    Rectangle {
        x: root.track-x + root.track-w * root.pct / 100 - root.knob / 2;
        y: (root.height - root.knob) / 2;
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        background: Theme.card;
        border-width: 2.5px;
        border-color: root.tint;
        Rectangle {
            x: (parent.width - 6px) / 2;
            y: (parent.height - 6px) / 2;
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: root.tint;
        }
    }
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.grabbed();
            }
            if (e.kind == PointerEventKind.down || (e.kind == PointerEventKind.move && self.pressed)) {
                root.changed(root.pct-at(self.mouse-x));
            }
            if (e.kind == PointerEventKind.up) {
                root.changed(root.pct-at(self.mouse-x));
                root.released();
            }
            // 控件中途被禁用/指针被抢走时 Slint 只发 cancel：这里必须复位拖动标志，
            // 否则 Ui.bright-drag 会一直挂着，4s 轮询就再也不回填亮度了
            if (e.kind == PointerEventKind.cancel) {
                root.released();
            }
        }
    }
}

// ── 横屏版（1142x404）：左列控制 / 右列系统与电源 ──
export component PageSettings inherits Rectangle {
    in property <int> idx: 3;
    x: (root.idx - Ui.page) * ((root.idx - Ui.page) <= 0 ? 395px : 1142px);
    animate x {
        duration: 520ms;
        easing: ease-out;
    }
    width: 1142px;
    height: 404px;
    property <bool> act: Ui.page == root.idx;
    opacity: act ? 1.0 : 0.0;
    animate opacity {
        duration: 420ms;
        easing: ease-out;
        delay: 40ms;
    }

    // 舱位分隔
    Rectangle {
        x: 566px;
        y: 0px;
        width: 1px;
        height: 404px;
        background: Theme.border;
    }

    // ═══ 左列 0–560：显示方向 / 外观主题 / 屏幕亮度 ═══
    SheetHead {
        x: 0px;
        y: 0px;
        width: 560px;
        title: "显示方向";
    }
    Rectangle {
        x: 0px;
        y: 28px;
        width: 560px;
        height: 56px;
        border-radius: 4px;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.border;
    }
    SegItem {
        x: 4px;
        y: 32px;
        width: 180px;
        height: 48px;
        label: "横屏";
        sub: "1170 × 540";
        sel: !Ui.portrait;
        pick => {
            Ui.set-orientation(false);
        }
    }
    SegItem {
        x: 190px;
        y: 32px;
        width: 180px;
        height: 48px;
        label: "竖屏";
        sub: "540 × 1170";
        sel: Ui.portrait;
        pick => {
            Ui.set-orientation(true);
        }
    }
    SegItem {
        x: 376px;
        y: 32px;
        width: 180px;
        height: 48px;
        label: "反转";
        sub: "再翻 180°";
        sel: Ui.flip;
        pick => {
            Ui.set-flip(!Ui.flip);
        }
    }
    Text {
        x: 0px;
        y: 90px;
        width: 560px;
        height: 16px;
        text: "当前 " + (Ui.portrait ? "竖屏 540 × 1170" : "横屏 1170 × 540") + (Ui.flip ? " · 已反转" : "") + " · 切换会重启面板（约 5 秒）";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        overflow: elide;
        vertical-alignment: TextVerticalAlignment.center;
    }

    SheetHead {
        x: 0px;
        y: 124px;
        width: 560px;
        title: "外观主题";
    }
    Rectangle {
        x: 0px;
        y: 152px;
        width: 560px;
        height: 56px;
        border-radius: 4px;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.border;
    }
    SegItem {
        x: 4px;
        y: 156px;
        width: 274px;
        height: 48px;
        label: "深色";
        sub: "夜间友好";
        sel: Theme.dark;
        pick => {
            if (!Theme.dark) {
                Ui.toggle-theme();
            }
        }
    }
    SegItem {
        x: 282px;
        y: 156px;
        width: 274px;
        height: 48px;
        label: "浅色";
        sub: "强光可读";
        sel: !Theme.dark;
        pick => {
            if (Theme.dark) {
                Ui.toggle-theme();
            }
        }
    }
    Text {
        x: 0px;
        y: 214px;
        width: 560px;
        height: 16px;
        text: "当前 " + (Theme.dark ? "深色" : "浅色") + " · 立即生效并记入 panel-theme.txt";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        overflow: elide;
        vertical-alignment: TextVerticalAlignment.center;
    }

    SheetHead {
        x: 0px;
        y: 248px;
        width: 560px;
        title: "屏幕亮度";
    }
    Text {
        x: 0px;
        y: 276px;
        height: 32px;
        text: "亮度";
        font-size: 9.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 0px;
        y: 272px;
        width: 560px;
        height: 40px;
        text: Ui.brightness-text;
        font-size: 34px;
        font-weight: 700;
        color: Theme.emphasis;
        horizontal-alignment: TextHorizontalAlignment.right;
        vertical-alignment: TextVerticalAlignment.center;
    }
    BrightSlider {
        x: 0px;
        y: 310px;
        width: 560px;
        height: 54px;
        value: Ui.brightness;
        tint: Theme.emphasis;
        changed(v) => {
            Ui.brightness = v;
            Ui.set-brightness(v);
        }
        grabbed => {
            Ui.bright-drag = true;
        }
        released => {
            Ui.bright-drag = false;
        }
    }
    Text {
        x: 0px;
        y: 368px;
        width: 560px;
        height: 12px;
        text: "拖动即时生效 · 下限 2% · 背光 /sys/class/backlight/ae94000.dsi.0";
        font-size: 8px;
        color: Theme.muted;
        font-family: Theme.font-body;
        overflow: elide;
        vertical-alignment: TextVerticalAlignment.center;
    }

    // ═══ 右列 572–1142：系统 / 电源与连接 ═══
    SheetHead {
        x: 572px;
        y: 0px;
        width: 570px;
        title: "系统";
    }
    KeyRow {
        x: 572px;
        y: 28px;
        width: 570px;
        height: 34px;
        k: "面板版本";
        v: "v" + Ui.panel-version;
    }
    KeyRow {
        x: 572px;
        y: 64px;
        width: 570px;
        height: 34px;
        k: "IPv4";
        v: Sys.ip;
    }
    KeyRow {
        x: 572px;
        y: 100px;
        width: 570px;
        height: 34px;
        k: "运行时长";
        v: Sys.uptime;
    }
    KeyRow {
        x: 572px;
        y: 136px;
        width: 570px;
        height: 34px;
        k: "采集间隔";
        v: "\{Sys.refresh-secs}s";
    }
    KeyRow {
        x: 572px;
        y: 172px;
        width: 570px;
        height: 34px;
        k: "屏幕状态";
        v: Ui.screen-on ? "亮屏" : "熄屏降负载";
    }
    KeyRow {
        x: 572px;
        y: 208px;
        width: 570px;
        height: 34px;
        k: "屏幕朝向";
        v: (Ui.portrait ? "竖屏 540 × 1170" : "横屏 1170 × 540") + (Ui.flip ? " · 反转" : "");
    }
    Rectangle {
        x: 572px;
        y: 250px;
        width: 570px;
        height: 1px;
        background: Theme.border;
    }

    SheetHead {
        x: 572px;
        y: 260px;
        width: 570px;
        title: "电源与连接";
    }
    ActionBtn {
        x: 572px;
        y: 288px;
        width: 135px;
        height: 64px;
        label: "WiFi";
        sub: Sys.wifi-ok ? Sys.wifi-ssid : "未连接";
        tint: Theme.fg;
        pick => {
            Wifi.open-wifi();
        }
    }
    ActionBtn {
        x: 717px;
        y: 288px;
        width: 135px;
        height: 64px;
        label: "蓝牙";
        sub: Sys.bt-busy ? "切换中…" : (Sys.bt-on ? "已开启" : "已关闭");
        tint: Sys.bt-on ? Theme.emphasis : Theme.muted;
        enabled: !Sys.bt-busy;
        pick => {
            Ui.set-bluetooth(!Sys.bt-on);
        }
    }
    ActionBtn {
        x: 862px;
        y: 288px;
        width: 135px;
        height: 64px;
        label: "重启";
        sub: "reboot";
        tint: Theme.emphasis;
        enabled: !Ui.power-busy;
        pick => {
            Ui.power-error = "";
            Ui.power-pending = "reboot";
        }
    }
    ActionBtn {
        x: 1007px;
        y: 288px;
        width: 135px;
        height: 64px;
        label: "关机";
        sub: "poweroff";
        tint: Theme.error;
        enabled: !Ui.power-busy;
        pick => {
            Ui.power-error = "";
            Ui.power-pending = "poweroff";
        }
    }
    Text {
        x: 572px;
        y: 358px;
        width: 570px;
        height: 14px;
        text: Sys.bt-error != "" ? Sys.bt-error : "重启 / 关机需二次确认；操作会中断采集与面板显示";
        font-size: 8.5px;
        color: Sys.bt-error != "" ? Theme.error : Theme.muted;
        font-family: Theme.font-body;
        overflow: elide;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 572px;
        y: 372px;
        width: 570px;
        height: 12px;
        text: "配置 panel-orientation / panel-flip / panel-theme / panel-brightness.txt";
        font-size: 8px;
        color: Theme.muted;
        font-family: Theme.font-body;
        overflow: elide;
        vertical-alignment: TextVerticalAlignment.center;
    }
}

// ── 竖屏版（508x992）：控制面板 ──
// 控件是「轨道 + 盖印」：一条细描边轨道里，选中格填主墨、字反白；
// 破坏性操作（重启/关机）单独放在页面底部的「电源与连接」区，远离上面的误触区。
export component PageSettingsP inherits Rectangle {
    in property <int> idx: 3;
    x: (root.idx - Ui.page) * ((root.idx - Ui.page) <= 0 ? 256px : 508px);
    animate x {
        duration: 520ms;
        easing: ease-out;
    }
    width: 508px;
    height: 992px;
    property <bool> act: Ui.page == root.idx;
    opacity: act ? 1.0 : 0.0;
    animate opacity {
        duration: 420ms;
        easing: ease-out;
        delay: 40ms;
    }

    // ═══ 显示方向 ═══ 0–118
    SheetHead {
        x: 0px;
        y: 0px;
        width: 508px;
        title: "显示方向";
    }
    Rectangle {
        x: 0px;
        y: 32px;
        width: 508px;
        height: 64px;
        border-radius: 4px;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.border;
    }
    SegItem {
        x: 4px;
        y: 36px;
