        x: 0px;
        y: 148px;
        width: 508px;
        title: "外观主题";
    }
    Rectangle {
        x: 0px;
        y: 180px;
        width: 508px;
        height: 64px;
        border-radius: 4px;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.border;
    }
    SegItem {
        x: 4px;
        y: 184px;
        width: 248px;
        height: 56px;
        label: "深色";
        sub: "夜间友好";
        sel: Theme.dark;
        pick => {
            if (!Theme.dark) {
                Ui.toggle-theme();
            }
        }
