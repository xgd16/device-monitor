    SegItem {
        x: 256px;
        y: 184px;
        width: 248px;
        height: 56px;
        label: "浅色";
        sub: "强光可读";
        sel: !Theme.dark;
        pick => {
            if (Theme.dark) {
                Ui.toggle-theme();
            }
        }
    }
    Text {
        x: 0px;
        y: 252px;
        width: 508px;
        text: "当前 " + (Theme.dark ? "深色" : "浅色") + " · 立即生效并记入 panel-theme.txt";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        overflow: elide;
    }

    // ═══ 屏幕亮度 ═══ 296–466
    SheetHead {
        x: 0px;
        y: 296px;
