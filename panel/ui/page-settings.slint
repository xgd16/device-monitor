// 第 4 页：设置。显示方向（横/竖/反转）+ 外观主题 + 屏幕亮度 + 关于。
//
// 交互控件（v2）：旧版把选项做成 170x152（竖版 154x190）的大色块，按键几乎占满整张卡，
// 信息密度极低。现在改成一行分段按钮（segmented control）：
//   · 高度 52（竖版 64）逻辑像素 = 104 / 128 物理像素 ≈ 6.5 / 8.0 mm，
//     是本机触摸屏「能稳稳点中」的下限，同时不再喧宾夺主；
//   · 选中态只用主题色描边 + 淡色底 + 彩色副标题表达，不引入新的硬编码色值；
//   · 卡片留白改为「提示在上、控件居中、当前值在下」，比旧版更好扫读。
// 亮度：滑块直接调背光（Rust 侧 POST /api/hardware/brightness → 写 /sys/class/backlight），
// 滑杆命中区 44（竖版 56）高，拖动中 Ui.bright-drag 置位，避免 4s 轮询的旧值把旋钮拽回去。
// 横版 1142x404：2x2 四卡；竖版 512x1028 单列四卡。
import { Theme } from "theme.slint";
import { Sys, Ui } from "data.slint";
import { Card, Mono } from "widgets.slint";

// 分段按钮：单行两段文字（主标签 + 副说明），高度由调用方给。
// 按下即变暗（无过渡动画，瞬时不烧渲染循环）；选中态 = 主题色描边 + 14% 淡色底。
component SegBtn inherits Rectangle {
    in property <string> label;
    in property <string> sub: "";
    in property <bool> sel;
    in property <color> tint: Theme.accent;
    callback pick();
    accessible-role: button;
    accessible-label: root.label + " " + root.sub;
    border-radius: 13px;
    background: root.sel ? root.tint.with-alpha(0.14) : Theme.card-alt;
    border-width: 1.5px;
    border-color: root.sel ? root.tint : Theme.border;
    animate background {
        duration: 180ms;
        easing: ease-out;
    }
    animate border-color {
        duration: 180ms;
        easing: ease-out;
    }
    VerticalLayout {
        padding: 5px;
        alignment: center;
        spacing: 0px;
        Text {
            text: root.label;
            font-size: 15px;
            font-weight: 700;
            color: root.sel ? Theme.emphasis : Theme.fg;
            font-family: Theme.font-body;
            horizontal-alignment: TextHorizontalAlignment.center;
        }
        Text {
            text: root.sub;
            font-size: 8.5px;
            color: root.sel ? root.tint : Theme.muted;
            font-family: Theme.font-body;
            horizontal-alignment: TextHorizontalAlignment.center;
        }
    }
    ta := TouchArea {
        clicked => {
            root.pick();
        }
    }
    opacity: ta.pressed ? 0.78 : 1.0;
}

// 亮度滑块：视觉高度 = 轨道 8 + 旋钮 22，命中区由调用方给（44 / 56）。
// value 由调用方单向绑定（Ui.brightness）——拖动只回调 changed，由页面写回全局，
// 所以旋钮位置永远等于真实值（含 Rust 侧的下限钳位），不存在「滑杆值」与「屏幕值」两套状态。
component BrightSlider inherits Rectangle {
    in property <float> value: 50.0;
    callback changed(float);
    callback grabbed();
    callback released();
    property <length> knob: 22px;
    property <length> track-x: root.knob / 2;
    property <length> track-w: root.width - root.knob;
    property <float> pct: Math.max(2.0, Math.min(root.value, 100.0));

    // 触摸点到百分比的换算：两端各留半个旋钮的死区
    public function pct-at(x: length) -> float {
        Math.max(2.0, Math.min(100.0, (x - root.track-x) / root.track-w * 100.0))
    }

    Rectangle {
        x: root.track-x;
        y: (root.height - 8px) / 2;
        width: root.track-w;
        height: 8px;
        border-radius: 4px;
        background: Theme.track;
        Rectangle {
            // x 必须显式写 0：子元素宽度用 parent.width 表达时，Slint 会自动生成
            // 「居中」的 x（生成代码 (parent.width - width)/2），填充块就跑到轨道正中间去了
            x: 0px;
            width: parent.width * root.pct / 100;
            height: 100%;
            border-radius: 4px;
            // 纯色，不要渐变：渐变的坐标系是填充矩形自身，宽度随进度变化 ⇒ 同一个像素
            // 的颜色会跟着进度漂移，半透明→实色的过渡带落在轨道中段就是一条脏色带
            // （8px 高的半透明渐变在暗轨道上还出色阶）。已滑过区域就该是一个选中色。
            background: Theme.accent;
        }
    }
    Rectangle {
        x: root.track-x + root.track-w * root.pct / 100 - root.knob / 2;
        y: (root.height - root.knob) / 2;
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        background: Theme.card;
        border-width: 2.5px;
        border-color: Theme.accent;
        Rectangle {
            x: (parent.width - 6px) / 2;
            y: (parent.height - 6px) / 2;
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: Theme.accent;
        }
    }
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.grabbed();
            }
            if (e.kind == PointerEventKind.down || (e.kind == PointerEventKind.move && self.pressed)) {
                root.changed(root.pct-at(self.mouse-x));
            }
            if (e.kind == PointerEventKind.up) {
                root.changed(root.pct-at(self.mouse-x));
                root.released();
            }
            // 控件中途被禁用/指针被抢走时 Slint 只发 cancel：这里必须复位拖动标志，
            // 否则 Ui.bright-drag 会一直挂着，4s 轮询就再也不回填亮度了
            if (e.kind == PointerEventKind.cancel) {
                root.released();
            }
        }
    }
}

// 键值行：键左灰、值右亮（等宽）
component Kv inherits Rectangle {
    in property <string> k;
    in property <string> v;
    height: 26px;
    Text {
        x: 0px;
        y: Theme.text-nudge;
        height: parent.height;
        vertical-alignment: TextVerticalAlignment.center;
        text: root.k;
        font-size: 9px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Mono {
        x: 88px;
        width: parent.width - 88px;
        y: Theme.text-nudge;
        height: parent.height;
        vertical-alignment: TextVerticalAlignment.center;
        text: root.v;
        font-size: 10px;
        color: Theme.emphasis;
        horizontal-alignment: TextHorizontalAlignment.right;
    }
}

// 卡片内分隔发丝线
component Hairline inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

// ── 横屏版（1142x404）：2x2 四卡 ──
export component PageSettings inherits Rectangle {
    in property <int> idx: 3;
    x: (root.idx - Ui.page) * ((root.idx - Ui.page) <= 0 ? 395px : 1142px);
    animate x {
        duration: 520ms;
        easing: ease-out;
    }
    width: 1142px;
    height: 404px;
    // 非激活页全透明：滑动复位后相邻页不得透出（与其他页一致）
    property <bool> act: Ui.page == root.idx;
    opacity: act ? 1.0 : 0.0;
    animate opacity {
        duration: 420ms;
        easing: ease-out;
        delay: 40ms;
    }

    Card {
        x: 0px;
        y: 0px;
        width: 560px;
        height: 196px;
        title: "显示方向";
        Text {
            x: 14px;
            y: 30px;
            width: 532px;
            text: "切换方向或反转会让面板重启（约 5 秒），触摸坐标自动跟随朝向；选择会持久保存。";
            font-size: 8.5px;
            color: Theme.muted;
            font-family: Theme.font-body;
            wrap: word-wrap;
        }
        SegBtn {
            x: 14px;
            y: 86px;
            width: 170px;
            height: 52px;
            label: "横屏";
            sub: "1170 × 540";
            sel: !Ui.portrait;
            pick => {
                Ui.set-orientation(false);
            }
        }
        SegBtn {
            x: 195px;
            y: 86px;
            width: 170px;
            height: 52px;
            label: "竖屏";
            sub: "540 × 1170";
            tint: Theme.accent2;
            sel: Ui.portrait;
            pick => {
                Ui.set-orientation(true);
            }
        }
        SegBtn {
            x: 376px;
            y: 86px;
            width: 170px;
            height: 52px;
            label: "反转";
            sub: "再翻 180°";
            tint: Theme.warning;
            sel: Ui.flip;
            pick => {
                Ui.set-flip(!Ui.flip);
            }
        }
        Hairline {
            x: 14px;
            y: 152px;
            width: 532px;
        }
        Text {
            x: 14px;
            y: 162px;
            width: 532px;
            text: "当前 " + (Ui.portrait ? "竖屏 540 × 1170" : "横屏 1170 × 540") + (Ui.flip ? " · 已反转" : "");
            font-size: 8.5px;
            color: Theme.muted;
            font-family: Theme.font-body;
        }
    }

    Card {
        x: 576px;
        y: 0px;
        width: 566px;
        height: 196px;
        title: "外观主题";
        Text {
            x: 14px;
            y: 30px;
            width: 538px;
            text: "立即生效并记入 panel-theme.txt。深色适配夜间与熄屏前，浅色适配强光环境。";
            font-size: 8.5px;
            color: Theme.muted;
            font-family: Theme.font-body;
            wrap: word-wrap;
        }
        SegBtn {
            x: 14px;
            y: 86px;
            width: 265px;
            height: 52px;
            label: "深色";
            sub: "夜间友好";
            sel: Theme.dark;
            pick => {
                if (!Theme.dark) {
                    Ui.toggle-theme();
                }
            }
        }
        SegBtn {
            x: 287px;
            y: 86px;
            width: 265px;
            height: 52px;
            label: "浅色";
            sub: "强光可读";
            tint: Theme.warning;
            sel: !Theme.dark;
            pick => {
                if (Theme.dark) {
                    Ui.toggle-theme();
                }
            }
        }
        Hairline {
            x: 14px;
            y: 152px;
            width: 538px;
        }
        Text {
            x: 14px;
            y: 162px;
            width: 538px;
            text: "当前 " + (Theme.dark ? "深色" : "浅色") + " · 底栏开关与这里同源";
            font-size: 8.5px;
            color: Theme.muted;
            font-family: Theme.font-body;
        }
    }

    Card {
        x: 0px;
        y: 208px;
        width: 560px;
        height: 196px;
        title: "屏幕亮度";
        Text {
            x: 14px;
            y: 30px;
            width: 532px;
            text: "拖动即时生效；下限 2%，避免拖到全黑后连触摸都找不回来。";
            font-size: 8.5px;
            color: Theme.muted;
            font-family: Theme.font-body;
            wrap: word-wrap;
        }
        Text {
            x: 14px;
            y: 62px;
            text: "亮度";
            font-size: 9px;
            color: Theme.muted;
            font-family: Theme.font-body;
        }
        Mono {
            x: 306px;
            y: 54px;
            width: 240px;
            text: Ui.brightness-text;
            font-size: 22px;
            font-weight: 700;
            color: Theme.accent;
            horizontal-alignment: TextHorizontalAlignment.right;
        }
        BrightSlider {
            x: 14px;
            y: 100px;
            width: 532px;
            height: 44px;
            value: Ui.brightness;
            changed(v) => {
                Ui.brightness = v;
                Ui.set-brightness(v);
            }
            grabbed => {
                Ui.bright-drag = true;
            }
            released => {
                Ui.bright-drag = false;
            }
        }
        Hairline {
            x: 14px;
            y: 160px;
            width: 532px;
        }
        Text {
            x: 14px;
            y: 170px;
            width: 532px;
            text: "背光 /sys/class/backlight/ae94000.dsi.0（0–2047）· 记忆 panel-brightness.txt";
            font-size: 8px;
            color: Theme.muted;
            font-family: Theme.font-body;
        }
    }

    Card {
        x: 576px;
        y: 208px;
        width: 566px;
        height: 196px;
        title: "关于";
        Kv {
            x: 14px;
            y: 44px;
            width: 262px;
            k: "面板版本";
            v: "v" + Ui.panel-version;
        }
        Kv {
            x: 290px;
            y: 44px;
            width: 262px;
            k: "运行时长";
            v: Sys.uptime;
        }
        Kv {
            x: 14px;
            y: 78px;
            width: 262px;
            k: "采集间隔";
            v: "\{Sys.refresh-secs}s";
        }
        Kv {
            x: 290px;
            y: 78px;
            width: 262px;
            k: "屏幕状态";
            v: Ui.screen-on ? "亮屏" : "熄屏降负载";
        }
        Kv {
            x: 14px;
            y: 112px;
            width: 262px;
            k: "屏幕朝向";
            v: (Ui.portrait ? "竖屏 540 × 1170" : "横屏 1170 × 540") + (Ui.flip ? " · 反转" : "");
        }
        Kv {
            x: 290px;
            y: 112px;
            width: 262px;
            k: "外观主题";
            v: Theme.dark ? "深色" : "浅色";
        }
        Hairline {
            x: 14px;
            y: 150px;
            width: 538px;
        }
        Text {
            x: 14px;
            y: 160px;
            width: 538px;
            text: "数据源 API :3000 · XTokenHub :9192 · Open-Meteo 天气";
            font-size: 8px;
            color: Theme.muted;
            font-family: Theme.font-body;
        }
        Text {
            x: 14px;
            y: 176px;
            width: 538px;
            text: "配置 panel-orientation / panel-flip / panel-theme / panel-brightness.txt";
            font-size: 8px;
            color: Theme.muted;
            font-family: Theme.font-body;
        }
    }
}

// ── 竖屏版（512x1028）：单列四卡；控件高度 64（≈8 mm），竖握时更好点 ──
