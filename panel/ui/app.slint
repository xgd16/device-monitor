// 面板壳层：横屏 1170x540 / 竖屏 540x1170 逻辑分辨率（SLINT_SCALE_FACTOR=2 → 物理 2340x1080）。
// 结构：顶栏（状态/主机/页签/时钟）+ 翻页容器（滑动切换）+ 底栏（IP/速率/VPN/主题/页码）。
// 竖屏模式是进程常量（Ui.portrait，由 Rust 侧启动时决定），切换 = 面板重启换向。
import { Theme } from "theme.slint";
import { Sys, Clk, Ui, Wifi } from "data.slint";
import { LiveDot, Mono, Tick } from "widgets.slint";
import { PageSystem } from "page-system.slint";
import { PageToken } from "page-token.slint";
import { PageClock } from "page-clock.slint";
import { PageSettings } from "page-settings.slint";
import { PageSystemP } from "page-system.slint";
import { PageTokenP } from "page-token.slint";
import { PageClockP } from "page-clock.slint";
import { PageSettingsP } from "page-settings.slint";
import { WifiOverlay } from "wifi.slint";

// 电源确认层按钮：filled=true 为实底主操作，false 为次级「取消」。
component DialogBtn inherits Rectangle {
    in property <string> label;
    in property <color> tint: Theme.accent;
    in property <bool> filled: false;
    callback pick();
    height: 52px;
    border-radius: 4px;
    background: root.filled ? root.tint : Theme.card-alt;
    border-width: 1px;
    border-color: root.filled ? root.tint : Theme.border;
    Text {
        x: 0px;
        width: 100%;
        y: Theme.text-nudge;
        height: 100%;
        text: root.label;
        font-size: 12px;
        font-weight: 700;
        color: root.filled ? (Theme.dark ? #071019 : #FFFFFF) : Theme.fg;
        font-family: Theme.font-body;
        horizontal-alignment: TextHorizontalAlignment.center;
        vertical-alignment: TextVerticalAlignment.center;
    }
    ta := TouchArea {
        clicked => {
            root.pick();
        }
    }
    opacity: ta.pressed ? 0.80 : 1.0;
}

// 电源确认卡片：横竖屏共用，尺寸随 Ui.portrait 切换。
// 只在 Ui.power-pending 非空时由 App 挂载；确认后切换成「正在重启/关机…」，
// 不再接受点击（Ui.power-busy）。
component PowerDialog inherits Rectangle {
    property <length> pad: 24px;
    property <length> btn-y: root.height - 72px;
    // 横竖屏统一为台面仪表的方角 + 主墨（确认层是面板的一部分，不是另一套皮肤）。
    property <color> tint: Ui.power-pending == "reboot" ? Theme.emphasis : Theme.error;
    width: Ui.portrait ? 468px : 520px;
    height: Ui.power-busy ? 190px : (Ui.portrait ? 300px : 250px);
    border-radius: 6px;
    background: Theme.card;
    border-width: 1px;
    border-color: root.tint.with-alpha(0.55);
    // 吃掉卡片空白区域的点击，避免点文字时穿透到遮罩把弹窗关掉
    TouchArea {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
    }

    Rectangle {
        x: root.pad;
        y: 0px;
        width: 42px;
        height: 3px;
        border-radius: 1.5px;
        background: root.tint;
    }
    Text {
        x: root.pad;
        y: 18px;
        text: "电源操作 · POWER";
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1px;
        color: root.tint;
        font-family: Theme.font-mono;
    }
    Text {
        x: root.pad;
        y: 38px;
        width: root.width - root.pad * 2;
        text: Ui.power-busy
            ? (Ui.power-pending == "reboot" ? "正在重启…" : "正在关机…")
            : (Ui.power-pending == "reboot" ? "确认重启设备？" : "确认关机设备？");
        font-size: 22px;
        height: 22px;
        vertical-alignment: TextVerticalAlignment.center;
        font-weight: 700;
        color: Theme.emphasis;
        font-family: Theme.font-body;
    }
    Text {
        x: root.pad;
        y: 78px;
        width: root.width - root.pad * 2;
        text: Ui.power-busy
            ? "请求已下发，设备即将断开连接，请稍候。"
            : (Ui.power-pending == "reboot"
                ? "设备将立即重启，约 20–40 秒后自动恢复；采集与面板显示会中断。"
                : "设备将完全断电，需要按电源键或重新插电才能开机。");
        font-size: 10px;
        color: Theme.muted;
        font-family: Theme.font-body;
        wrap: word-wrap;
    }
    if Ui.power-error != "" : Text {
        x: root.pad;
        y: 132px;
        width: root.width - root.pad * 2;
        text: "下发失败：" + Ui.power-error;
        font-size: 9px;
        color: Theme.error;
        font-family: Theme.font-body;
        wrap: word-wrap;
    }
    if Ui.power-error == "" && !Ui.power-busy : Text {
        x: root.pad;
        y: 140px;
        width: root.width - root.pad * 2;
        text: "此操作不可撤销";
        font-size: 9px;
        color: Theme.warning;
        font-family: Theme.font-body;
    }
    if !Ui.power-busy : HorizontalLayout {
        x: root.pad;
        y: root.btn-y;
        width: root.width - root.pad * 2;
        height: 52px;
        spacing: 12px;
        DialogBtn {
            label: "取消";
            tint: Theme.muted;
            horizontal-stretch: 1;
            pick => {
                Ui.power-pending = "";
            }
        }
        DialogBtn {
            label: Ui.power-pending == "reboot" ? "确认重启" : "确认关机";
            tint: root.tint;
            filled: true;
            horizontal-stretch: 1;
            pick => {
                if (!Ui.power-busy) {
                    Ui.power-busy = true;
                    Ui.power-error = "";
                    Ui.power-confirm(Ui.power-pending);
                }
            }
        }
    }
}

// Rust 侧要访问的全局与结构体必须从主文件 re-export
export { Theme } from "theme.slint";
export { Sys, Clk, Ui, Tok, Wifi } from "data.slint";
export { CoreRow, ThermalRow, ProcRow, SvcRow, RankRow, ChanRow, KeyRow, CityRow, ProgRow, WifiRow } from "data.slint";

export component App inherits Window {
    width: Ui.portrait ? 540px : 1170px;
    height: Ui.portrait ? 1170px : 540px;
    background: Theme.bg;
    default-font-family: Theme.font-body;

    FocusScope {
        width: 100%;
        height: 100%;
        init => {
            self.focus();
        }
        key-pressed(e) => {
            // 电源确认层 / WiFi 操作页打开时吞掉所有按键，避免方向键在背后切页
            if (Ui.power-pending != "" || Wifi.visible) {
                return accept;
            }
            if (e.text == Key.RightArrow) {
                Ui.next();
                return accept;
            }
            if (e.text == Key.LeftArrow) {
                Ui.prev();
                return accept;
            }
            if (e.text == "t" || e.text == "T") {
                Ui.toggle-theme();
                return accept;
            }
            reject
        }

        // ── 横屏壳（1170x540）：同一块台面仪表的宽幅版 ──
        // 顶轨 0–64（状态灯/主机/四格页签/时钟），内容 64–468（页面 1142x404），
        // 底轨 468–540（IP/收发/VPN/页标/主题）。两条填充横轨 + 连续面板，
        // 分组靠标题 + 发丝线，不画卡片框、不铺氛围光。
        if !Ui.portrait: Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;

            // ── 顶轨 ──
            Rectangle {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 64px;
                background: Theme.card;
            }
            Rectangle {
                x: 0px;
                y: 63px;
                width: 100%;
                height: 1px;
                background: Theme.border;
            }
            LiveDot {
                x: 18px;
                y: 14px;
                tint: Sys.online ? Theme.success : Theme.error;
                on: Sys.online;
            }
            Text {
                x: 34px;
                y: 6px;
                width: 310px;
                height: 24px;
                text: Sys.hostname;
                font-size: 15px;
                font-weight: 700;
                color: Theme.emphasis;
                vertical-alignment: TextVerticalAlignment.center;
                overflow: elide;
            }
            Text {
                x: 34px;
                y: 30px;
                width: 310px;
                height: 14px;
                text: "Mi Mix 3 · 运行 " + Sys.uptime + " · 采集 \{Sys.refresh-secs}s";
                font-size: 9px;
                color: Theme.muted;
                vertical-alignment: TextVerticalAlignment.center;
                overflow: elide;
            }
            // 四格页签：等宽 110，选中格下方 2px 主墨线（与竖屏同一语汇）
            for i in [0, 1, 2, 3]: Rectangle {
                x: 365px + i * 110px;
                y: 12px;
                width: 110px;
                height: 44px;
                accessible-role: button;
                accessible-label: ["系统监控", "Token 用量", "时钟", "设置"][i];
                Text {
                    x: 0px;
                    width: 100%;
                    height: 100%;
                    y: Theme.text-nudge;
                    text: ["系统监控", "Token 用量", "时钟", "设置"][i];
                    font-size: 11px;
                    font-weight: Ui.page == i ? 700 : 400;
                    color: Ui.page == i ? Theme.emphasis : Theme.muted;
                    horizontal-alignment: TextHorizontalAlignment.center;
                    vertical-alignment: TextVerticalAlignment.center;
                }
                TouchArea {
                    clicked => {
                        Ui.go(i);
                    }
                }
            }
            Rectangle {
                x: 365px + Ui.page * 110px;
                y: 61px;
                width: 110px;
                height: 2px;
                background: Theme.emphasis;
                animate x {
                    duration: 240ms;
                    easing: ease-out;
                }
            }
            Mono {
                x: 960px;
                y: 4px;
                width: 196px;
                height: 34px;
                text: Clk.hh + ":" + Clk.mm + ":" + Clk.ss;
                font-size: 26px;
                font-weight: 700;
                color: Theme.emphasis;
                horizontal-alignment: TextHorizontalAlignment.right;
                vertical-alignment: TextVerticalAlignment.center;
            }
            Text {
                x: 960px;
                y: 38px;
                width: 196px;
                height: 16px;
                text: Clk.date-line;
                font-size: 9px;
                color: Theme.muted;
                horizontal-alignment: TextHorizontalAlignment.right;
                vertical-alignment: TextVerticalAlignment.center;
            }

            // ── 页面容器（横向滑动切换）──
            Rectangle {
                x: 14px;
                y: 64px;
                width: 1142px;
                height: 404px;
                clip: true;
                // 滑动层声明在页面之前（z 序在下层）：按控件 = 控件处理，按空白 = 切页。
                TouchArea {
                    property <length> press-x: 0px;
                    pointer-event(e) => {
                        Ui.touch-probe = true;
                        Ui.probe-x = self.mouse-x + 14px;
                        Ui.probe-y = self.mouse-y + 64px;
                        Ui.probe(self.mouse-x / 1px, self.mouse-y / 1px, (e.kind == PointerEventKind.down ? "swipe-down" : (e.kind == PointerEventKind.up ? "swipe-up" : "swipe-move")));
                        if (e.kind == PointerEventKind.down) {
                            press-x = self.mouse-x;
                        }
                        if (e.kind == PointerEventKind.up) {
                            if (self.mouse-x - press-x > 90px) {
                                Ui.prev();
                            }
                            if (self.mouse-x - press-x < -90px) {
                                Ui.next();
                            }
                        }
                    }
                }
                PageSystem {
                    idx: 0;
                    y: 0px;
                }
                PageToken {
                    idx: 1;
                    y: 0px;
                }
                PageClock {
                    idx: 2;
                    y: 0px;
                }
                PageSettings {
                    idx: 3;
                    y: 0px;
                }
            }

            // ── 底轨 ──
            Rectangle {
                x: 0px;
                y: 468px;
                width: 100%;
                height: 72px;
                background: Theme.card;
            }
            Rectangle {
                x: 0px;
                y: 468px;
                width: 100%;
                height: 1px;
                background: Theme.border;
            }
            Text {
                x: 16px;
                y: 486px;
                height: 36px;
                text: "IPv4";
                font-size: 8.5px;
                color: Theme.muted;
                vertical-alignment: TextVerticalAlignment.center;
            }
            Mono {
                x: 44px;
                y: 486px;
                width: 136px;
                height: 36px;
                text: Sys.ip;
                font-size: 10.5px;
                color: Theme.fg;
                vertical-alignment: TextVerticalAlignment.center;
            }
            Mono {
                x: 190px;
                y: 486px;
                width: 110px;
                height: 36px;
                text: "↓ " + Sys.rx;
                font-size: 9.5px;
                color: Theme.info;
                vertical-alignment: TextVerticalAlignment.center;
            }
            Mono {
                x: 308px;
                y: 486px;
                width: 110px;
                height: 36px;
                text: "↑ " + Sys.tx;
                font-size: 9.5px;
                color: Theme.accent2;
                vertical-alignment: TextVerticalAlignment.center;
            }
            Text {
                x: 430px;
                y: 486px;
                width: 40px;
                height: 36px;
                text: Sys.vpn-kind;
                font-size: 8.5px;
                color: Theme.muted;
                vertical-alignment: TextVerticalAlignment.center;
            }
            Text {
                x: 470px;
                y: 486px;
                width: 330px;
                height: 36px;
                text: Sys.vpn-node;
                font-size: 10px;
                font-weight: 700;
                color: Sys.vpn-ok ? Theme.success : Theme.muted;
                overflow: elide;
                vertical-alignment: TextVerticalAlignment.center;
            }
            HorizontalLayout {
                x: 884px;
                y: 488px;
                width: 84px;
                height: 32px;
                spacing: 6px;
                Tick {
                    active: Ui.page == 0;
                    idx: 0;
                    pick => {
                        Ui.go(0);
                    }
                }
                Tick {
                    active: Ui.page == 1;
                    idx: 1;
                    pick => {
                        Ui.go(1);
                    }
                }
                Tick {
                    active: Ui.page == 2;
                    idx: 2;
                    pick => {
                        Ui.go(2);
                    }
                }
                Tick {
                    active: Ui.page == 3;
                    idx: 3;
                    pick => {
                        Ui.go(3);
                    }
                }
            }
            Mono {
                x: 986px;
                y: 486px;
                width: 96px;
                height: 36px;
                text: "第 \{(Ui.page + 1)} / 4 页";
                font-size: 8.5px;
                color: Theme.muted;
                horizontal-alignment: TextHorizontalAlignment.right;
                vertical-alignment: TextVerticalAlignment.center;
            }
            Rectangle {
                x: 1090px;
                y: 490px;
                width: 46px;
                height: 28px;
                border-radius: 4px;
                background: transparent;
                border-width: 1px;
                border-color: Theme.border;
                Text {
                    x: 0px;
                    width: 100%;
                    height: 100%;
                    y: Theme.text-nudge;
                    text: Theme.dark ? "浅色" : "深色";
                    font-size: 8.5px;
                    font-weight: 600;
                    color: Theme.fg;
                    horizontal-alignment: TextHorizontalAlignment.center;
                    vertical-alignment: TextVerticalAlignment.center;
                }
                TouchArea {
                    clicked => {
                        Ui.toggle-theme();
                    }
                }
            }
        }

        // ── 竖屏壳（540x1170）：台面仪表 ──
        // 顶轨 0–104（状态灯/主机/时钟/四格模式选择器），内容 104–1096，
        // 底轨 1096–1170（IP/收发/页标/主题）。整屏只有两条填充横轨，
        // 中间是连续面板：分组靠标题 + 发丝线，不画卡片框。
        if Ui.portrait: Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;

            // ── 顶轨 ──
            Rectangle {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 104px;
                background: Theme.card;
            }
            Rectangle {
                x: 0px;
                y: 103px;
                width: 100%;
                height: 1px;
                background: Theme.border;
            }
            LiveDot {
                x: 18px;
                y: 24px;
                tint: Sys.online ? Theme.success : Theme.error;
                on: Sys.online;
            }
            Text {
                x: 34px;
                y: 13px;
                width: 290px;
                height: 24px;
                text: Sys.hostname;
                font-size: 15px;
                font-weight: 700;
                color: Theme.emphasis;
                vertical-alignment: TextVerticalAlignment.center;
                overflow: elide;
            }
            Text {
                x: 34px;
                y: 38px;
                width: 290px;
                text: "Mi Mix 3 · 运行 " + Sys.uptime + " · 采集 \{Sys.refresh-secs}s";
                font-size: 9px;
                color: Theme.muted;
                overflow: elide;
            }
            Mono {
                x: 330px;
                y: 8px;
                width: 192px;
                height: 40px;
                text: Clk.hh + ":" + Clk.mm + ":" + Clk.ss;
                font-size: 30px;
                font-weight: 700;
                color: Theme.emphasis;
                horizontal-alignment: TextHorizontalAlignment.right;
                vertical-alignment: TextVerticalAlignment.center;
            }
            Text {
                x: 330px;
                y: 49px;
                width: 192px;
                text: Clk.date-line;
                font-size: 9px;
                color: Theme.muted;
                horizontal-alignment: TextHorizontalAlignment.right;
            }

            // 模式选择器：四格等宽 127，选中格下方 2px 主墨线（滑动）
            for i in [0, 1, 2, 3]: Rectangle {
                x: 16px + i * 127px;
                y: 56px;
                width: 127px;
                height: 44px;
                accessible-role: button;
                accessible-label: ["系统监控", "Token 用量", "时钟", "设置"][i];
                Text {
                    x: 0px;
                    width: 100%;
                    height: 100%;
                    y: Theme.text-nudge;
                    text: ["系统监控", "Token 用量", "时钟", "设置"][i];
                    font-size: 11px;
                    font-weight: Ui.page == i ? 700 : 400;
                    color: Ui.page == i ? Theme.emphasis : Theme.muted;
                    horizontal-alignment: TextHorizontalAlignment.center;
                    vertical-alignment: TextVerticalAlignment.center;
                }
                TouchArea {
                    clicked => {
                        Ui.go(i);
                    }
                }
            }
            Rectangle {
                x: 16px + Ui.page * 127px;
                y: 102px;
                width: 127px;
                height: 2px;
                background: Theme.emphasis;
                animate x {
                    duration: 240ms;
                    easing: ease-out;
                }
            }

            // ── 页面容器（横向滑动切换；滑动层必须在页面之前）──
            Rectangle {
                x: 16px;
                y: 104px;
                width: 508px;
                height: 992px;
                clip: true;
                TouchArea {
                    property <length> press-x: 0px;
                    pointer-event(e) => {
                        Ui.touch-probe = true;
                        Ui.probe-x = self.mouse-x + 16px;
                        Ui.probe-y = self.mouse-y + 104px;
                        Ui.probe(self.mouse-x / 1px, self.mouse-y / 1px, (e.kind == PointerEventKind.down ? "p-swipe-down" : (e.kind == PointerEventKind.up ? "p-swipe-up" : "p-swipe-move")));
                        if (e.kind == PointerEventKind.down) {
                            press-x = self.mouse-x;
                        }
                        if (e.kind == PointerEventKind.up) {
                            if (self.mouse-x - press-x > 90px) {
                                Ui.prev();
                            }
                            if (self.mouse-x - press-x < -90px) {
                                Ui.next();
                            }
                        }
                    }
                }
                PageSystemP {
                    idx: 0;
                    y: 0px;
                }
                PageTokenP {
                    idx: 1;
                    y: 0px;
                }
                PageClockP {
                    idx: 2;
                    y: 0px;
                }
                PageSettingsP {
                    idx: 3;
                    y: 0px;
                }
            }

            // ── 底轨：IP / 收发 / 页标 / 主题 ──
            Rectangle {
                x: 0px;
                y: 1096px;
                width: 100%;
                height: 74px;
                background: Theme.card;
            }
            Rectangle {
                x: 0px;
                y: 1096px;
                width: 100%;
                height: 1px;
                background: Theme.border;
            }
            Text {
                x: 16px;
                y: 1116px;
                height: 32px;
                text: "IPv4";
                font-size: 8.5px;
                color: Theme.muted;
                vertical-alignment: TextVerticalAlignment.center;
            }
            Mono {
                x: 44px;
                y: 1116px;
                width: 112px;
                height: 32px;
                text: Sys.ip;
                font-size: 10.5px;
                color: Theme.fg;
                vertical-alignment: TextVerticalAlignment.center;
            }
            Mono {
                x: 160px;
                y: 1116px;
                width: 108px;
                height: 32px;
                text: "↓ " + Sys.rx;
                font-size: 9.5px;
                color: Theme.info;
                vertical-alignment: TextVerticalAlignment.center;
            }
            Mono {
                x: 272px;
                y: 1116px;
                width: 104px;
                height: 32px;
                text: "↑ " + Sys.tx;
                font-size: 9.5px;
                color: Theme.accent2;
                vertical-alignment: TextVerticalAlignment.center;
            }
            HorizontalLayout {
                x: 384px;
                y: 1118px;
                width: 84px;
                height: 28px;
                spacing: 6px;
                alignment: end;
                Tick {
                    active: Ui.page == 0;
                    idx: 0;
                    pick => {
                        Ui.go(0);
                    }
                }
                Tick {
                    active: Ui.page == 1;
                    idx: 1;
                    pick => {
                        Ui.go(1);
                    }
                }
                Tick {
                    active: Ui.page == 2;
                    idx: 2;
                    pick => {
                        Ui.go(2);
                    }
                }
                Tick {
                    active: Ui.page == 3;
                    idx: 3;
                    pick => {
                        Ui.go(3);
                    }
                }
            }
            Rectangle {
                x: 478px;
                y: 1117px;
                width: 46px;
                height: 28px;
                border-radius: 4px;
                background: transparent;
                border-width: 1px;
                border-color: Theme.border;
                Text {
                    x: 0px;
                    width: 100%;
                    height: 100%;
                    y: Theme.text-nudge;
                    text: Theme.dark ? "浅色" : "深色";
                    font-size: 8.5px;
                    font-weight: 600;
                    color: Theme.fg;
                    horizontal-alignment: TextHorizontalAlignment.center;
                    vertical-alignment: TextVerticalAlignment.center;
                }
                TouchArea {
                    clicked => {
                        Ui.toggle-theme();
                    }
                }
            }
        }

        // ── 电源确认层：横竖屏共用，盖住页面/底栏/滑动切页 ──
        if Ui.power-pending != "" : Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;

            Rectangle {
                width: 100%;
                height: 100%;
                background: #000000.with-alpha(0.72);
            }
            // 点遮罩取消；请求已下发（power-busy）时不可关闭
            TouchArea {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                clicked => {
                    if (!Ui.power-busy) {
                        Ui.power-pending = "";
                    }
                }
            }
            PowerDialog {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        // ── WiFi 操作页：设置页「WiFi」按钮打开；盖住页面/底栏/电源层 ──
        if Wifi.visible : WifiOverlay {
            x: 0px;
            y: 0px;
        }
    }
}
