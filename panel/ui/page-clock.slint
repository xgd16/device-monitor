// 第 3 页（横屏 1142x404）：时钟。台面仪表宽幅版，三个舱位。
// 左舱：本机时刻 + 日出日落（弧线由 Rust 按固定 420x76 盒计算，地平线在盒内 y=66）；
// 中舱：天气 + 电池；右舱：时间进度 + 世界时钟。
import { Theme } from "theme.slint";
import { Sys, Clk, Ui } from "data.slint";
import { RingGauge, Mono, SheetHead, Meter } from "widgets.slint";

export component PageClock inherits Rectangle {
    in property <int> idx: 2;
    x: (root.idx - Ui.page) * ((root.idx - Ui.page) <= 0 ? 395px : 1142px);
    animate x {
        duration: 520ms;
        easing: ease-out;
    }
    width: 1142px;
    height: 404px;
    property <bool> act: Ui.page == root.idx;
    opacity: act ? 1.0 : 0.0;
    animate opacity {
        duration: 420ms;
        easing: ease-out;
        delay: 40ms;
    }

    // 舱位分隔：内容与发丝线各留 6px 气口（与系统页/Token 页同一节奏）
    Rectangle {
        x: 426px;
        y: 0px;
        width: 1px;
        height: 404px;
        background: Theme.border;
    }
    Rectangle {
        x: 765px;
        y: 0px;
        width: 1px;
        height: 404px;
        background: Theme.border;
    }

    // ═══ A 舱 0–420：本机时刻 / 日出日落 ═══
    SheetHead {
        x: 0px;
        y: 0px;
        width: 420px;
        title: "本机时刻";
    }
    hh := Mono {
        x: 0px;
        y: 18px;
        text: Clk.hh;
        font-size: 100px;
        height: 100px;
        vertical-alignment: TextVerticalAlignment.center;
        font-weight: 700;
        color: Theme.emphasis;
    }
    colon := Mono {
        x: hh.x + hh.preferred-width + 1px;
        y: 18px;
        text: ":";
        font-size: 100px;
        height: 100px;
        vertical-alignment: TextVerticalAlignment.center;
        font-weight: 700;
        color: Theme.emphasis;
    }
    mm := Mono {
        x: colon.x + colon.preferred-width + 1px;
        y: 18px;
        text: Clk.mm;
        font-size: 100px;
        height: 100px;
        vertical-alignment: TextVerticalAlignment.center;
        font-weight: 700;
        color: Theme.emphasis;
    }
    Mono {
        x: mm.x + mm.preferred-width + 10px;
        y: 68px;
        text: Clk.ss;
        font-size: 26px;
        height: 26px;
        vertical-alignment: TextVerticalAlignment.center;
        font-weight: 700;
        color: Theme.accent;
    }
    Text {
        x: 0px;
        y: 136px;
        text: Clk.date-line;
        font-size: 16px;
        font-weight: 700;
        color: Theme.fg;
        font-family: Theme.font-body;
    }
    Mono {
        // 与刻度尺（y=170）留 2px 净空：Noto CJK 的行盒比 Menlo 高，原来贴到刻度上
        x: 0px;
        y: 154px;
        width: 420px;
        height: 14px;
        text: Clk.sec-str;
        font-size: 8.5px;
        color: Theme.muted;
        horizontal-alignment: TextHorizontalAlignment.right;
        vertical-alignment: TextVerticalAlignment.center;
    }
    // 60 格秒刻度尺：已过格 = 主墨
    for i in 60: Rectangle {
        x: i * 7px;
        y: 170px;
        width: 3px;
        height: i * 100.0 / 60.0 < Clk.sec-pct ? 10px : 6px;
        background: i * 100.0 / 60.0 < Clk.sec-pct ? Theme.emphasis : Theme.track;
    }
    Mono {
        x: 0px;
        y: 186px;
        width: 420px;
        text: Clk.meta1;
        font-size: 9px;
        color: Theme.fg;
    }
    Mono {
        x: 0px;
        y: 200px;
        width: 420px;
        text: Clk.meta2;
        font-size: 8.5px;
        color: Theme.muted;
        overflow: elide;
    }
    Rectangle {
        x: 0px;
        y: 214px;
        width: 420px;
        height: 1px;
        background: Theme.border;
    }

    SheetHead {
        x: 0px;
        y: 222px;
        width: 420px;
        title: "日出日落 · 西安";
        meta: Clk.sun-src;
        meta-w: 100px;
    }
    // 弧线按 420x76 盒 1:1 渲染（地平线在盒内 y=66）
    Path {
        x: 0px;
        y: 252px;
        width: 420px;
        height: 76px;
        fit: ImageFit.preserve;
        commands: Clk.sun-arc;
        stroke: Theme.border;
        stroke-width: 2px;
        stroke-line-cap: round;
        fill: transparent;
    }
    Rectangle {
        x: Clk.sun-x * 1px - 4.5px;
        y: Clk.sun-y * 1px + 247.5px;
        width: 9px;
        height: 9px;
        border-radius: self.width / 2;
        background: Clk.is-day ? Theme.warning : Theme.muted;
        Rectangle {
            x: -3.5px;
            y: -3.5px;
            width: parent.width + 7px;
            height: parent.height + 7px;
            border-radius: self.width / 2;
            background: Theme.warning.with-alpha(0.28);
            opacity: Ui.screen-on ? Clk.sun-halo : 0.0;
        }
    }
    Text {
        x: 0px;
        y: 336px;
        height: 16px;
        text: "日出";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 30px;
        y: 336px;
        height: 16px;
        text: Clk.sun-rise;
        font-size: 13px;
        font-weight: 700;
        color: Theme.emphasis;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 108px;
        y: 336px;
        height: 16px;
        text: "日落";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 138px;
        y: 336px;
        height: 16px;
        text: Clk.sun-set;
        font-size: 13px;
        font-weight: 700;
        color: Theme.emphasis;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 214px;
        y: 336px;
        width: 206px;
        height: 16px;
        text: "昼长 " + Clk.day-len + " · 正午 " + Clk.noon;
        font-size: 9px;
        color: Theme.fg;
        horizontal-alignment: TextHorizontalAlignment.right;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Meter {
        x: 0px;
        y: 362px;
        width: 420px;
        height: 3px;
        pct: Clk.phase-pct;
        tint: Clk.is-day ? Theme.warning : Theme.muted;
    }
    Text {
        x: 0px;
        y: 372px;
        width: 250px;
        height: 14px;
        text: Clk.phase-line;
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        overflow: elide;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 250px;
        y: 372px;
        width: 170px;
        height: 14px;
        text: Clk.tomorrow;
        font-size: 8px;
        color: Theme.muted;
        horizontal-alignment: TextHorizontalAlignment.right;
        overflow: elide;
        vertical-alignment: TextVerticalAlignment.center;
    }

    // ═══ B 舱 433–759：天气 / 电池 ═══
    SheetHead {
        x: 433px;
        y: 0px;
        width: 326px;
        title: "天气 · 西安";
        meta: Clk.w-note;
        meta-w: 96px;
    }
    wtemp := Mono {
        x: 433px;
        y: 24px;
        text: Clk.w-temp;
        font-size: 40px;
        height: 40px;
        vertical-alignment: TextVerticalAlignment.center;
        font-weight: 700;
        color: Clk.w-temp-c >= 35.0 ? Theme.error : (Clk.w-temp-c >= 28.0 ? Theme.warning : (Clk.w-temp-c <= 0.0 ? Theme.accent : Theme.emphasis));
    }
    Text {
        x: wtemp.x + wtemp.preferred-width + 4px;
        y: 40px;
        text: "°C";
        font-size: 11px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Text {
        x: wtemp.x + wtemp.preferred-width + 30px;
        y: 42px;
        width: 110px;
        text: Clk.w-desc;
        font-size: 12px;
        font-weight: 700;
        color: Clk.w-wet ? Theme.info : Theme.fg;
        font-family: Theme.font-body;
        overflow: elide;
    }
    Text {
        x: 433px;
        y: 26px;
        width: 326px;
        height: 16px;
        text: Clk.w-feels;
        font-size: 9px;
        color: Theme.fg;
        font-family: Theme.font-body;
        horizontal-alignment: TextHorizontalAlignment.right;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 433px;
        y: 44px;
        width: 326px;
        height: 16px;
        text: Clk.w-wind;
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        horizontal-alignment: TextHorizontalAlignment.right;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 433px;
        y: 82px;
        width: 326px;
        height: 16px;
        text: Clk.w-range;
        font-size: 9px;
        color: Theme.fg;
        font-family: Theme.font-body;
        overflow: elide;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 433px;
        y: 98px;
        width: 326px;
        height: 16px;
        text: Clk.w-extra;
        font-size: 8px;
        color: Theme.muted;
        font-family: Theme.font-body;
        overflow: elide;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Rectangle {
        x: 433px;
        y: 118px;
        width: 326px;
        height: 1px;
        background: Theme.border;
    }

    SheetHead {
        x: 433px;
        y: 126px;
        width: 326px;
        title: "电池";
        meta: Sys.bat-pill;
        meta-w: 64px;
    }
    RingGauge {
        x: 433px;
        y: 154px;
        width: 120px;
        height: 120px;
        val-arc: Sys.bat-ring;
        tint: Sys.bat-pct < 20 ? Theme.error : (Sys.bat-pct < 50 ? Theme.warning : Theme.emphasis);
        label: Sys.bat-str;
        sub: "电量 %";
    }
    Text {
        x: 567px;
        y: 156px;
        width: 192px;
        height: 18px;
        text: Sys.bat-remain;
        font-size: 12px;
        font-weight: 700;
        color: Theme.fg;
        font-family: Theme.font-body;
        overflow: elide;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 567px;
        y: 176px;
        width: 192px;
        text: Sys.bat-voltage + "V · " + Sys.bat-current + "mA";
        font-size: 8px;
        color: Theme.muted;
    }
    Mono {
        x: 567px;
        y: 190px;
        width: 192px;
        text: Sys.bat-power-str + " · " + Sys.bat-temp-str;
        font-size: 8px;
        color: Theme.muted;
    }
    Mono {
        x: 567px;
        y: 208px;
        width: 192px;
        text: Sys.bat-protocol == "" ? "协议 --" : "协议 " + Sys.bat-protocol;
        font-size: 8.5px;
        font-weight: 700;
        color: Sys.bat-protocol == "" ? Theme.muted : Theme.fg;
    }
    Mono {
        x: 567px;
        y: 226px;
        width: 192px;
        text: Sys.bat-limit;
        font-size: 8px;
        color: Theme.muted;
        overflow: elide;
    }
    Mono {
        x: 567px;
        y: 240px;
        width: 192px;
        text: Sys.bat-limit2;
        font-size: 8px;
        color: Theme.muted;
        overflow: elide;
    }
    Rectangle {
        x: 433px;
        y: 288px;
        width: 326px;
        height: 1px;
        background: Theme.border;
    }
    Text {
        x: 433px;
        y: 298px;
        text: Sys.bat-charging ? "充电电压" : "电池电压";
        font-size: 8px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Mono {
        x: 433px;
        y: 310px;
        width: 104px;
        height: 16px;
        text: Sys.bat-chg-v;
        font-size: 11px;
        font-weight: 700;
        color: Theme.fg;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 541px;
        y: 298px;
        text: Sys.bat-charging ? "充电电流" : "电池电流";
        font-size: 8px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Mono {
        x: 541px;
        y: 310px;
        width: 104px;
        height: 16px;
        text: Sys.bat-chg-i;
        font-size: 11px;
        font-weight: 700;
        color: Theme.fg;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 649px;
        y: 298px;
        text: "充电功率";
        font-size: 8px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Mono {
        x: 649px;
        y: 310px;
        width: 110px;
        height: 16px;
        text: Sys.bat-chg-p;
        font-size: 11px;
        font-weight: 700;
        color: Theme.fg;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 433px;
        y: 336px;
        text: "充电协议";
        font-size: 8px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Mono {
        x: 433px;
        y: 348px;
        width: 326px;
        height: 16px;
        text: Sys.bat-protocol == "" ? "--" : Sys.bat-protocol;
        font-size: 11px;
        font-weight: 700;
        color: Sys.bat-protocol == "" ? Theme.muted : Theme.fg;
        vertical-alignment: TextVerticalAlignment.center;
    }

    // ═══ C 舱 772–1142：时间进度 / 世界时钟 ═══
    SheetHead {
        x: 772px;
        y: 0px;
        width: 370px;
        title: "时间进度";
    }
    for pr[i] in Clk.prog: Rectangle {
        x: 772px;
        y: 28px + i * 36px;
        width: 370px;
        height: 32px;
        Text {
            x: 0px;
            y: 0px;
            width: 48px;
            height: 100%;
            text: pr.label;
            font-size: 9.5px;
            color: Theme.muted;
            font-family: Theme.font-body;
            vertical-alignment: TextVerticalAlignment.center;
        }
        Meter {
            x: 52px;
            y: 14px;
            width: 188px;
            height: 4px;
            pct: pr.pct;
            tint: Theme.emphasis;
        }
        Mono {
            x: 244px;
            y: 0px;
            width: 52px;
            height: 100%;
            text: pr.pct-str + "%";
            font-size: 11px;
            font-weight: 700;
            color: Theme.emphasis;
            horizontal-alignment: TextHorizontalAlignment.right;
            vertical-alignment: TextVerticalAlignment.center;
        }
        Mono {
            x: 300px;
            y: 0px;
            width: 70px;
            height: 100%;
            text: pr.left;
            font-size: 8px;
            color: Theme.muted;
            horizontal-alignment: TextHorizontalAlignment.right;
            vertical-alignment: TextVerticalAlignment.center;
        }
    }
    Rectangle {
        x: 772px;
        y: 184px;
        width: 370px;
        height: 1px;
        background: Theme.border;
    }

    SheetHead {
        x: 772px;
        y: 192px;
        width: 370px;
        title: "世界时钟";
        meta: "\{Clk.world.length} 城市";
        meta-w: 64px;
    }
    for w[i] in Clk.world: Rectangle {
        x: 772px + Math.mod(i, 2) * 188px;
        y: 220px + Math.floor(i / 2) * 44px;
        width: 182px;
        height: 40px;
        Text {
            x: 0px;
            y: 0px;
            width: 96px;
            height: 100%;
            text: w.name + w.mark;
            font-size: 10.5px;
            font-weight: 600;
            color: Theme.fg;
            font-family: Theme.font-body;
            overflow: elide;
            vertical-alignment: TextVerticalAlignment.center;
        }
        Mono {
            x: 98px;
            y: 0px;
            width: 40px;
            height: 100%;
            text: w.offset;
            font-size: 7.5px;
            color: Theme.muted;
            horizontal-alignment: TextHorizontalAlignment.right;
            vertical-alignment: TextVerticalAlignment.center;
        }
        Mono {
            x: 140px;
            y: 0px;
            width: 42px;
            height: 100%;
            text: w.time;
            font-size: 14px;
            font-weight: 700;
            color: Theme.emphasis;
            horizontal-alignment: TextHorizontalAlignment.right;
            vertical-alignment: TextVerticalAlignment.center;
        }
    }
    Mono {
        x: 772px;
        y: 366px;
        width: 370px;
        height: 16px;
        text: Clk.tomorrow;
        font-size: 8.5px;
        color: Theme.muted;
        vertical-alignment: TextVerticalAlignment.center;
    }
}

export component PageClockP inherits Rectangle {
    in property <int> idx: 2;
    x: (root.idx - Ui.page) * ((root.idx - Ui.page) <= 0 ? 256px : 508px);
    animate x {
        duration: 520ms;
        easing: ease-out;
    }
    width: 508px;
    height: 992px;
    property <bool> act: Ui.page == root.idx;
    opacity: act ? 1.0 : 0.0;
    animate opacity {
        duration: 420ms;
        easing: ease-out;
        delay: 40ms;
    }

    // ═══ 本机时刻：全页唯一的主读数（140px）═══ 0–288
    SheetHead {
        x: 0px;
        y: 0px;
        width: 508px;
        title: "本机时刻";
    }
    hh := Mono {
        x: 0px;
        y: 28px;
        text: Clk.hh;
        font-size: 140px;
        height: 140px;
        vertical-alignment: TextVerticalAlignment.center;
        font-weight: 700;
        color: Theme.emphasis;
    }
    colon := Mono {
        x: hh.x + hh.preferred-width + 2px;
        y: 28px;
        text: ":";
        font-size: 140px;
        height: 140px;
        vertical-alignment: TextVerticalAlignment.center;
        font-weight: 700;
        color: Theme.emphasis;
    }
    mm := Mono {
        x: colon.x + colon.preferred-width + 2px;
        y: 28px;
        text: Clk.mm;
        font-size: 140px;
        height: 140px;
        vertical-alignment: TextVerticalAlignment.center;
        font-weight: 700;
        color: Theme.emphasis;
    }
    Mono {
        x: mm.x + mm.preferred-width + 14px;
        y: 96px;
        text: Clk.ss;
        font-size: 34px;
        height: 34px;
        vertical-alignment: TextVerticalAlignment.center;
        font-weight: 700;
        color: Theme.accent;
    }
    Text {
        x: 0px;
        y: 208px;
        text: Clk.date-line;
        font-size: 18px;
        font-weight: 700;
        color: Theme.fg;
        font-family: Theme.font-body;
    }
    Mono {
        x: 0px;
        y: 212px;
        width: 508px;
        text: Clk.sec-str;
        font-size: 9px;
        color: Theme.muted;
        horizontal-alignment: TextHorizontalAlignment.right;
    }
    for i in 60: Rectangle {
        x: i * 8.47px;
        y: 240px;
        width: 3px;
        height: i * 100.0 / 60.0 < Clk.sec-pct ? 10px : 6px;
        background: i * 100.0 / 60.0 < Clk.sec-pct ? Theme.emphasis : Theme.track;
    }
    Mono {
        x: 0px;
        y: 256px;
        width: 508px;
        text: Clk.meta1;
        font-size: 9px;
        color: Theme.fg;
    }
    Mono {
        x: 0px;
        y: 272px;
        width: 508px;
        text: Clk.meta2;
        font-size: 8.5px;
        color: Theme.muted;
        overflow: elide;
    }
    Rectangle {
        x: 0px;
        y: 288px;
        width: 508px;
        height: 1px;
        background: Theme.border;
    }

    // ═══ 天气 / 电池 ═══ 304–470
    SheetHead {
        x: 0px;
        y: 304px;
        width: 246px;
        title: "天气 · 西安";
        meta: Clk.w-note;
        meta-w: 96px;
    }
    SheetHead {
        x: 262px;
        y: 304px;
        width: 246px;
        title: "电池";
        meta: Sys.bat-pill;
        meta-w: 64px;
    }
    wtemp := Mono {
        x: 0px;
        y: 332px;
        text: Clk.w-temp;
        font-size: 40px;
        height: 40px;
        vertical-alignment: TextVerticalAlignment.center;
        font-weight: 700;
        color: Clk.w-temp-c >= 35.0 ? Theme.error : (Clk.w-temp-c >= 28.0 ? Theme.warning : (Clk.w-temp-c <= 0.0 ? Theme.accent : Theme.emphasis));
    }
    Text {
        x: wtemp.x + wtemp.preferred-width + 5px;
        y: 348px;
        text: "°C";
        font-size: 12px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Text {
        x: wtemp.x + wtemp.preferred-width + 34px;
        y: 352px;
        text: Clk.w-desc;
        font-size: 13px;
        font-weight: 700;
        color: Clk.w-wet ? Theme.info : Theme.fg;
        font-family: Theme.font-body;
        overflow: elide;
    }
    Text {
        x: 0px;
        y: 340px;
        width: 246px;
        text: Clk.w-feels;
        font-size: 9px;
        color: Theme.fg;
        font-family: Theme.font-body;
        horizontal-alignment: TextHorizontalAlignment.right;
    }
    Text {
        x: 0px;
        y: 356px;
        width: 246px;
        text: Clk.w-wind;
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        horizontal-alignment: TextHorizontalAlignment.right;
    }
    Text {
        x: 0px;
        y: 392px;
        width: 246px;
        text: Clk.w-range;
        font-size: 9px;
        color: Theme.fg;
        font-family: Theme.font-body;
        overflow: elide;
    }
    Text {
        x: 0px;
        y: 408px;
        width: 246px;
        text: Clk.w-extra;
        font-size: 8px;
        color: Theme.muted;
        font-family: Theme.font-body;
        overflow: elide;
    }
    // 电池：环形表 + 右侧读数（与横版同一枚 120 盒弧线）
    RingGauge {
        x: 262px;
        y: 328px;
        width: 120px;
        height: 120px;
        val-arc: Sys.bat-ring;
        tint: Sys.bat-pct < 20 ? Theme.error : (Sys.bat-pct < 50 ? Theme.warning : Theme.emphasis);
        label: Sys.bat-str;
        sub: "电量 %";
    }
    Text {
        x: 396px;
        y: 336px;
        text: Sys.bat-remain;
        font-size: 12px;
        font-weight: 700;
        color: Theme.fg;
        font-family: Theme.font-body;
    }
    Mono {
        x: 396px;
        y: 358px;
        width: 112px;
        text: Sys.bat-voltage + "V · " + Sys.bat-current + "mA";
        font-size: 8px;
        color: Theme.muted;
    }
    Mono {
        x: 396px;
        y: 374px;
        width: 112px;
        text: Sys.bat-power-str + " · " + Sys.bat-temp-str;
        font-size: 8px;
        color: Theme.muted;
    }
    Mono {
        x: 396px;
        y: 398px;
        width: 112px;
        text: Sys.bat-protocol == "" ? "" : "协议 " + Sys.bat-protocol;
        font-size: 8.5px;
        font-weight: 700;
        color: Sys.bat-protocol == "" ? Theme.muted : Theme.fg;
    }
    Rectangle {
        x: 0px;
        y: 470px;
        width: 508px;
        height: 1px;
        background: Theme.border;
    }

    // ═══ 时间进度 ═══ 486–640
    SheetHead {
        x: 0px;
        y: 486px;
        width: 508px;
        title: "时间进度";
    }
    for pr[i] in Clk.prog: Rectangle {
        x: 0px;
        y: 514px + i * 28px;
        width: 508px;
        height: 24px;
        Text {
            x: 0px;
            y: 0px;
            width: 44px;
            height: 100%;
            text: pr.label;
            font-size: 9.5px;
            color: Theme.muted;
            font-family: Theme.font-body;
            vertical-alignment: TextVerticalAlignment.center;
        }
        Meter {
            x: 48px;
            y: 10px;
            width: 292px;
            height: 4px;
            pct: pr.pct;
            tint: Theme.emphasis;
        }
        Mono {
            x: 348px;
            y: 0px;
            width: 66px;
            height: 100%;
            text: pr.pct-str + "%";
            font-size: 11px;
            font-weight: 700;
            color: Theme.emphasis;
            horizontal-alignment: TextHorizontalAlignment.right;
            vertical-alignment: TextVerticalAlignment.center;
        }
        Mono {
            x: 420px;
            y: 0px;
            width: 88px;
            height: 100%;
            text: pr.left;
            font-size: 8px;
            color: Theme.muted;
            horizontal-alignment: TextHorizontalAlignment.right;
            vertical-alignment: TextVerticalAlignment.center;
        }
    }
    Rectangle {
        x: 0px;
        y: 640px;
        width: 508px;
        height: 1px;
        background: Theme.border;
    }

    // ═══ 世界时钟 ═══ 656–800
    SheetHead {
        x: 0px;
        y: 656px;
        width: 508px;
        title: "世界时钟";
        meta: "\{Clk.world.length} 城市";
        meta-w: 72px;
    }
    for w[i] in Clk.world: Rectangle {
        x: Math.mod(i, 2) * 262px;
        y: 684px + Math.floor(i / 2) * 34px;
        width: 246px;
        height: 30px;
        Text {
            x: 0px;
            y: 0px;
            width: 116px;
            height: 100%;
            text: w.name + w.mark;
            font-size: 10.5px;
            font-weight: 600;
            color: Theme.fg;
            font-family: Theme.font-body;
            overflow: elide;
            vertical-alignment: TextVerticalAlignment.center;
        }
        Mono {
            x: 118px;
            y: 0px;
            width: 46px;
            height: 100%;
            text: w.offset;
            font-size: 7.5px;
            color: Theme.muted;
            horizontal-alignment: TextHorizontalAlignment.right;
            vertical-alignment: TextVerticalAlignment.center;
        }
        Mono {
            x: 168px;
            y: 0px;
            width: 78px;
            height: 100%;
            text: w.time;
            font-size: 15px;
            font-weight: 700;
            color: Theme.emphasis;
            horizontal-alignment: TextHorizontalAlignment.right;
            vertical-alignment: TextVerticalAlignment.center;
        }
    }
    Rectangle {
        x: 0px;
        y: 800px;
        width: 508px;
        height: 1px;
        background: Theme.border;
    }

    // ═══ 日出日落 ═══ 816–970
    SheetHead {
        x: 0px;
        y: 816px;
        width: 508px;
        title: "日出日落 · 西安";
        meta: Clk.sun-src;
        meta-w: 110px;
    }
    // 弧线由 Rust 按 420x76 盒计算（地平线在盒内 y=66），这里居中放 44 偏移
    Path {
        x: 44px;
        y: 848px;
        width: 420px;
        height: 76px;
        fit: ImageFit.preserve;
        commands: Clk.sun-arc;
        stroke: Theme.border;
        stroke-width: 2px;
        stroke-line-cap: round;
        fill: transparent;
    }
    Rectangle {
        x: Clk.sun-x * 1px + 39.5px;
        y: Clk.sun-y * 1px + 843.5px;
        width: 9px;
        height: 9px;
        border-radius: self.width / 2;
        background: Clk.is-day ? Theme.warning : Theme.muted;
        Rectangle {
            x: -3.5px;
            y: -3.5px;
            width: parent.width + 7px;
            height: parent.height + 7px;
            border-radius: self.width / 2;
            background: Theme.warning.with-alpha(0.28);
            opacity: Ui.screen-on ? Clk.sun-halo : 0.0;
        }
    }
    Text {
        x: 0px;
        y: 932px;
        height: 16px;
        text: "日出";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 30px;
        y: 932px;
        height: 16px;
        text: Clk.sun-rise;
        font-size: 14px;
        font-weight: 700;
        color: Theme.emphasis;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 120px;
        y: 932px;
        height: 16px;
        text: "日落";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 150px;
        y: 932px;
        height: 16px;
        text: Clk.sun-set;
        font-size: 14px;
        font-weight: 700;
        color: Theme.emphasis;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 240px;
        y: 932px;
        width: 268px;
        height: 16px;
        text: "昼长 " + Clk.day-len + " · 正午 " + Clk.noon;
        font-size: 9px;
        color: Theme.fg;
        horizontal-alignment: TextHorizontalAlignment.right;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Meter {
        x: 0px;
        y: 956px;
        width: 508px;
        height: 3px;
        pct: Clk.phase-pct;
        tint: Clk.is-day ? Theme.warning : Theme.muted;
    }
    Text {
        x: 0px;
        y: 966px;
        width: 300px;
        text: Clk.phase-line;
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        overflow: elide;
    }
    Mono {
        x: 300px;
        y: 966px;
        width: 208px;
        text: Clk.tomorrow;
        font-size: 8px;
        color: Theme.muted;
        horizontal-alignment: TextHorizontalAlignment.right;
        overflow: elide;
    }
}
