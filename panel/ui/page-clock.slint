// 第 3 页：时钟/时间页。
// 左列（650）：大时钟卡 232 + 天气卡 320 + 电池卡 320（并排 162 高）；
// 右列（482 = 1142-660，右缘对齐顶/底栏）：时间进度 114 + 世界时钟 130 + 日出日落 140。
// 日出弧线由 Rust 按固定盒子 420x76 计算（含地平线基线）。
import { Theme } from "theme.slint";
import { Sys, Clk, Ui } from "data.slint";
import { Card, Pill, StatBar, RingGauge, Dot, Mono } from "widgets.slint";

export component PageClock inherits Rectangle {
    in property <int> idx: 2;
    x: (root.idx - Ui.page) * ((root.idx - Ui.page) <= 0 ? 395px : 1142px);
    animate x {
        duration: 520ms;
        easing: ease-out;
    }
    width: 1142px;
    height: 404px;
    property <bool> act: Ui.page == root.idx;

    // ── 左列 ──
    Rectangle {
        x: 0px;
        y: act ? 0px : 14px;
        width: 650px;
        height: 404px;
        opacity: act ? 1.0 : 0.0;
        animate opacity {
            duration: 420ms;
            easing: ease-out;
            delay: 40ms;
        }
        animate y {
            duration: 480ms;
            easing: ease-out;
            delay: 40ms;
        }

        Card {
            x: 0px;
            y: 0px;
            width: 650px;
            height: 232px;
            title: "本机时刻";

            // 氛围光斑：缓慢呼吸（相位由 Rust 每秒推进；熄屏时归零，省电也省 GPU）
            Rectangle {
                x: 330px;
                y: -60px;
                width: 320px;
                height: 240px;
                opacity: Ui.screen-on ? Clk.glow-a : 0.0;
                background: @radial-gradient(circle, Theme.glow-a.with-alpha(0.55) 0%, Theme.glow-a.with-alpha(0.0) 62%);
            }
            Rectangle {
                x: 60px;
                y: -80px;
                width: 260px;
                height: 200px;
                opacity: Ui.screen-on ? Clk.glow-b : 0.0;
                background: @radial-gradient(circle, Theme.glow-b.with-alpha(0.4) 0%, Theme.glow-b.with-alpha(0.0) 58%);
            }

            hh := Mono {
                x: 18px;
                y: 26px;
                text: Clk.hh;
                font-size: 92px;
                font-weight: 700;
                color: Theme.emphasis;
            }
            colon := Mono {
                x: hh.x + hh.preferred-width + 2px;
                y: 26px;
                text: ":";
                font-size: 92px;
                font-weight: 700;
                color: Theme.accent;
            }
            mm := Mono {
                x: colon.x + colon.preferred-width + 2px;
                y: 26px;
                text: Clk.mm;
                font-size: 92px;
                font-weight: 700;
                color: Theme.emphasis;
            }
            Mono {
                x: mm.x + mm.preferred-width + 22px;
                y: 72px;
                text: Clk.ss;
                font-size: 36px;
                font-weight: 700;
                color: Theme.accent;
            }
            Text {
                x: 18px;
                y: 150px;
                text: Clk.date-line;
                font-size: 14px;
                font-weight: 700;
                color: Theme.fg;
                font-family: Theme.font-body;
            }
            Mono {
                x: 0px;
                width: parent.width - 20px;
                y: 162px;
                text: Clk.sec-str;
                font-size: 8px;
                color: Theme.muted;
                horizontal-alignment: TextHorizontalAlignment.right;
            }
            StatBar {
                x: 18px;
                y: 178px;
                width: 614px;
                height: 4px;
                pct: Clk.sec-pct;
                tint: Theme.accent;
            }
            Mono {
                x: 18px;
                y: 192px;
                width: 614px;
                text: Clk.meta1;
                font-size: 9px;
                color: Theme.fg;
            }
            Mono {
                x: 18px;
                y: 210px;
                width: 614px;
                text: Clk.meta2;
                font-size: 8px;
                color: Theme.muted;
            }
        }

        Card {
            x: 0px;
            y: 242px;
            width: 320px;
            height: 162px;
            title: "天气 · 西安";
            Text {
                x: 0px;
                width: parent.width - 14px;
                y: 11px;
                text: Clk.w-note;
                font-size: 7.5px;
                color: Clk.w-ok ? Theme.muted : Theme.warning;
                font-family: Theme.font-body;
                horizontal-alignment: TextHorizontalAlignment.right;
            }
            wtemp := Mono {
                x: 14px;
                y: 24px;
                text: Clk.w-temp;
                font-size: 38px;
                font-weight: 700;
                color: Clk.w-temp-c >= 35.0 ? Theme.error : (Clk.w-temp-c >= 28.0 ? Theme.warning : (Clk.w-temp-c <= 0.0 ? Theme.accent : Theme.emphasis));
            }
            Text {
                x: wtemp.x + wtemp.preferred-width + 6px;
                y: 36px;
                text: "°C";
                font-size: 11px;
                color: Theme.muted;
                font-family: Theme.font-body;
            }
            Text {
                x: wtemp.x + wtemp.preferred-width + 40px;
                y: 42px;
                text: Clk.w-desc;
                font-size: 12.5px;
                font-weight: 700;
                color: Clk.w-wet ? Theme.info : Theme.fg;
                font-family: Theme.font-body;
            }
            Text {
                x: 0px;
                width: parent.width - 14px;
                y: 32px;
                text: Clk.w-feels;
                font-size: 9px;
                color: Theme.fg;
                font-family: Theme.font-body;
                horizontal-alignment: TextHorizontalAlignment.right;
            }
            Text {
                x: 0px;
                width: parent.width - 14px;
                y: 48px;
                text: Clk.w-wind;
                font-size: 8.5px;
                color: Theme.muted;
                font-family: Theme.font-body;
                horizontal-alignment: TextHorizontalAlignment.right;
            }
            Text {
                x: 14px;
                y: 88px;
                width: 292px;
                text: Clk.w-range;
                font-size: 9.5px;
                color: Theme.fg;
                font-family: Theme.font-body;
                overflow: elide;
            }
            Text {
                x: 14px;
                y: 108px;
                width: 292px;
                text: Clk.w-extra;
                font-size: 8px;
                color: Theme.muted;
                font-family: Theme.font-body;
                overflow: elide;
            }
            StatBar {
                x: 14px;
                y: 132px;
                width: 292px;
                height: 4px;
                pct: 100.0;
                tint: Clk.w-ok ? Theme.info : Theme.warning;
            }
        }

        Card {
            x: 330px;
            y: 242px;
            width: 320px;
            height: 162px;
            title: "电池";
            Pill {
                y: 8px;
                x: parent.width - self.width - 12px;
                label: Sys.bat-pill;
                fg: Sys.bat-charging ? Theme.success : Theme.accent;
                bg: Theme.card-alt;
                horizontal-stretch: 0;
            }
            RingGauge {
                x: 8px;
                y: 28px;
                width: 118px;
                height: 118px;
                val-arc: Sys.bat-ring;
                tint: Sys.bat-pct < 20 ? Theme.error : (Sys.bat-pct < 50 ? Theme.warning : Theme.success);
                label: Sys.bat-str;
                sub: "电量 %";
            }
            Text {
                x: 136px;
                y: 40px;
                text: Sys.bat-remain;
                font-size: 11px;
                font-weight: 700;
                color: Theme.fg;
                font-family: Theme.font-body;
            }
            Mono {
                x: 136px;
                y: 64px;
                width: 170px;
                text: Sys.bat-voltage + "V · " + Sys.bat-current + "mA";
                font-size: 8px;
                color: Theme.muted;
            }
            Mono {
                x: 136px;
                y: 80px;
                width: 170px;
                text: Sys.bat-power + "W · " + Sys.bat-temp-str;
                font-size: 8px;
                color: Theme.muted;
            }
            Mono {
                x: 136px;
                y: 102px;
                width: 170px;
                text: Sys.bat-limit;
                font-size: 8px;
                color: Theme.muted;
                overflow: elide;
            }
            Mono {
                x: 136px;
                y: 124px;
                width: 170px;
                text: Sys.bat-protocol == "" ? "" : "协议 " + Sys.bat-protocol;
                font-size: 8.5px;
                font-weight: 700;
                color: Sys.bat-protocol == "" ? Theme.muted : Theme.accent;
            }
        }
    }

    // ── 右列 ──（482 = 1142-660，右缘与顶栏/底栏卡片对齐）
    Rectangle {
        x: 660px;
        y: act ? 0px : 14px;
        width: 482px;
        height: 404px;
        opacity: act ? 1.0 : 0.0;
        animate opacity {
            duration: 420ms;
            easing: ease-out;
            delay: 110ms;
        }
        animate y {
            duration: 480ms;
            easing: ease-out;
            delay: 110ms;
        }

        Card {
            x: 0px;
            y: 0px;
            width: 482px;
            height: 114px;
            title: "时间进度";
            for pr[i] in Clk.prog: Rectangle {
                x: 14px;
                y: 26px + i * 21px;
                width: 454px;
                height: 18px;
                Text {
                    x: 0px;
                    y: Theme.text-nudge;
                    height: parent.height;
                    width: 36px;
                    text: pr.label;
                    font-size: 9px;
                    color: Theme.muted;
                    font-family: Theme.font-body;
                    vertical-alignment: TextVerticalAlignment.center;
                }
                StatBar {
                    x: 42px;
                    y: 7px;
                    width: 246px;
                    height: 4.5px;
                    pct: pr.pct;
                    tint: Theme.accent;
                }
                Mono {
                    x: 296px;
                    y: Theme.text-nudge;
                    height: parent.height;
                    width: 60px;
                    text: pr.pct-str + "%";
                    font-size: 10px;
                    font-weight: 700;
                    color: Theme.accent;
                    horizontal-alignment: TextHorizontalAlignment.right;
                    vertical-alignment: TextVerticalAlignment.center;
                }
                Mono {
                    x: 362px;
                    y: Theme.text-nudge;
                    height: parent.height;
                    width: 92px;
                    text: pr.left;
                    font-size: 8px;
                    color: Theme.muted;
                    horizontal-alignment: TextHorizontalAlignment.right;
                    vertical-alignment: TextVerticalAlignment.center;
                }
            }
        }

        Card {
            x: 0px;
            y: 124px;
            width: 482px;
            height: 130px;
            title: "世界时钟";
            for w[i] in Clk.world: Rectangle {
                x: 14px + Math.mod(i, 2) * 232px;
                y: 26px + Math.floor(i / 2) * 34px;
                width: 222px;
                height: 30px;
                Text {
                    x: 0px;
                    y: Theme.text-nudge;
                    height: parent.height;
                    width: 96px;
                    text: w.name + w.mark;
                    font-size: 10.5px;
                    font-weight: 700;
                    color: Theme.fg;
                    font-family: Theme.font-body;
                    overflow: elide;
                    vertical-alignment: TextVerticalAlignment.center;
                }
                Mono {
                    x: 96px;
                    y: Theme.text-nudge;
                    height: parent.height;
                    width: 52px;
                    text: w.offset;
                    font-size: 7.5px;
                    color: Theme.muted;
                    horizontal-alignment: TextHorizontalAlignment.right;
                    vertical-alignment: TextVerticalAlignment.center;
                }
                Mono {
                    x: 162px;
                    y: Theme.text-nudge;
                    height: parent.height;
                    width: 60px;
                    text: w.time;
                    font-size: 14px;
                    font-weight: 700;
                    color: Theme.emphasis;
                    horizontal-alignment: TextHorizontalAlignment.right;
                    vertical-alignment: TextVerticalAlignment.center;
                }
            }
        }

        Card {
            x: 0px;
            y: 264px;
            width: 482px;
            height: 140px;
            title: "日出日落 · 西安";
            Text {
                x: 0px;
                width: parent.width - 14px;
                y: 11px;
                text: Clk.sun-src;
                font-size: 7.5px;
                color: Theme.muted;
                font-family: Theme.font-body;
                horizontal-alignment: TextHorizontalAlignment.right;
            }
            Rectangle {
                x: 31px;
                y: 20px;
                width: 420px;
                height: 76px;
                Path {
                    width: 420px;
                    height: 76px;
                    commands: Clk.sun-arc;
                    stroke: Theme.track;
                    stroke-width: 2px;
                    stroke-line-cap: round;
                    fill: transparent;
                }
                Rectangle {
                    x: Clk.sun-x * 1px - 4.5px;
                    y: Clk.sun-y * 1px - 4.5px;
                    width: 9px;
                    height: 9px;
                    border-radius: self.width / 2;
                    background: Clk.is-day ? Theme.warning : Theme.muted;
                    Rectangle {
                        x: -3.5px;
                        y: -3.5px;
                        width: parent.width + 7px;
                        height: parent.height + 7px;
                        border-radius: self.width / 2;
                        background: Theme.warning.with-alpha(0.3);
                        opacity: Ui.screen-on ? Clk.sun-halo : 0.0;
                    }
                }
            }
            Text {
                x: 14px;
                y: 102px;
                text: "日出";
                font-size: 8px;
                color: Theme.muted;
                font-family: Theme.font-body;
                vertical-alignment: TextVerticalAlignment.center;
            }
            Mono {
                x: 40px;
                y: 102px;
                text: Clk.sun-rise;
                font-size: 13px;
                font-weight: 700;
                color: Theme.warning;
                vertical-alignment: TextVerticalAlignment.center;
            }
            Text {
                x: 150px;
                y: 102px;
                text: "日落";
                font-size: 8px;
                color: Theme.muted;
                font-family: Theme.font-body;
                vertical-alignment: TextVerticalAlignment.center;
            }
            Mono {
                x: 176px;
                y: 102px;
                text: Clk.sun-set;
                font-size: 13px;
                font-weight: 700;
                color: Theme.accent2;
                vertical-alignment: TextVerticalAlignment.center;
            }
            Mono {
                x: 0px;
                width: parent.width - 14px;
                y: 104px;
                text: "昼长 " + Clk.day-len + " · 正午 " + Clk.noon;
                font-size: 9px;
                color: Theme.fg;
                horizontal-alignment: TextHorizontalAlignment.right;
            }
            StatBar {
                x: 14px;
                y: 122px;
                width: 454px;
                height: 3.5px;
                pct: Clk.phase-pct;
                tint: Clk.is-day ? Theme.warning : Theme.muted;
            }
            Text {
                x: 14px;
                y: 128px;
                width: 200px;
                text: Clk.phase-line;
                font-size: 8px;
                color: Theme.muted;
                font-family: Theme.font-body;
                overflow: elide;
            }
            Mono {
                x: 0px;
                width: parent.width - 14px;
                y: 128px;
                text: Clk.tomorrow;
                font-size: 7.5px;
                color: Theme.muted;
                horizontal-alignment: TextHorizontalAlignment.right;
            }
        }
    }
}
