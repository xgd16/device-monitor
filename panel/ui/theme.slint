// 语义色板 + 字体 + 阈值函数。
//
// 沿用本仓库「语义槽」约定：绘制代码只引用 Theme::*，不写硬编码色值；
// 规范色值 = 深色主题（OLED 近黑省电），dark=false 时逐槽位映射到浅色主题。
//
// 视觉方向「台面仪表」：石墨底 + 骨白墨的单色面板，颜色只留给状态
// （成功/警告/故障/信息）。深色 = 熄灯后的仪器面板，浅色 = 强光下的刻字铭牌。
// 强调色不再铺满界面：竖屏用主墨（emphasis）做选中态，accent 只留给数据线。
// Rust 侧启动时按平台覆盖 font-body / font-mono（macOS 用苹方/Menlo 预览）。
export global Theme {
    in-out property <bool> dark: true;

    // ── 背景层次：base < card < card-alt，靠亮度差造层级 ──
    out property <color> bg: dark ? #08090B : #E8EAEB;
    out property <color> card: dark ? #0E1013 : #FAFBFA;
    out property <color> card-alt: dark ? #15181C : #EFF1F0;
    out property <color> track: dark ? #20252A : #D9DEDD;
    out property <color> border: dark ? #2A3036 : #CDD3D3;
    // ── 前景 ──
    out property <color> fg: dark ? #C5CACF : #3B4145;
    out property <color> muted: dark ? #828A91 : #646B70;
    // 主墨：读数、选中态实底（浅色下近黑，深色下骨白）
    out property <color> emphasis: dark ? #F4F1EA : #111416;

    // ── 强调 / 状态 ──
    out property <color> accent: dark ? #4FB8E8 : #0A7FA6;
    out property <color> accent2: dark ? #A78BFA : #6346C0;
    out property <color> success: dark ? #45D08A : #127E4A;
    out property <color> warning: dark ? #F5B440 : #9A5E00;
    out property <color> error: dark ? #FF6B6B : #BE2B2B;
    out property <color> info: dark ? #45C8D4 : #0D7280;

    // 文字光学垂直居中补偿：Slint 按行盒（ascent+descent）中轴居中，与字形墨迹
    // 中轴不重合，按实测像素偏差补偿（全工程只调这一处）。
    // 默认值按设备字体 Noto Sans CJK SC 校准；macOS 预览字体不同，Rust 侧覆盖。
    in-out property <length> text-nudge: 0.25px;

    // 字体（Rust 按平台覆盖）
    in-out property <string> font-body: "Noto Sans CJK SC";
    in-out property <string> font-mono: "Noto Sans Mono CJK SC";

    // 使用率 → 语义色（颜色只是辅助，数值始终同时呈现）
    public pure function lvl(p: float) -> color {
        p >= 85.0 ? error : (p >= 65.0 ? warning : success)
    }

    // 使用率 → 读数色：正常时用主墨，只有越界才上色。
    // 面板默认是单色的——「一片绿」不是信号，是装饰。
    public pure function lvl-ink(p: float) -> color {
        p >= 85.0 ? error : (p >= 65.0 ? warning : emphasis)
    }

    // 温度 → 语义色
    public pure function tlvl(t: float) -> color {
        t >= 75.0 ? error : (t >= 60.0 ? warning : success)
    }

    // 温度 → 读数色（同上：正常 = 主墨）
    public pure function tlvl-ink(t: float) -> color {
        t >= 75.0 ? error : (t >= 60.0 ? warning : emphasis)
    }

    // 电量 → 读数色（低于 20% 红、低于 50% 琥珀，其余主墨）
    public pure function bat-ink(p: float) -> color {
        p < 20.0 ? error : (p < 50.0 ? warning : emphasis)
    }

    // 排行榜逐行配色（6 色循环）
    public pure function rank-color(i: int) -> color {
        Math.mod(i, 6) == 0 ? accent : (Math.mod(i, 6) == 1 ? success : (Math.mod(i, 6) == 2 ? info : (Math.mod(i, 6) == 3 ? accent2 : (Math.mod(i, 6) == 4 ? warning : error))))
    }

    // WiFi 信号 dBm → 语义色
    public pure function sig(dbm: int) -> color {
        dbm >= -60 ? success : (dbm >= -75 ? warning : error)
    }
}
