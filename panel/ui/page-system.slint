// 第 1 页（横屏 1142x404）：系统监控。台面仪表的宽幅版——三个舱位由竖向发丝线分隔，
// 舱内仍是「标题行 + 读数 + 刻度 + 副值」，不画卡片框。
// 所有数值文本一律用 Rust 侧格式化好的字符串（Slint 浮点插值不控精度）。
import { Theme } from "theme.slint";
import { Sys, Ui } from "data.slint";
import { BarChart, Mono, SheetHead, Meter, CoreCell, Tag } from "widgets.slint";

export component PageSystem inherits Rectangle {
    in property <int> idx: 0;
    x: (root.idx - Ui.page) * ((root.idx - Ui.page) <= 0 ? 395px : 1142px);
    animate x {
        duration: 520ms;
        easing: ease-out;
    }
    width: 1142px;
    height: 404px;
    property <bool> act: Ui.page == root.idx;
    opacity: act ? 1.0 : 0.0;
    animate opacity {
        duration: 420ms;
        easing: ease-out;
        delay: 40ms;
    }

    // 舱位分隔（两条竖向发丝线）
    Rectangle {
        x: 358px;
        y: 0px;
        width: 1px;
        height: 404px;
        background: Theme.border;
    }
    Rectangle {
        x: 762px;
        y: 0px;
        width: 1px;
        height: 404px;
        background: Theme.border;
    }

    // ═══ A 舱 0–352：处理器 / 显卡 · 温度 / 告警 ═══
    SheetHead {
        x: 0px;
        y: 0px;
        width: 352px;
        title: "处理器";
        meta: Sys.governor;
        meta-w: 76px;
    }
    cpu_big := Mono {
        x: 0px;
        y: 22px;
        text: Sys.cpu-str;
        font-size: 64px;
        height: 64px;
        vertical-alignment: TextVerticalAlignment.center;
        font-weight: 700;
        color: Theme.lvl-ink(Sys.cpu-usage);
    }
    Text {
        x: cpu_big.x + cpu_big.preferred-width + 5px;
        y: 56px;
        text: "%";
        font-size: 14px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Text {
        x: 190px;
        y: 30px;
        width: 40px;
        height: 16px;
        text: "负载";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 190px;
        y: 30px;
        width: 162px;
        height: 16px;
        text: Sys.load;
        font-size: 9px;
        color: Theme.fg;
        horizontal-alignment: TextHorizontalAlignment.right;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 190px;
        y: 52px;
        width: 40px;
        height: 16px;
        text: "核心";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 190px;
        y: 52px;
        width: 162px;
        height: 16px;
        text: "\{Sys.cores.length} 核";
        font-size: 10.5px;
        color: Theme.fg;
        horizontal-alignment: TextHorizontalAlignment.right;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 190px;
        y: 74px;
        width: 40px;
        height: 16px;
        text: "采集";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 190px;
        y: 74px;
        width: 162px;
        height: 16px;
        text: "\{Sys.refresh-secs}s";
        font-size: 10.5px;
        color: Theme.fg;
        horizontal-alignment: TextHorizontalAlignment.right;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Meter {
        x: 0px;
        y: 102px;
        width: 352px;
        height: 4px;
        pct: Sys.cpu-usage;
        tint: Theme.lvl-ink(Sys.cpu-usage);
    }
    // 单核柱阵：共用刻度带 352×36，8 格 × 44
    Rectangle {
        x: 0px;
        y: 114px;
        width: 352px;
        height: 36px;
        border-radius: 2px;
        background: Theme.track.with-alpha(0.55);
    }
    for c[i] in Sys.cores: CoreCell {
        x: i * 44px;
        y: 114px;
        width: 44px;
        visible: i < 8;
        name: "C\{c.id}";
        freq: c.freq;
        pct: c.usage;
        tint: Theme.lvl-ink(c.usage);
        bar-w: 9px;
    }
    Text {
        x: 0px;
        y: 168px;
        text: "近 2 分钟";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    BarChart {
        x: 0px;
        y: 182px;
        width: 352px;
        height: 46px;
        flat: true;
        values: Sys.cpu-history;
        tint: Theme.lvl-ink(Sys.cpu-usage);
    }
    Rectangle {
        x: 0px;
        y: 244px;
        width: 352px;
        height: 1px;
        background: Theme.border;
    }

    SheetHead {
        x: 0px;
        y: 252px;
        width: 352px;
        title: "显卡 · 温度";
        meta: Sys.gpu-name;
        meta-w: 90px;
    }
    gpu_big := Mono {
        x: 0px;
        y: 278px;
        text: Sys.gpu-freq;
        font-size: 24px;
        height: 24px;
        vertical-alignment: TextVerticalAlignment.center;
        font-weight: 700;
        color: Theme.emphasis;
    }
    Text {
        x: gpu_big.x + gpu_big.preferred-width + 4px;
        y: 288px;
        text: "MHz";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Meter {
        x: 0px;
        y: 312px;
        width: 176px;
        height: 3px;
        pct: Sys.gpu-pct;
        tint: Theme.emphasis;
    }
    Text {
        x: 0px;
        y: 320px;
        width: 176px;
        text: Sys.gpu-range;
        font-size: 8px;
        color: Theme.muted;
        font-family: Theme.font-body;
        overflow: elide;
    }
    for t[i] in Sys.thermal: Rectangle {
        x: 196px;
        y: 278px + i * 18px;
        width: 156px;
        height: 16px;
        visible: i < 4;
        Text {
            x: 0px;
            y: 0px;
            width: 96px;
            height: 100%;
            text: t.name;
            font-size: 8.5px;
            color: Theme.muted;
            font-family: Theme.font-body;
            overflow: elide;
            vertical-alignment: TextVerticalAlignment.center;
        }
        Mono {
            x: 96px;
            y: 0px;
            width: 60px;
            height: 100%;
            text: t.temp-str;
            font-size: 10px;
            color: Theme.tlvl-ink(t.temp);
            horizontal-alignment: TextHorizontalAlignment.right;
            vertical-alignment: TextVerticalAlignment.center;
        }
    }
    Rectangle {
        x: 0px;
        y: 348px;
        width: 352px;
        height: 1px;
        background: Theme.border;
    }
    if Sys.alert-title != "": Text {
        x: 0px;
        y: 358px;
        width: 236px;
        height: 16px;
        text: Sys.alert-title + " · " + Sys.alert-msg;
        font-size: 8.5px;
        color: Sys.alert-color;
        font-family: Theme.font-body;
        overflow: elide;
        vertical-alignment: TextVerticalAlignment.center;
    }
    if Sys.alert-title == "": Text {
        x: 0px;
        y: 358px;
        height: 16px;
        text: "暂无告警";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 240px;
        y: 358px;
        width: 112px;
        height: 16px;
        text: Sys.alert-time;
        font-size: 8px;
        color: Theme.muted;
        horizontal-alignment: TextHorizontalAlignment.right;
        vertical-alignment: TextVerticalAlignment.center;
    }

    // ═══ B 舱 364–756：内存 / 磁盘 / 进程 / 服务 ═══
    SheetHead {
        x: 364px;
        y: 0px;
        width: 392px;
        title: "内存 / 磁盘";
    }
    Text {
        x: 364px;
        y: 30px;
        text: "内存";
        font-size: 9px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    mem_big := Mono {
        x: 364px;
        y: 44px;
        text: Sys.mem-str;
        font-size: 30px;
        height: 30px;
        vertical-alignment: TextVerticalAlignment.center;
        font-weight: 700;
        color: Theme.lvl-ink(Sys.mem-pct);
    }
    Text {
        x: mem_big.x + mem_big.preferred-width + 3px;
        y: 60px;
        text: "%";
        font-size: 10px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Meter {
        x: 364px;
        y: 84px;
        width: 188px;
        height: 4px;
        pct: Sys.mem-pct;
        tint: Theme.lvl-ink(Sys.mem-pct);
    }
    Text {
        x: 364px;
        y: 92px;
        width: 188px;
        height: 14px;
        text: Sys.mem-used + " / " + Sys.mem-total + " · 可用 " + Sys.mem-avail;
        font-size: 8px;
        color: Theme.muted;
        font-family: Theme.font-body;
        overflow: elide;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 364px;
        y: 106px;
        width: 188px;
        height: 14px;
        text: "交换 " + Sys.mem-swap;
        font-size: 8px;
        color: Theme.muted;
        font-family: Theme.font-body;
        overflow: elide;
        vertical-alignment: TextVerticalAlignment.center;
    }

    Text {
        x: 568px;
        y: 30px;
        text: "磁盘";
        font-size: 9px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    disk_big := Mono {
        x: 568px;
        y: 44px;
        text: Sys.disk-str;
        font-size: 30px;
        height: 30px;
        vertical-alignment: TextVerticalAlignment.center;
        font-weight: 700;
        color: Theme.lvl-ink(Sys.disk-pct);
    }
    Text {
        x: disk_big.x + disk_big.preferred-width + 3px;
        y: 60px;
        text: "%";
        font-size: 10px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Meter {
        x: 568px;
        y: 84px;
        width: 188px;
        height: 4px;
        pct: Sys.disk-pct;
        tint: Theme.lvl-ink(Sys.disk-pct);
    }
    Text {
        x: 568px;
        y: 92px;
        width: 188px;
        height: 14px;
        text: Sys.disk-used + " / " + Sys.disk-total;
        font-size: 8px;
        color: Theme.muted;
        font-family: Theme.font-body;
        overflow: elide;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 568px;
        y: 106px;
        width: 188px;
        height: 14px;
        text: Sys.disk-fs + " · inode " + Sys.disk-inode;
        font-size: 8px;
        color: Theme.muted;
        font-family: Theme.font-body;
        overflow: elide;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Rectangle {
        x: 364px;
        y: 126px;
        width: 392px;
        height: 1px;
        background: Theme.border;
    }

    SheetHead {
        x: 364px;
        y: 134px;
        width: 392px;
        title: "进程";
        meta: "共 " + Sys.procs-count + " 个";
        meta-w: 76px;
    }
    Text {
        x: 364px;
        y: 162px;
        text: "PID";
        font-size: 8px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Text {
        x: 424px;
        y: 162px;
        text: "CPU%";
        font-size: 8px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Text {
        x: 492px;
        y: 162px;
        text: "内存";
        font-size: 8px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Text {
        x: 570px;
        y: 162px;
        text: "名称";
        font-size: 8px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    for p[i] in Sys.procs: Rectangle {
        x: 364px;
        y: 180px + i * 26px;
        width: 392px;
        height: 24px;
        visible: i < 5;
        Mono {
            x: 0px;
            y: 0px;
            width: 52px;
            height: 100%;
            text: p.pid-str;
            font-size: 8.5px;
            color: Theme.muted;
            vertical-alignment: TextVerticalAlignment.center;
        }
        Mono {
            x: 60px;
            y: 0px;
            width: 60px;
            height: 100%;
            text: p.cpu-str;
            font-size: 10px;
            color: Theme.lvl-ink(p.cpu);
            vertical-alignment: TextVerticalAlignment.center;
        }
        Mono {
            x: 128px;
            y: 0px;
            width: 70px;
            height: 100%;
            text: p.mem;
            font-size: 8.5px;
            color: Theme.fg;
            vertical-alignment: TextVerticalAlignment.center;
        }
        Text {
            x: 206px;
            y: 0px;
            width: 186px;
            height: 100%;
            text: p.name;
            font-size: 10.5px;
            color: Theme.fg;
            font-family: Theme.font-body;
            overflow: elide;
            vertical-alignment: TextVerticalAlignment.center;
        }
    }
    Rectangle {
        x: 364px;
        y: 320px;
        width: 392px;
        height: 1px;
        background: Theme.border;
    }

    SheetHead {
        x: 364px;
        y: 328px;
        width: 392px;
        title: "服务与告警";
    }
    for s[i] in Sys.services: Tag {
        x: 364px + Math.mod(i, 2) * 120px;
        y: 356px + Math.floor(i / 2) * 24px;
        visible: i < 4;
        label: s.name + " " + s.state;
        tint: s.state == "active" ? Theme.success : (s.state == "failed" ? Theme.error : Theme.muted);
    }

    // ═══ C 舱 768–1142：电池 / 网络与无线 ═══
    SheetHead {
        x: 768px;
        y: 0px;
        width: 374px;
        title: "电池";
        meta: Sys.bat-pill;
        meta-w: 76px;
    }
    bat_big := Mono {
        x: 768px;
        y: 20px;
        text: Sys.bat-str;
        font-size: 64px;
        height: 64px;
        vertical-alignment: TextVerticalAlignment.center;
        font-weight: 700;
        color: Theme.bat-ink(Sys.bat-pct);
    }
    Text {
        x: bat_big.x + bat_big.preferred-width + 6px;
        y: 54px;
        text: "%";
        font-size: 14px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Mono {
        x: 900px;
        y: 28px;
        width: 242px;
        height: 16px;
        text: Sys.bat-voltage + "V · " + Sys.bat-current + "mA · " + Sys.bat-power-str;
        font-size: 9.5px;
        color: Theme.fg;
        horizontal-alignment: TextHorizontalAlignment.right;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Meter {
        x: 768px;
        y: 94px;
        width: 374px;
        height: 6px;
        pct: Sys.bat-pct;
        tint: Theme.bat-ink(Sys.bat-pct);
    }
    Text {
        x: 768px;
        y: 110px;
        text: "功率";
        font-size: 8px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Mono {
        x: 768px;
        y: 122px;
        width: 118px;
        height: 16px;
        text: Sys.bat-power-str;
        font-size: 11px;
        font-weight: 700;
        color: Theme.fg;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 895px;
        y: 110px;
        text: "温度";
        font-size: 8px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Mono {
        x: 895px;
        y: 122px;
        width: 118px;
        height: 16px;
        text: Sys.bat-temp-str;
        font-size: 11px;
        font-weight: 700;
        color: Theme.tlvl-ink(Sys.bat-temp);
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 1022px;
        y: 110px;
        text: "剩余";
        font-size: 8px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Mono {
        x: 1022px;
        y: 122px;
        width: 120px;
        height: 16px;
        text: Sys.bat-remain;
        font-size: 11px;
        font-weight: 700;
        color: Theme.fg;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 768px;
        y: 152px;
        text: Sys.bat-charging ? "充电电压" : "电池电压";
        font-size: 8px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Mono {
        x: 768px;
        y: 164px;
        width: 118px;
        height: 16px;
        text: Sys.bat-chg-v;
        font-size: 11px;
        color: Theme.fg;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 895px;
        y: 152px;
        text: Sys.bat-charging ? "充电电流" : "电池电流";
        font-size: 8px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Mono {
        x: 895px;
        y: 164px;
        width: 118px;
        height: 16px;
        text: Sys.bat-chg-i;
        font-size: 11px;
        color: Theme.fg;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 1022px;
        y: 152px;
        text: "充电功率";
        font-size: 8px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Mono {
        x: 1022px;
        y: 164px;
        width: 120px;
        height: 16px;
        text: Sys.bat-chg-p;
        font-size: 11px;
        color: Theme.fg;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 768px;
        y: 192px;
        width: 374px;
        height: 14px;
        text: Sys.bat-limit;
        font-size: 8px;
        color: Theme.muted;
        font-family: Theme.font-body;
        overflow: elide;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Rectangle {
        x: 768px;
        y: 214px;
        width: 374px;
        height: 1px;
        background: Theme.border;
    }

    SheetHead {
        x: 768px;
        y: 222px;
        width: 374px;
        title: "网络与无线";
        meta: Sys.bt;
        meta-w: 90px;
    }
    Text {
        x: 768px;
        y: 250px;
        width: 280px;
        height: 22px;
        text: Sys.wifi-ssid;
        font-size: 16px;
        font-weight: 700;
        color: Theme.fg;
        font-family: Theme.font-body;
        overflow: elide;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 1050px;
        y: 250px;
        width: 92px;
        height: 22px;
        text: Sys.wifi-signal-str;
        font-size: 12px;
        color: Sys.wifi-ok ? Theme.sig(Sys.wifi-signal) : Theme.muted;
        horizontal-alignment: TextHorizontalAlignment.right;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 768px;
        y: 274px;
        width: 374px;
        height: 14px;
        text: Sys.wifi-detail;
        font-size: 9px;
        color: Theme.muted;
        font-family: Theme.font-body;
        overflow: elide;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 768px;
        y: 296px;
        width: 140px;
        height: 18px;
        text: "↓ " + Sys.rx;
        font-size: 10px;
        color: Theme.info;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 916px;
        y: 296px;
        width: 140px;
        height: 18px;
        text: "↑ " + Sys.tx;
        font-size: 10px;
        color: Theme.accent2;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 768px;
        y: 322px;
        height: 16px;
        text: Sys.vpn-kind;
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 800px;
        y: 322px;
        width: 200px;
        height: 16px;
        text: Sys.vpn-node;
        font-size: 9.5px;
        font-weight: 700;
        color: Sys.vpn-ok ? Theme.success : Theme.muted;
        font-family: Theme.font-body;
        overflow: elide;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 1004px;
        y: 322px;
        width: 138px;
        height: 16px;
        text: Sys.vpn-mode + " · " + Sys.vpn-conn;
        font-size: 8px;
        color: Theme.muted;
        horizontal-alignment: TextHorizontalAlignment.right;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Rectangle {
        x: 768px;
        y: 348px;
        width: 374px;
        height: 1px;
        background: Theme.border;
    }
    Text {
        x: 768px;
        y: 358px;
        height: 16px;
        text: Sys.bat-limit2 == "" ? "采集 \{Sys.refresh-secs}s · 面板常亮" : Sys.bat-limit2;
        font-size: 8px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
}


// ── 竖屏版（508x992）：台面仪表 ──
// 语法：分组标题（标题 + 发丝线）→ 读数（标签 / 大数字 / 刻度条 / 副值）。
// 整页只有 CPU 是主读数（72px）；其余同级，靠对齐轨和字号差建立层级。
// 每段高度都是显式数字：段尾 = 段首 + 固定高度，元素不会随内容长度跑位。
component StatCell inherits Rectangle {
    in property <string> k;
    in property <string> v;
    in property <color> tint: Theme.fg;
    width: 169px;
    height: 26px;
    Text {
        x: 0px;
        y: Theme.text-nudge;
        height: 100%;
        text: root.k;
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 46px;
        y: Theme.text-nudge;
        width: parent.width - 46px;
        height: 100%;
        text: root.v;
        font-size: 12px;
        font-weight: 700;
        color: root.tint;
        vertical-alignment: TextVerticalAlignment.center;
    }
}

export component PageSystemP inherits Rectangle {
    in property <int> idx: 0;
    x: (root.idx - Ui.page) * ((root.idx - Ui.page) <= 0 ? 256px : 508px);
    animate x {
        duration: 520ms;
        easing: ease-out;
    }
    width: 508px;
    height: 992px;
    property <bool> act: Ui.page == root.idx;
    opacity: act ? 1.0 : 0.0;
    animate opacity {
        duration: 420ms;
        easing: ease-out;
        delay: 40ms;
    }

    // ═══ 处理器：主读数 ═══ 0–248
    SheetHead {
        x: 0px;
        y: 0px;
        width: 508px;
        title: "处理器";
        meta: Sys.governor;
    }
    cpu_big := Mono {
        x: 0px;
        y: 24px;
        text: Sys.cpu-str;
        font-size: 72px;
        height: 72px;
        vertical-alignment: TextVerticalAlignment.center;
        font-weight: 700;
        color: Theme.lvl-ink(Sys.cpu-usage);
    }
    Text {
        x: cpu_big.x + cpu_big.preferred-width + 6px;
        y: 62px;
        text: "%";
        font-size: 16px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    // 右侧读数：标签左、值右，同一套对齐轨
    Text {
        x: 320px;
        y: 36px;
        width: 70px;
        height: 16px;
        text: "负载";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 320px;
        y: 36px;
        width: 188px;
        height: 16px;
        text: Sys.load;
        font-size: 10.5px;
        color: Theme.fg;
        horizontal-alignment: TextHorizontalAlignment.right;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 320px;
        y: 58px;
        width: 70px;
        height: 16px;
        text: "核心";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 320px;
        y: 58px;
        width: 188px;
        height: 16px;
        text: "\{Sys.cores.length} 核";
        font-size: 10.5px;
        color: Theme.fg;
        horizontal-alignment: TextHorizontalAlignment.right;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 320px;
        y: 80px;
        width: 70px;
        height: 16px;
        text: "采集";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 320px;
        y: 80px;
        width: 188px;
        height: 16px;
        text: "\{Sys.refresh-secs}s";
        font-size: 10.5px;
        color: Theme.fg;
        horizontal-alignment: TextHorizontalAlignment.right;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Meter {
        x: 0px;
        y: 114px;
        width: 508px;
        height: 4px;
        pct: Sys.cpu-usage;
        tint: Theme.lvl-ink(Sys.cpu-usage);
    }
    // 单核柱阵：共用刻度带 508×36（带顶 = 100%），8 格 × 60 + 7 × 4 = 508
    Rectangle {
        x: 0px;
        y: 126px;
        width: 508px;
        height: 36px;
        border-radius: 2px;
        background: Theme.track.with-alpha(0.55);
    }
    for c[i] in Sys.cores: CoreCell {
        x: i * 64px;
        y: 126px;
        visible: i < 8;
        name: "C\{c.id}";
        freq: c.freq;
        pct: c.usage;
        tint: Theme.lvl-ink(c.usage);
    }
    // 近 2 分钟记录纸
    Text {
        x: 0px;
        y: 192px;
        text: "近 2 分钟";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    BarChart {
        x: 0px;
        y: 204px;
        width: 508px;
        height: 36px;
        flat: true;
        values: Sys.cpu-history;
        tint: Theme.lvl-ink(Sys.cpu-usage);
    }
    Rectangle {
        x: 0px;
        y: 242px;
        width: 508px;
        height: 1px;
        background: Theme.border;
    }

    // ═══ 内存 / 磁盘 ═══ 260–326
    Text {
        x: 0px;
        y: 260px;
        text: "内存";
        font-size: 9.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Mono {
        x: 0px;
        y: 260px;
        width: 246px;
        text: Sys.mem-used + " / " + Sys.mem-total;
        font-size: 8.5px;
        color: Theme.muted;
        horizontal-alignment: TextHorizontalAlignment.right;
    }
    mem_big := Mono {
        x: 0px;
        y: 274px;
        text: Sys.mem-str + "%";
        font-size: 26px;
        height: 26px;
        vertical-alignment: TextVerticalAlignment.center;
        font-weight: 700;
        color: Theme.lvl-ink(Sys.mem-pct);
    }
    Meter {
        x: 0px;
        y: 310px;
        width: 246px;
        height: 4px;
        pct: Sys.mem-pct;
        tint: Theme.lvl-ink(Sys.mem-pct);
    }
    Mono {
        x: 0px;
        y: 318px;
        width: 246px;
        text: "可用 " + Sys.mem-avail + " · 交换 " + Sys.mem-swap;
        font-size: 7.5px;
        color: Theme.muted;
        overflow: elide;
    }

    Text {
        x: 262px;
        y: 260px;
        text: "磁盘";
        font-size: 9.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Mono {
        x: 262px;
        y: 260px;
        width: 246px;
        text: Sys.disk-used + " / " + Sys.disk-total;
        font-size: 8.5px;
        color: Theme.muted;
        horizontal-alignment: TextHorizontalAlignment.right;
    }
    disk_big := Mono {
        x: 262px;
        y: 274px;
        text: Sys.disk-str + "%";
        font-size: 26px;
        height: 26px;
        vertical-alignment: TextVerticalAlignment.center;
        font-weight: 700;
        color: Theme.lvl-ink(Sys.disk-pct);
    }
    Meter {
        x: 262px;
        y: 310px;
        width: 246px;
        height: 4px;
        pct: Sys.disk-pct;
        tint: Theme.lvl-ink(Sys.disk-pct);
    }
    Mono {
        x: 262px;
        y: 318px;
        width: 246px;
        text: Sys.disk-fs + " · inode " + Sys.disk-inode;
        font-size: 7.5px;
        color: Theme.muted;
        overflow: elide;
    }

    // ═══ 显卡 · 温度 ═══ 338–444
    SheetHead {
        x: 0px;
        y: 338px;
        width: 508px;
        title: "显卡 · 温度";
        meta: "freedreno";
    }
    Text {
        x: 0px;
        y: 366px;
        text: "GPU";
        font-size: 9.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Text {
        x: 0px;
        y: 366px;
        width: 246px;
        text: Sys.gpu-name;
        font-size: 9px;
        color: Theme.muted;
        font-family: Theme.font-body;
        horizontal-alignment: TextHorizontalAlignment.right;
        overflow: elide;
    }
    gpu_big := Mono {
        x: 0px;
        y: 380px;
        text: Sys.gpu-freq;
        font-size: 26px;
        height: 26px;
        vertical-alignment: TextVerticalAlignment.center;
        font-weight: 700;
        color: Sys.gpu-suspended ? Theme.muted : Theme.emphasis;
    }
    Text {
        x: gpu_big.x + gpu_big.preferred-width + 5px;
        y: 392px;
        text: Sys.gpu-suspended ? "" : "MHz";
        font-size: 10px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Meter {
        x: 0px;
        y: 416px;
        width: 246px;
        height: 4px;
        pct: Sys.gpu-pct;
        tint: Theme.emphasis;
    }
    Mono {
        x: 0px;
        y: 424px;
        width: 246px;
        text: Sys.gpu-suspended ? "已挂起 · 按需唤醒" : Sys.gpu-range;
        font-size: 7.5px;
        color: Theme.muted;
        overflow: elide;
    }
    for t[i] in Sys.thermal: Rectangle {
        x: 262px;
        y: 366px + i * 19px;
        width: 246px;
        height: 18px;
        visible: i < 4;
        Text {
            x: 0px;
            y: 0px;
            width: 150px;
            text: t.name;
            font-size: 9px;
            color: Theme.muted;
            font-family: Theme.font-body;
            overflow: elide;
            vertical-alignment: TextVerticalAlignment.center;
        }
        Mono {
            x: 160px;
            y: 0px;
            width: 86px;
            text: t.temp-str;
            font-size: 11px;
            font-weight: 700;
            color: Theme.tlvl-ink(t.temp);
            horizontal-alignment: TextHorizontalAlignment.right;
            vertical-alignment: TextVerticalAlignment.center;
        }
    }

    // ═══ 进程 ═══ 456–628
    SheetHead {
        x: 0px;
        y: 456px;
        width: 508px;
        title: "进程";
        meta: "共 " + Sys.procs-count + " 个";
    }
    Text {
        x: 0px;
        y: 484px;
        text: "PID";
        font-size: 8px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Text {
        x: 52px;
        y: 484px;
        text: "CPU%";
        font-size: 8px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Text {
        x: 114px;
        y: 484px;
        text: "内存";
        font-size: 8px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Text {
        x: 184px;
        y: 484px;
        text: "名称";
        font-size: 8px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Rectangle {
        x: 0px;
        y: 500px;
        width: 508px;
        height: 1px;
        background: Theme.border;
    }
    for p[i] in Sys.procs: Rectangle {
        x: 0px;
        y: 504px + i * 22px;
        width: 508px;
        height: 24px;
        visible: i < 5;
        Mono {
            x: 0px;
            y: 0px;
            width: 46px;
            height: 100%;
            text: p.pid-str;
            font-size: 8.5px;
            color: Theme.muted;
            vertical-alignment: TextVerticalAlignment.center;
        }
        Mono {
            x: 52px;
            y: 0px;
            width: 56px;
            height: 100%;
            text: p.cpu-str;
            font-size: 10px;
            color: Theme.lvl-ink(p.cpu);
            vertical-alignment: TextVerticalAlignment.center;
        }
        Mono {
            x: 114px;
            y: 0px;
            width: 64px;
            height: 100%;
            text: p.mem;
            font-size: 8.5px;
            color: Theme.fg;
            vertical-alignment: TextVerticalAlignment.center;
        }
        Text {
            x: 184px;
            y: 0px;
            width: 324px;
            height: 100%;
            text: p.name;
            font-size: 10.5px;
            color: Theme.fg;
            font-family: Theme.font-body;
            overflow: elide;
            vertical-alignment: TextVerticalAlignment.center;
        }
    }

    // ═══ 电池 ═══ 640–802
    SheetHead {
        x: 0px;
        y: 630px;
        width: 508px;
        title: "电池";
        meta: Sys.bat-pill;
        meta-tint: Sys.bat-charging ? Theme.success : Theme.muted;
    }
    bat_big := Mono {
        x: 0px;
        y: 658px;
        text: Sys.bat-str;
        font-size: 34px;
        height: 34px;
        vertical-alignment: TextVerticalAlignment.center;
        font-weight: 700;
        color: Theme.bat-ink(Sys.bat-pct);
    }
    Text {
        x: bat_big.x + bat_big.preferred-width + 4px;
        y: 674px;
        text: "%";
        font-size: 13px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Mono {
        x: 0px;
        y: 666px;
        width: 508px;
        text: Sys.bat-voltage + "V · " + Sys.bat-current + "mA · " + Sys.bat-power-str;
        font-size: 10.5px;
        color: Theme.fg;
        horizontal-alignment: TextHorizontalAlignment.right;
    }
    Meter {
        x: 0px;
        y: 706px;
        width: 508px;
        height: 6px;
        pct: Sys.bat-pct;
        tint: Theme.bat-ink(Sys.bat-pct);
    }
    StatCell {
        x: 0px;
        y: 720px;
        k: "功率";
        v: Sys.bat-power-str;
    }
    StatCell {
        x: 169px;
        y: 720px;
        k: "温度";
        v: Sys.bat-temp-str;
        tint: Theme.tlvl-ink(Sys.bat-temp);
    }
    StatCell {
        x: 338px;
        y: 720px;
        k: "剩余";
        v: Sys.bat-remain;
    }
    StatCell {
        x: 0px;
        y: 746px;
        k: Sys.bat-charging ? "充电电压" : "电池电压";
        v: Sys.bat-chg-v;
        tint: Sys.bat-charging ? Theme.emphasis : Theme.fg;
    }
    StatCell {
        x: 169px;
        y: 746px;
        k: Sys.bat-charging ? "充电电流" : "电池电流";
        v: Sys.bat-chg-i;
        tint: Sys.bat-charging ? Theme.emphasis : Theme.fg;
    }
    StatCell {
        x: 338px;
        y: 746px;
        k: "充电功率";
        v: Sys.bat-chg-p;
        tint: Sys.bat-charging ? Theme.emphasis : Theme.fg;
    }
    Mono {
        x: 0px;
        y: 776px;
        width: 508px;
        text: Sys.bat-limit;
        font-size: 8px;
        color: Theme.muted;
        overflow: elide;
    }

    // ═══ 网络与无线 ═══ 814–930
    SheetHead {
        x: 0px;
        y: 800px;
        width: 508px;
        title: "网络与无线";
        meta: Sys.bt;
    }
    Text {
        x: 0px;
        y: 828px;
        width: 340px;
        text: Sys.wifi-ssid;
        font-size: 12.5px;
        font-weight: 700;
        color: Sys.wifi-ok ? Theme.emphasis : Theme.muted;
        font-family: Theme.font-body;
        overflow: elide;
    }
    Mono {
        x: 340px;
        y: 828px;
        width: 168px;
        text: Sys.wifi-signal-str;
        font-size: 10.5px;
        color: Theme.sig(Sys.wifi-signal);
        horizontal-alignment: TextHorizontalAlignment.right;
    }
    Text {
        x: 0px;
        y: 850px;
        width: 340px;
        text: Sys.wifi-detail;
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        overflow: elide;
    }
    Rectangle {
        x: 0px;
        y: 868px;
        width: 508px;
        height: 1px;
        background: Theme.border;
    }
    Mono {
        x: 0px;
        y: 874px;
        width: 246px;
        text: "↓ " + Sys.rx;
        font-size: 10px;
        color: Theme.info;
    }
    Mono {
        x: 262px;
        y: 874px;
        width: 246px;
        text: "↑ " + Sys.tx;
        font-size: 10px;
        color: Theme.accent2;
    }
    Text {
        x: 0px;
        y: 892px;
        text: Sys.vpn-kind;
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 42px;
        y: 890px;
        width: 300px;
        text: Sys.vpn-node;
        font-size: 10.5px;
        font-weight: 700;
        color: Sys.vpn-ok ? Theme.success : Theme.muted;
        font-family: Theme.font-body;
        overflow: elide;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 0px;
        y: 892px;
        width: 508px;
        text: Sys.vpn-mode + " · " + Sys.vpn-conn;
        font-size: 8px;
        color: Theme.muted;
        horizontal-alignment: TextHorizontalAlignment.right;
    }

    // ═══ 服务与告警 ═══ 942–990
    SheetHead {
        x: 0px;
        y: 918px;
        width: 508px;
        title: "服务与告警";
        meta: Sys.alert-time;
    }
    HorizontalLayout {
        x: 0px;
        y: 946px;
        width: 508px;
        height: 20px;
        spacing: 6px;
        for s in Sys.services: Tag {
            label: s.name + " " + s.state;
            dot: true;
            tint: s.state == "active" ? Theme.success : (s.state == "failed" ? Theme.error : (s.state == "inactive" ? Theme.warning : Theme.muted));
            horizontal-stretch: 0;
        }
    }
    if Sys.alert-title != "": Text {
        x: 0px;
        y: 970px;
        width: 508px;
        text: Sys.alert-title + " · " + Sys.alert-msg;
        font-size: 8px;
        color: Sys.alert-color;
        font-family: Theme.font-body;
        overflow: elide;
    }
}
