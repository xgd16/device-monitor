// 可复用组件库：台面仪表语汇——标题行 / 刻度条 / 读数单元 / 等化器 / 面积图 / 环形仪表。
// 旧版卡片（Card）、胶囊（Pill）、动画条（StatBar）、页签胶囊（TabPill）、圆点（Dot）
// 已随横竖屏统一而删除：分组靠标题 + 发丝线，不再画卡片框。
// 所有字号按 1170x540 逻辑分辨率设计，@2x 渲染到 2340x1080 物理。
import { Theme } from "theme.slint";
import { Ui } from "data.slint";

// ── 基础 ──

export component Mono inherits Text {
    font-family: Theme.font-mono;
}

// 带外圈呼吸光晕的实时指示灯；熄屏时停止发光省电。
export component LiveDot inherits Rectangle {
    in property <color> tint;
    in property <bool> on: true;
    width: 9px;
    height: 9px;
    border-radius: self.width / 2;
    property <bool> pulse: false;
    init => {
        pulse = true;
    }
    Rectangle {
        x: -4.5px;
        y: -4.5px;
        width: parent.width + 9px;
        height: parent.height + 9px;
        border-radius: self.width / 2;
        background: root.tint.with-alpha(0.32);
        // 呼吸相位由 Rust tick 每秒推进（替代 iteration-count:-1 无限动画——
        // 那个写法会让渲染循环永不空闲，常驻烧一个 CPU 核）
        opacity: (root.pulse && Ui.screen-on) ? Ui.live-pulse : 0.12;
    }
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: self.width / 2;
        background: root.on ? root.tint : Theme.muted;
    }
}


// ── 等化器柱状图：值 0-100，新样本在右侧、越新越亮 ──
// flat=true 为竖屏「记录纸」样式：方柱、实色、越新越实（不用渐变洗）
export component BarChart inherits Rectangle {
    in property <[float]> values;
    in property <color> tint;
    in property <bool> flat: false;
    property <int> n: values.length;
    for v[i] in values: Rectangle {
        property <float> t: (root.n <= 1) ? 0.0 : i * 1.0 / (root.n - 1);
        x: i * (self.width + 2px);
        width: (parent.width - (root.n - 1) * 2px) / root.n;
        y: parent.height - self.height;
        height: Math.max(2px, parent.height * Math.max(0, Math.min(v, 100)) / 100);
        border-radius: root.flat ? 1px : self.width / 2;
        background: root.flat ? root.tint : @linear-gradient(180deg, root.tint 0%, root.tint.with-alpha(0.28) 100%);
        opacity: root.flat ? 0.28 + 0.72 * t : 0.45 + 0.55 * t;
        // 同上：height 过渡动画会让高频数据刷新持续喂渲染循环，去掉
    }
}

// ── 面积图：线 + 渐隐填充，路径串由 Rust 生成（每次数据更新整体重建）──
export component AreaChart inherits Rectangle {
    in property <string> line-pts;
    in property <string> area-pts;
    in property <color> tint;
    if root.area-pts != "": Path {
        width: 100%;
        height: 100%;
        // 坐标 1:1 渲染：默认 contain 会按路径包围盒缩放居中，数据稀疏时图会漂移
        fit: ImageFit.preserve;
        commands: root.area-pts;
        fill: @linear-gradient(180deg, root.tint.with-alpha(0.30) 0%, root.tint.with-alpha(0.02) 100%);
    }
    if root.line-pts != "": Path {
        width: 100%;
        height: 100%;
        fit: ImageFit.preserve;
        commands: root.line-pts;
        stroke: root.tint;
        stroke-width: 2px;
        stroke-line-cap: round;
        fill: transparent;
    }
}

// ── 环形仪表：轨道 + 值弧（弧线串由 Rust 生成，含 120x120 盒内圆心 60,60 半径 53）──
export component RingGauge inherits Rectangle {
    in property <string> val-arc;
    in property <color> tint;
    in property <string> label;
    in property <string> sub;
    Path {
        width: 100%;
        height: 100%;
        // 坐标 1:1 渲染：默认 contain 按包围盒适配，值弧 <70% 时会脱离轨道（包围盒非正方形）
        fit: ImageFit.preserve;
        commands: "M 60 7 A 53 53 0 1 1 59.9 7";
        stroke: Theme.track;
        stroke-width: 7px;
        stroke-line-cap: round;
        fill: transparent;
    }
    Path {
        width: 100%;
        height: 100%;
        fit: ImageFit.preserve;
        commands: root.val-arc;
        stroke: root.tint;
        stroke-width: 7px;
        stroke-line-cap: round;
        fill: transparent;
    }
    VerticalLayout {
        alignment: LayoutAlignment.center;
        padding-left: 12px;
        padding-right: 12px;
        Mono {
            text: root.label;
            font-size: 22px;
            font-weight: 700;
            color: Theme.emphasis;
            horizontal-alignment: TextHorizontalAlignment.center;
        }
        Text {
            text: root.sub;
            font-size: 8px;
            color: Theme.muted;
            font-family: Theme.font-body;
            horizontal-alignment: TextHorizontalAlignment.center;
        }
    }
}


// ═══════════════════════════════════════════════════════════════════════
// 竖屏（手机）仪表组件：台面面板语汇
// 一块连续面板 = 标题行 + 读数 + 刻度条 + 副值；不画圆角卡片。
// 所有尺寸由页面显式给，组件内部不做自适应——元素不会因内容长度跑位。
// ═══════════════════════════════════════════════════════════════════════

// 分组标题行：标题 + 延伸到右缘的发丝线 + 右侧说明。
// 发丝线从标题右侧 10px 起，到右缘 meta-w+8 处止；meta 右对齐在固定栏内。
export component SheetHead inherits Rectangle {
    in property <string> title;
    in property <string> meta: "";
    in property <length> meta-w: root.meta == "" ? 0px : 132px;
    // 状态文字着色（如 WS 在线/断开）；默认弱色，只在该行确实表达状态时覆盖
    in property <color> meta-tint: Theme.muted;
    height: 24px;
    ttl := Text {
        x: 0px;
        y: 0px;
        height: 100%;
        text: root.title;
        font-size: 10px;
        font-weight: 600;
        color: Theme.muted;
        font-family: Theme.font-body;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Rectangle {
        x: ttl.preferred-width + 10px;
        y: 11px;
        height: 1px;
        width: parent.width - self.x - root.meta-w - 8px;
        background: Theme.border;
    }
    Text {
        x: parent.width - root.meta-w;
        y: 0px;
        width: root.meta-w;
        height: 100%;
        text: root.meta;
        font-size: 9px;
        color: root.meta-tint;
        font-family: Theme.font-body;
        horizontal-alignment: TextHorizontalAlignment.right;
        vertical-alignment: TextVerticalAlignment.center;
        overflow: elide;
    }
}

// 刻度条（竖屏）：方端、实色、无端帽。颜色只表达状态，数值永远同时可见。
export component Meter inherits Rectangle {
    in property <float> pct: 0.0;
    in property <color> tint: Theme.accent;
    height: 4px;
    border-radius: 1px;
    background: Theme.track;
    Rectangle {
        x: 0px;
        y: 0px;
        height: 100%;
        width: parent.width * Math.max(0.0, Math.min(root.pct, 100.0)) / 100.0;
        border-radius: 1px;
        background: root.tint;
    }
}

// 单核柱：共用一条 100% 刻度带（页面画），柱从带底长出来；
// 柱下居中一行「C0 2260」——8 根柱合起来是一台仪表，不是 8 个电池。
export component CoreCell inherits Rectangle {
    in property <string> name;
    in property <string> freq;
    in property <float> pct;
    in property <color> tint;
    width: 60px;
    height: 58px;
    in property <length> bar-w: 12px;
    in property <length> track-h: 36px;
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.track-h - self.height;
        width: root.bar-w;
        height: Math.max(2px, root.track-h * Math.max(0.0, Math.min(root.pct, 100.0)) / 100.0);
        background: root.tint;
    }
    Mono {
        x: 0px;
        y: 42px;
        width: 100%;
        text: root.name + " " + root.freq;
        font-size: 7.5px;
        color: Theme.muted;
        horizontal-alignment: TextHorizontalAlignment.center;
    }
}

// 状态贴标：方角小标签（替代胶囊），颜色 = 状态
export component Tag inherits Rectangle {
    in property <string> label;
    in property <color> tint: Theme.muted;
    in property <bool> dot: false;
    height: 20px;
    width: txt.preferred-width + (root.dot ? 27px : 16px);
    border-radius: 3px;
    background: root.tint.with-alpha(0.10);
    border-width: 1px;
    border-color: root.tint.with-alpha(0.38);
    if root.dot: Rectangle {
        x: 7px;
        y: 7.5px;
        width: 5px;
        height: 5px;
        border-radius: 2.5px;
        background: root.tint;
    }
    txt := Text {
        x: root.dot ? 17px : 8px;
        y: Theme.text-nudge;
        height: 100%;
        text: root.label;
        font-size: 8.5px;
        color: root.tint;
        font-family: Theme.font-body;
        vertical-alignment: TextVerticalAlignment.center;
    }
}

// 分段控件的一格：选中 = 底部 3px 主墨线 + 主墨文字（与顶栏页签同一套「选中」语汇）。
// 不用实底：实底黑块会让「浅色」这种选项自相矛盾。
export component SegItem inherits Rectangle {
    in property <string> label;
    in property <string> sub: "";
    in property <bool> sel: false;
    callback pick();
    accessible-role: button;
    accessible-label: root.label + " " + root.sub;
    border-radius: 3px;
    background: transparent;
    if root.sel: Rectangle {
        x: 12px;
        y: parent.height - 3px;
        width: parent.width - 24px;
        height: 3px;
        border-radius: 1.5px;
        background: Theme.emphasis;
    }
    VerticalLayout {
        alignment: center;
        padding: 4px;
        spacing: 1px;
        Text {
            text: root.label;
            font-size: 13px;
            font-weight: root.sel ? 700 : 400;
            color: root.sel ? Theme.emphasis : Theme.muted;
            font-family: Theme.font-body;
            horizontal-alignment: TextHorizontalAlignment.center;
        }
        if root.sub != "": Text {
            text: root.sub;
            font-size: 8px;
            color: Theme.muted;
            font-family: Theme.font-body;
            horizontal-alignment: TextHorizontalAlignment.center;
            overflow: elide;
        }
    }
    ta := TouchArea {
        clicked => {
            root.pick();
        }
    }
    opacity: ta.pressed ? 0.75 : 1.0;
}

// 操作按钮（WiFi / 蓝牙 / 重启 / 关机）：细描边 + 两行字，按下填色
export component ActionBtn inherits Rectangle {
    in property <string> label;
    in property <string> sub: "";
    in property <color> tint: Theme.fg;
    in property <bool> enabled: true;
    callback pick();
    accessible-role: button;
    accessible-label: root.label + " " + root.sub;
    border-radius: 4px;
    background: root.tint.with-alpha(root.enabled ? 0.08 : 0.02);
    border-width: 1px;
    border-color: root.enabled ? root.tint.with-alpha(0.55) : Theme.border;
    VerticalLayout {
        alignment: center;
        padding: 3px;
        spacing: 0px;
        Text {
            text: root.label;
            font-size: 13px;
            font-weight: 600;
            color: root.enabled ? root.tint : Theme.muted;
            font-family: Theme.font-body;
            horizontal-alignment: TextHorizontalAlignment.center;
        }
        Text {
            text: root.sub;
            font-size: 8px;
            color: Theme.muted;
            font-family: Theme.font-mono;
            horizontal-alignment: TextHorizontalAlignment.center;
            overflow: elide;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.pick();
        }
    }
    opacity: root.enabled ? (ta.pressed ? 0.80 : 1.0) : 0.40;
}

// 键值行（设置页系统信息）：键左弱、值右墨
export component KeyRow inherits Rectangle {
    in property <string> k;
    in property <string> v;
    height: 28px;
    Text {
        x: 0px;
        y: Theme.text-nudge;
        height: 100%;
        text: root.k;
        font-size: 9.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 140px;
        y: Theme.text-nudge;
        width: parent.width - 140px;
        height: 100%;
        text: root.v;
        font-size: 10.5px;
        color: Theme.emphasis;
        horizontal-alignment: TextHorizontalAlignment.right;
        vertical-alignment: TextVerticalAlignment.center;
    }
}

// 图表井：给面积图一块可读的底（浅色下是纸白，深色下比面板亮一档）
export component Well inherits Rectangle {
    border-radius: 3px;
    background: Theme.card;
}

// 页码刻度（底栏）：短刻度 = 未选中，长墨条 = 当前页；命中区比视觉大
export component Tick inherits Rectangle {
    in property <bool> active;
    in property <int> idx;
    callback pick();
    width: root.active ? 22px : 12px;
    height: 4px;
    border-radius: 1.5px;
    background: root.active ? Theme.emphasis : Theme.track;
    animate width {
        duration: 220ms;
        easing: ease-out;
    }
    TouchArea {
        x: -7px;
        y: -13px;
        width: parent.width + 14px;
        height: 29px;
        clicked => {
            root.pick();
        }
    }
}
