// 第 2 页（横屏 1142x404）：XTokenHub Token 用量。台面仪表宽幅版，三个舱位。
// 面积图路径串由 Rust 按「352x80」（吞吐）/「374x48」（7 天趋势）盒子生成。
import { Theme } from "theme.slint";
import { Tok, Ui } from "data.slint";
import { AreaChart, Mono, SheetHead, Meter, Tag, Well } from "widgets.slint";

// 横屏模型行：392 宽，条 = 费用占比
component ModelRowL inherits Rectangle {
    in property <string> name;
    in property <string> reqs;
    in property <string> tokens;
    in property <string> cost;
    in property <string> share-str;
    in property <float> share;
    width: 392px;
    height: 30px;
    Text {
        x: 0px;
        y: 0px;
        width: 140px;
        text: root.name;
        font-size: 10.5px;
        font-weight: 600;
        color: Theme.emphasis;
        font-family: Theme.font-body;
        overflow: elide;
    }
    Mono {
        x: 146px;
        y: 1px;
        width: 44px;
        text: root.reqs;
        font-size: 9px;
        color: Theme.fg;
    }
    Mono {
        x: 194px;
        y: 1px;
        width: 76px;
        text: root.tokens;
        font-size: 9px;
        color: Theme.muted;
    }
    Mono {
        x: 274px;
        y: 0px;
        width: 118px;
        text: root.cost;
        font-size: 10.5px;
        font-weight: 700;
        color: Theme.emphasis;
        horizontal-alignment: TextHorizontalAlignment.right;
    }
    Meter {
        x: 0px;
        y: 22px;
        width: 330px;
        height: 2px;
        pct: root.share;
        tint: Theme.emphasis;
    }
    Mono {
        x: 336px;
        y: 16px;
        width: 56px;
        text: root.share-str;
        font-size: 8px;
        color: Theme.muted;
        horizontal-alignment: TextHorizontalAlignment.right;
    }
}

// 横屏渠道行：392 宽，条 = 请求占比（2px 弱色，不抢读数）
component ChanRowL inherits Rectangle {
    in property <string> name;
    in property <string> reqs;
    in property <string> avg;
    in property <string> balance;
    in property <string> cost;
    in property <float> share;
    in property <float> health;
    width: 392px;
    height: 30px;
    Text {
        x: 0px;
        y: 0px;
        width: 96px;
        text: root.name;
        font-size: 10px;
        color: Theme.fg;
        font-family: Theme.font-body;
        overflow: elide;
    }
    Mono {
        x: 100px;
        y: 1px;
        width: 40px;
        text: root.reqs;
        font-size: 9px;
        color: Theme.fg;
    }
    Mono {
        x: 144px;
        y: 1px;
        width: 44px;
        text: root.avg;
        font-size: 9px;
        color: root.health < 3.0 ? Theme.emphasis : (root.health < 8.0 ? Theme.warning : Theme.error);
    }
    Text {
        x: 192px;
        y: 1px;
        width: 100px;
        text: root.balance;
        font-size: 8.5px;
        color: root.balance == "余额 —" ? Theme.muted : Theme.fg;
        font-family: Theme.font-body;
        overflow: elide;
    }
    Mono {
        x: 296px;
        y: 0px;
        width: 96px;
        text: root.cost;
        font-size: 10px;
        font-weight: 700;
        color: Theme.emphasis;
        horizontal-alignment: TextHorizontalAlignment.right;
    }
    Meter {
        x: 0px;
        y: 22px;
        width: 392px;
        height: 2px;
        pct: root.share;
        tint: Theme.muted;
    }
}

// 横屏质量指标：118 宽
component QStatL inherits Rectangle {
    in property <string> k;
    in property <string> v;
    in property <color> tint: Theme.emphasis;
    width: 118px;
    height: 44px;
    Text {
        x: 0px;
        y: 0px;
        text: root.k;
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Mono {
        x: 0px;
        y: 14px;
        height: 28px;
        text: root.v;
        font-size: 18px;
        font-weight: 700;
        color: root.tint;
        vertical-alignment: TextVerticalAlignment.center;
    }
}

export component PageToken inherits Rectangle {
    in property <int> idx: 1;
    x: (root.idx - Ui.page) * ((root.idx - Ui.page) <= 0 ? 395px : 1142px);
    animate x {
        duration: 520ms;
        easing: ease-out;
    }
    width: 1142px;
    height: 404px;
    property <bool> act: Ui.page == root.idx;
    opacity: act ? 1.0 : 0.0;
    animate opacity {
        duration: 420ms;
        easing: ease-out;
        delay: 40ms;
    }

    // 舱位分隔
    Rectangle {
        x: 358px;
        y: 0px;
        width: 1px;
        height: 404px;
        background: Theme.border;
    }
    Rectangle {
        x: 762px;
        y: 0px;
        width: 1px;
        height: 404px;
        background: Theme.border;
    }

    // ═══ A 舱 0–352：今日用量 / 实时吞吐 / 最近调用 ═══
    SheetHead {
        x: 0px;
        y: 0px;
        width: 352px;
        title: "今日用量";
        meta: "近 24 小时";
        meta-w: 80px;
    }
    req_big := Mono {
        x: 0px;
        y: 22px;
        text: Tok.today-reqs;
        font-size: 64px;
        height: 64px;
        vertical-alignment: TextVerticalAlignment.center;
        font-weight: 700;
        color: Theme.emphasis;
    }
    Text {
        x: req_big.x + req_big.preferred-width + 6px;
        y: 58px;
        text: "次请求";
        font-size: 9px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Text {
        x: 200px;
        y: 28px;
        width: 44px;
        height: 16px;
        text: "成功率";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 200px;
        y: 28px;
        width: 152px;
        height: 16px;
        text: Tok.success-str + "%";
        font-size: 10.5px;
        color: Theme.emphasis;
        horizontal-alignment: TextHorizontalAlignment.right;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 200px;
        y: 50px;
        width: 44px;
        height: 16px;
        text: "费用";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 200px;
        y: 50px;
        width: 152px;
        height: 16px;
        text: Tok.t-cost;
        font-size: 10.5px;
        color: Theme.emphasis;
        horizontal-alignment: TextHorizontalAlignment.right;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 200px;
        y: 72px;
        width: 44px;
        height: 16px;
        text: "缓存率";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 200px;
        y: 72px;
        width: 152px;
        height: 16px;
        text: Tok.t-hit;
        font-size: 10.5px;
        color: Theme.fg;
        horizontal-alignment: TextHorizontalAlignment.right;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 0px;
        y: 110px;
        text: "Tokens";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Mono {
        x: 0px;
        y: 124px;
        width: 170px;
        text: Tok.t-tokens;
        font-size: 13px;
        font-weight: 700;
        color: Theme.emphasis;
    }
    Text {
        x: 182px;
        y: 110px;
        text: "缓存命中";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Mono {
        x: 182px;
        y: 124px;
        width: 170px;
        text: Tok.t-cached;
        font-size: 13px;
        font-weight: 700;
        color: Theme.fg;
    }
    Text {
        x: 0px;
        y: 148px;
        text: Tok.daily-avg;
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Text {
        x: 0px;
        y: 148px;
        width: 352px;
        text: Tok.forecast;
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        horizontal-alignment: TextHorizontalAlignment.right;
    }
    Rectangle {
        x: 0px;
        y: 166px;
        width: 352px;
        height: 1px;
        background: Theme.border;
    }

    SheetHead {
        x: 0px;
        y: 174px;
        width: 352px;
        title: "实时吞吐";
        meta: Tok.ws-ok ? "WS 在线" : "WS 断开";
        meta-w: 76px;
        meta-tint: Tok.ws-ok ? Theme.success : Theme.warning;
    }
    tps_big := Mono {
        x: 0px;
        y: 200px;
        text: Tok.tps-str;
        font-size: 24px;
        height: 24px;
        vertical-alignment: TextVerticalAlignment.center;
        font-weight: 700;
        color: Theme.emphasis;
    }
    Text {
        x: tps_big.x + tps_big.preferred-width + 6px;
        y: 208px;
        text: "tokens/s";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Tag {
        x: 352px - self.width;
        y: 202px;
        label: "活跃流 \{Tok.streams}";
        tint: Tok.streams > 0 ? Theme.success : Theme.muted;
        dot: true;
    }
    Well {
        x: 0px;
        y: 232px;
        width: 352px;
        height: 80px;
    }
    AreaChart {
        x: 0px;
        y: 232px;
        width: 352px;
        height: 80px;
        line-pts: Tok.tps-line;
        area-pts: Tok.tps-area;
        tint: Theme.accent;
    }
    Mono {
        x: 0px;
        y: 318px;
        width: 352px;
        text: Tok.tps-info;
        font-size: 8px;
        color: Theme.muted;
        overflow: elide;
    }
    Text {
        x: 0px;
        y: 334px;
        height: 16px;
        text: "最近一次调用";
        font-size: 8px;
        color: Theme.muted;
        font-family: Theme.font-body;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 72px;
        y: 334px;
        width: 280px;
        height: 16px;
        text: Tok.last-req;
        font-size: 9px;
        color: Theme.fg;
        font-family: Theme.font-body;
        overflow: elide;
        vertical-alignment: TextVerticalAlignment.center;
    }

    // ═══ B 舱 364–756：模型排行 / 上游渠道 ═══
    SheetHead {
        x: 364px;
        y: 0px;
        width: 392px;
        title: "模型排行";
        meta: "近 7 天 · 按费用";
        meta-w: 110px;
    }
    if Tok.models.length == 0: Text {
        x: 364px;
        y: 30px;
        text: "无数据";
        font-size: 9px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    for m[i] in Tok.models: ModelRowL {
        x: 364px;
        y: 28px + i * 32px;
        visible: i < 5;
        name: m.name;
        reqs: m.reqs;
        tokens: m.tokens;
        cost: m.cost;
        share-str: m.share-str;
        share: m.share;
    }
    Rectangle {
        x: 364px;
        y: 200px;
        width: 392px;
        height: 1px;
        background: Theme.border;
    }
    SheetHead {
        x: 364px;
        y: 208px;
        width: 392px;
        title: "上游渠道";
        meta: "Top 4 · 条=平均延迟";
        meta-w: 140px;
    }
    if Tok.chans.length == 0: Text {
        x: 364px;
        y: 238px;
        text: "无数据";
        font-size: 9px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    for ch[i] in Tok.chans: ChanRowL {
        x: 364px;
        y: 236px + i * 32px;
        visible: i < 4;
        name: ch.name;
        reqs: ch.reqs;
        avg: ch.avg;
        balance: ch.balance;
        cost: ch.cost;
        share: ch.share;
        health: ch.health;
    }
    Text {
        x: 364px;
        y: 370px;
        width: 392px;
        text: "条长 = 请求占比 · 延迟 >8s 转琥珀 / >12s 转红";
        font-size: 8px;
        color: Theme.muted;
        font-family: Theme.font-body;
        overflow: elide;
    }

    // ═══ C 舱 768–1142：质量指标 / 调用方 / 网关与累计 ═══
    SheetHead {
        x: 768px;
        y: 0px;
        width: 374px;
        title: "质量指标";
        meta: "近 7 天";
        meta-w: 56px;
    }
    QStatL {
        x: 768px;
        y: 28px;
        k: "错误率";
        v: Tok.err-str + "%";
        tint: Tok.err-pct < 3.0 ? Theme.emphasis : (Tok.err-pct < 10.0 ? Theme.warning : Theme.error);
    }
    QStatL {
        x: 896px;
        y: 28px;
        k: "平均延迟";
        v: Tok.avg-lat;
        tint: Tok.avg-lat == "--" ? Theme.muted : (Tok.avg-lat-num < 3.0 ? Theme.emphasis : (Tok.avg-lat-num < 8.0 ? Theme.warning : Theme.error));
    }
    QStatL {
        x: 1024px;
        y: 28px;
        k: "缓存命中";
        v: Tok.cache7;
        tint: Tok.cache7-num >= 80.0 ? Theme.emphasis : (Tok.cache7-num >= 50.0 ? Theme.warning : Theme.error);
    }
    Well {
        x: 768px;
        y: 78px;
        width: 374px;
        height: 48px;
    }
    AreaChart {
        x: 768px;
        y: 78px;
        width: 374px;
        height: 48px;
        line-pts: Tok.trend-line;
        area-pts: Tok.trend-area;
        tint: Theme.accent;
    }
    Mono {
        x: 768px;
        y: 132px;
        width: 374px;
        text: Tok.trend-info;
        font-size: 8px;
        color: Theme.muted;
        overflow: elide;
    }
    Rectangle {
        x: 768px;
        y: 150px;
        width: 374px;
        height: 1px;
        background: Theme.border;
    }

    SheetHead {
        x: 768px;
        y: 158px;
        width: 374px;
        title: "调用方";
        meta: "近 7 天";
        meta-w: 56px;
    }
    if Tok.keys.length == 0: Text {
        x: 768px;
        y: 188px;
        text: "无数据";
        font-size: 9px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    for k[i] in Tok.keys: Rectangle {
        x: 768px;
        y: 186px + i * 22px;
        width: 374px;
        height: 20px;
        visible: i < 4;
        Text {
            x: 0px;
            y: 0px;
            width: 160px;
            height: 100%;
            text: k.name;
            font-size: 10px;
            color: Theme.fg;
            font-family: Theme.font-body;
            overflow: elide;
            vertical-alignment: TextVerticalAlignment.center;
        }
        Mono {
            x: 166px;
            y: 0px;
            width: 52px;
            height: 100%;
            text: k.reqs;
            font-size: 9px;
            color: Theme.muted;
            vertical-alignment: TextVerticalAlignment.center;
        }
        Mono {
            x: 220px;
            y: 0px;
            width: 40px;
            height: 100%;
            text: k.share;
            font-size: 8px;
            color: Theme.muted;
            vertical-alignment: TextVerticalAlignment.center;
        }
        Mono {
            x: 264px;
            y: 0px;
            width: 110px;
            height: 100%;
            text: k.cost;
            font-size: 10px;
            font-weight: 700;
            color: Theme.emphasis;
            horizontal-alignment: TextHorizontalAlignment.right;
            vertical-alignment: TextVerticalAlignment.center;
        }
    }
    Rectangle {
        x: 768px;
        y: 274px;
        width: 374px;
        height: 1px;
        background: Theme.border;
    }

    SheetHead {
        x: 768px;
        y: 282px;
        width: 374px;
        title: "网关与累计";
        meta: Tok.gw-state;
        meta-w: 60px;
    }
    Text {
        x: 768px;
        y: 310px;
        width: 110px;
        height: 20px;
        text: "累计 tokens";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 878px;
        y: 310px;
        width: 264px;
        height: 20px;
        text: Tok.lt-tokens;
        font-size: 10.5px;
        color: Theme.emphasis;
        horizontal-alignment: TextHorizontalAlignment.right;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 768px;
        y: 332px;
        width: 110px;
        height: 20px;
        text: "峰值日";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 878px;
        y: 332px;
        width: 264px;
        height: 20px;
        text: Tok.lt-peak;
        font-size: 10.5px;
        color: Theme.fg;
        horizontal-alignment: TextHorizontalAlignment.right;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 768px;
        y: 354px;
        width: 110px;
        height: 20px;
        text: "连续 / 最长";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 878px;
        y: 354px;
        width: 264px;
        height: 20px;
        text: Tok.lt-streak;
        font-size: 10.5px;
        color: Theme.fg;
        horizontal-alignment: TextHorizontalAlignment.right;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 768px;
        y: 376px;
        width: 374px;
        height: 20px;
        text: Tok.last-error == "" ? Tok.budget : Tok.last-error;
        font-size: 8.5px;
        color: Tok.last-error == "" ? Theme.muted : Theme.error;
        font-family: Theme.font-body;
        overflow: elide;
        vertical-alignment: TextVerticalAlignment.center;
    }
}

component ModelRow inherits Rectangle {
    in property <string> name;
    in property <string> reqs;
    in property <string> tokens;
    in property <string> cost;
    in property <string> share-str;
    in property <float> share;
    in property <int> idx;
    width: 508px;
    height: 32px;
    Text {
        x: 0px;
        y: 0px;
        width: 176px;
        text: root.name;
        font-size: 11px;
        font-weight: 600;
        color: Theme.emphasis;
        font-family: Theme.font-body;
        overflow: elide;
    }
    Mono {
        x: 182px;
        y: 1px;
        width: 52px;
        text: root.reqs;
        font-size: 9px;
        color: Theme.fg;
    }
    Mono {
        x: 238px;
        y: 1px;
        width: 84px;
        text: root.tokens;
        font-size: 9px;
        color: Theme.muted;
    }
    Mono {
        x: 330px;
        y: 0px;
        width: 178px;
        text: root.cost;
        font-size: 10.5px;
        font-weight: 700;
        color: Theme.emphasis;
        horizontal-alignment: TextHorizontalAlignment.right;
    }
    Meter {
        x: 0px;
        y: 22px;
        width: 424px;
        height: 3px;
        pct: root.share;
        tint: Theme.emphasis;
    }
    Mono {
        x: 432px;
        y: 16px;
        width: 76px;
        text: root.share-str;
        font-size: 8px;
        color: Theme.muted;
        horizontal-alignment: TextHorizontalAlignment.right;
    }
}

