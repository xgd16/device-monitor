component QStat inherits Rectangle {
    in property <string> k;
    in property <string> v;
    in property <color> tint: Theme.emphasis;
    width: 169px;
    height: 44px;
    Text {
        x: 0px;
        y: 0px;
        text: root.k;
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
