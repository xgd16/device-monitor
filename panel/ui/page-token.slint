// 第 2 页：XTokenHub Token 用量。数据来自 XTokenHub 自有 REST + WS。
// 页面组件固定 1142x404，三列宽 337/404/381。
// 面积图路径串由 Rust 按「309x72」（吞吐）/「353x40」（7 天趋势）盒子生成。
import { Theme } from "theme.slint";
import { Tok, Ui } from "data.slint";
import { Card, Pill, StatBar, AreaChart, LiveDot, Mono } from "widgets.slint";

export component PageToken inherits Rectangle {
    in property <int> idx: 1;
    x: (root.idx - Ui.page) * ((root.idx - Ui.page) <= 0 ? 395px : 1142px);
    animate x {
        duration: 520ms;
        easing: ease-out;
    }
    width: 1142px;
    height: 404px;
    property <bool> act: Ui.page == root.idx;

    // ── 第 1 列：今日用量 / 实时吞吐 ──
    Rectangle {
        x: 0px;
        y: act ? 0px : 14px;
        width: 337px;
        height: 404px;
        opacity: act ? 1.0 : 0.0;
        animate opacity {
            duration: 420ms;
            easing: ease-out;
            delay: 40ms;
        }
        animate y {
            duration: 480ms;
            easing: ease-out;
            delay: 40ms;
        }

        Card {
            x: 0px;
            y: 0px;
            width: 337px;
            height: 200px;
            title: "今日用量（今日 00:00 起）";
            Pill {
                y: 8px;
                x: parent.width - self.width - 12px;
                label: "成功 " + Tok.success-str + "%";
                fg: Tok.success-rate >= 98.0 ? Theme.success : (Tok.success-rate >= 95.0 ? Theme.warning : Theme.error);
                bg: Theme.card-alt;
                horizontal-stretch: 0;
            }
            req_big := Mono {
                x: 14px;
                y: 26px;
                text: Tok.today-reqs;
                font-size: 34px;
                font-weight: 700;
                color: Theme.accent;
            }
            Text {
                x: req_big.x + req_big.preferred-width + 6px;
                y: 44px;
                text: "次请求";
                font-size: 10px;
                color: Theme.muted;
                font-family: Theme.font-body;
            }
            Rectangle {
                x: 14px;
                y: 68px;
                width: 309px;
                height: 26px;
                Text {
                    x: 0px;
                    text: "Tokens";
                    font-size: 9px;
                    color: Theme.muted;
                    font-family: Theme.font-body;
                    vertical-alignment: TextVerticalAlignment.center;
                }
                Mono {
                    x: 0px;
                    width: 309px;
                    text: Tok.t-tokens;
                    font-size: 12px;
                    font-weight: 700;
                    color: Theme.emphasis;
                    horizontal-alignment: TextHorizontalAlignment.right;
                    vertical-alignment: TextVerticalAlignment.center;
                }
            }
            Rectangle {
                x: 14px;
                y: 94px;
                width: 309px;
                height: 26px;
                Text {
                    x: 0px;
                    text: "缓存命中";
                    font-size: 9px;
                    color: Theme.muted;
                    font-family: Theme.font-body;
                    vertical-alignment: TextVerticalAlignment.center;
                }
                Mono {
                    x: 0px;
                    width: 309px;
                    text: Tok.t-cached;
                    font-size: 12px;
                    font-weight: 700;
                    color: Theme.info;
                    horizontal-alignment: TextHorizontalAlignment.right;
                    vertical-alignment: TextVerticalAlignment.center;
                }
            }
            Rectangle {
                x: 14px;
                y: 120px;
                width: 309px;
                height: 26px;
                Text {
                    x: 0px;
                    text: "费用";
                    font-size: 9px;
                    color: Theme.muted;
                    font-family: Theme.font-body;
                    vertical-alignment: TextVerticalAlignment.center;
                }
                Mono {
                    x: 0px;
                    width: 309px;
                    text: Tok.t-cost;
                    font-size: 12px;
                    font-weight: 700;
                    color: Theme.emphasis;
                    horizontal-alignment: TextHorizontalAlignment.right;
                    vertical-alignment: TextVerticalAlignment.center;
                }
            }
            Rectangle {
                x: 14px;
                y: 146px;
                width: 309px;
                height: 26px;
                Text {
                    x: 0px;
                    text: "缓存命中率";
                    font-size: 9px;
                    color: Theme.muted;
                    font-family: Theme.font-body;
                    vertical-alignment: TextVerticalAlignment.center;
                }
                Mono {
                    x: 0px;
                    width: 309px;
                    text: Tok.t-hit;
                    font-size: 12px;
                    font-weight: 700;
                    color: Theme.success;
                    horizontal-alignment: TextHorizontalAlignment.right;
                    vertical-alignment: TextVerticalAlignment.center;
                }
            }
            Rectangle {
                x: 14px;
                y: 174px;
                width: 309px;
                height: 1px;
                background: Theme.border;
            }
            Text {
                x: 14px;
                y: 178px;
                text: Tok.forecast;
                font-size: 8.5px;
                color: Theme.muted;
                font-family: Theme.font-body;
            }
            Mono {
                x: 0px;
                width: parent.width - 14px;
                y: 178px;
                text: Tok.daily-avg;
                font-size: 8.5px;
                color: Theme.muted;
                horizontal-alignment: TextHorizontalAlignment.right;
            }
        }

        Card {
            x: 0px;
            y: 210px;
            width: 337px;
            height: 194px;
            title: "实时吞吐（WebSocket）";
            Pill {
                y: 8px;
                x: parent.width - self.width - 12px;
                label: "活跃流 \{Tok.streams}";
                fg: Tok.streams > 0 ? Theme.success : Theme.muted;
                bg: Theme.card-alt;
                horizontal-stretch: 0;
            }
            tps_big := Mono {
                x: 14px;
                y: 24px;
                text: Tok.tps-str;
                font-size: 30px;
                font-weight: 700;
                color: Theme.info;
            }
            Text {
                x: tps_big.x + tps_big.preferred-width + 6px;
                y: 40px;
                text: "tokens/s";
                font-size: 9px;
                color: Theme.muted;
                font-family: Theme.font-body;
            }
            LiveDot {
                x: parent.width - 24px;
                y: 34px;
                tint: Tok.ws-ok ? Theme.info : Theme.warning;
                on: Tok.ws-ok;
            }
            Rectangle {
                x: 14px;
                y: 64px;
                width: 309px;
                height: 72px;
                background: Theme.card-alt;
                border-radius: 8px;
                AreaChart {
                    x: 0px;
                    y: 0px;
                    width: 309px;
                    height: 72px;
                    line-pts: Tok.tps-line;
                    area-pts: Tok.tps-area;
                    tint: Theme.info;
                }
            }
            Mono {
                x: 14px;
                y: 142px;
                width: 309px;
                text: Tok.tps-info;
                font-size: 8px;
                color: Theme.muted;
            }
            Rectangle {
                x: 14px;
                y: 156px;
                width: 309px;
                height: 1px;
                background: Theme.border;
            }
            Text {
                x: 14px;
                y: 161px;
                text: "最近一次调用";
                font-size: 8px;
                color: Theme.muted;
                font-family: Theme.font-body;
            }
            Text {
                x: 14px;
                y: 174px;
                width: 309px;
                text: Tok.last-req;
                font-size: 8.5px;
                color: Theme.fg;
                font-family: Theme.font-body;
                overflow: elide;
            }
        }
    }

    // ── 第 2 列：模型排行 / 上游渠道 ──
    Rectangle {
        x: 347px;
        y: act ? 0px : 14px;
        width: 404px;
        height: 404px;
        opacity: act ? 1.0 : 0.0;
        animate opacity {
            duration: 420ms;
            easing: ease-out;
            delay: 110ms;
        }
        animate y {
            duration: 480ms;
            easing: ease-out;
            delay: 110ms;
        }

        Card {
            x: 0px;
            y: 0px;
            width: 404px;
            height: 192px;
            title: "模型排行（近 7 天）";
            if Tok.models.length == 0: Text {
                x: 14px;
                y: 40px;
                text: "无数据";
                font-size: 10px;
                color: Theme.muted;
                font-family: Theme.font-body;
            }
            for m[i] in Tok.models: Rectangle {
                x: 14px;
                y: 28px + i * 32px;
                width: 376px;
                height: 30px;
                Text {
                    x: 0px;
                    y: 0px;
                    width: 150px;
                    text: m.name;
                    font-size: 10.5px;
                    font-weight: 700;
                    color: Theme.emphasis;
                    font-family: Theme.font-body;
                    overflow: elide;
                }
                Mono {
                    x: 156px;
                    y: 1px;
                    width: 52px;
                    text: m.reqs;
                    font-size: 9px;
                    color: Theme.fg;
                }
                Mono {
                    x: 212px;
                    y: 1px;
                    width: 64px;
                    text: m.tokens;
                    font-size: 8px;
                    color: Theme.muted;
                }
                Mono {
                    x: 0px;
                    width: 376px;
                    y: 0px;
                    text: m.cost;
                    font-size: 10.5px;
                    font-weight: 700;
                    color: Theme.rank-color(i);
                    horizontal-alignment: TextHorizontalAlignment.right;
                }
                StatBar {
                    x: 0px;
                    y: 18px;
                    width: 340px;
                    height: 4px;
                    pct: m.share;
                    tint: [Theme.accent, Theme.success, Theme.info, Theme.accent2, Theme.warning, Theme.error][Math.mod(i, 6)];
                }
                Mono {
                    x: 346px;
                    y: 12px;
                    width: 30px;
                    text: m.share-str;
                    font-size: 8px;
                    color: Theme.muted;
                }
            }
        }

        Card {
            x: 0px;
            y: 202px;
            width: 404px;
            height: 202px;
            title: "上游渠道与余额";
            Text {
                x: 0px;
                width: parent.width - 14px;
                y: 11px;
                text: "按用量 Top · 条=平均延迟";
                font-size: 8px;
                color: Theme.muted;
                font-family: Theme.font-body;
                horizontal-alignment: TextHorizontalAlignment.right;
            }
            if Tok.chans.length == 0: Text {
                x: 14px;
                y: 40px;
                text: "无数据";
                font-size: 10px;
                color: Theme.muted;
                font-family: Theme.font-body;
            }
            for ch[i] in Tok.chans: Rectangle {
                x: 14px;
                y: 28px + i * 42px;
                width: 376px;
                height: 40px;
                Text {
                    x: 0px;
                    y: 0px;
                    width: 130px;
                    text: ch.name;
                    font-size: 10px;
                    color: Theme.fg;
                    font-family: Theme.font-body;
                    overflow: elide;
                }
                Mono {
                    x: 134px;
                    y: 1px;
                    width: 44px;
                    text: ch.reqs;
                    font-size: 9px;
                    color: Theme.fg;
                }
                Mono {
                    x: 180px;
                    y: 1px;
                    width: 46px;
                    text: ch.avg;
                    font-size: 9px;
                    color: ch.health < 3.0 ? Theme.success : (ch.health < 8.0 ? Theme.warning : Theme.error);
                }
                Text {
                    x: 230px;
                    y: 1px;
                    width: 70px;
                    text: ch.balance;
                    font-size: 8px;
                    color: ch.balance == "余额 —" ? Theme.muted : Theme.info;
                    font-family: Theme.font-body;
                    overflow: elide;
                }
                Mono {
                    x: 0px;
                    width: 376px;
                    y: 0px;
                    text: ch.cost;
                    font-size: 10px;
                    font-weight: 700;
                    color: Theme.success;
                    horizontal-alignment: TextHorizontalAlignment.right;
                }
                StatBar {
                    x: 0px;
                    y: 22px;
                    width: 376px;
                    height: 4px;
                    pct: ch.share;
                    tint: ch.health < 3.0 ? Theme.success : (ch.health < 8.0 ? Theme.warning : Theme.error);
                }
            }
        }
    }

    // ── 第 3 列：质量指标 / 调用方 / 网关与累计 ──
    Rectangle {
        x: 761px;
        y: act ? 0px : 14px;
        width: 381px;
        height: 404px;
        opacity: act ? 1.0 : 0.0;
        animate opacity {
            duration: 420ms;
            easing: ease-out;
            delay: 180ms;
        }
        animate y {
            duration: 480ms;
            easing: ease-out;
            delay: 180ms;
        }

        Card {
            x: 0px;
            y: 0px;
            width: 381px;
            height: 150px;
            title: "质量指标（近 7 天）";
            Rectangle {
                x: 14px;
                y: 26px;
                width: 110px;
                height: 40px;
                Text {
                    x: 0px;
                    y: 0px;
                    height: 10px;
                    vertical-alignment: TextVerticalAlignment.top;
                    text: "错误率";
                    font-size: 8px;
                    color: Theme.muted;
                    font-family: Theme.font-body;
                }
                Mono {
                    x: 0px;
                    y: 13px;
                    height: 18px;
                    vertical-alignment: TextVerticalAlignment.center;
                    text: Tok.err-str + "%";
                    font-size: 16px;
                    font-weight: 700;
                    color: Tok.err-pct < 3.0 ? Theme.success : (Tok.err-pct < 10.0 ? Theme.warning : Theme.error);
                }
            }
            Rectangle {
                x: 134px;
                y: 26px;
                width: 110px;
                height: 40px;
                Text {
                    x: 0px;
                    y: 0px;
                    height: 10px;
                    vertical-alignment: TextVerticalAlignment.top;
                    text: "平均延迟";
                    font-size: 8px;
                    color: Theme.muted;
                    font-family: Theme.font-body;
                }
                Mono {
                    x: 0px;
                    y: 13px;
                    height: 18px;
                    vertical-alignment: TextVerticalAlignment.center;
                    text: Tok.avg-lat;
                    font-size: 16px;
                    font-weight: 700;
                    color: Tok.avg-lat == "--" ? Theme.muted : (Tok.avg-lat-num < 3.0 ? Theme.success : (Tok.avg-lat-num < 8.0 ? Theme.warning : Theme.error));
                }
            }
            Rectangle {
                x: 254px;
                y: 26px;
                width: 113px;
                height: 40px;
                Text {
                    x: 0px;
                    y: 0px;
                    height: 10px;
                    vertical-alignment: TextVerticalAlignment.top;
                    text: "缓存命中";
                    font-size: 8px;
                    color: Theme.muted;
                    font-family: Theme.font-body;
                }
                Mono {
                    x: 0px;
                    y: 13px;
                    height: 18px;
                    vertical-alignment: TextVerticalAlignment.center;
                    text: Tok.cache7;
                    font-size: 16px;
                    font-weight: 700;
                    color: Tok.cache7-num >= 80.0 ? Theme.success : (Tok.cache7-num >= 50.0 ? Theme.warning : Theme.error);
                }
            }
            StatBar {
                x: 14px;
                y: 74px;
                width: 353px;
                height: 4px;
                pct: Tok.err-pct;
                tint: Tok.err-pct < 3.0 ? Theme.success : (Tok.err-pct < 10.0 ? Theme.warning : Theme.error);
            }
            Rectangle {
                x: 14px;
                y: 86px;
                width: 353px;
                height: 40px;
                background: Theme.card-alt;
                border-radius: 8px;
                AreaChart {
                    x: 0px;
                    y: 0px;
                    width: 353px;
                    height: 40px;
                    line-pts: Tok.trend-line;
                    area-pts: Tok.trend-area;
                    tint: Theme.accent;
                }
            }
            Mono {
                x: 14px;
                y: 132px;
                width: 353px;
                text: Tok.trend-info;
                font-size: 8px;
                color: Theme.muted;
                overflow: elide;
            }
        }

        Card {
            x: 0px;
            y: 160px;
            width: 381px;
            height: 110px;
            title: "调用方（API Key，近 7 天）";
            if Tok.keys.length == 0: Text {
                x: 14px;
                y: 40px;
                text: "无数据";
                font-size: 10px;
                color: Theme.muted;
                font-family: Theme.font-body;
            }
            for k[i] in Tok.keys: Rectangle {
                x: 14px;
                y: 28px + i * 20px;
                width: 353px;
                height: 18px;
                Text {
                    x: 0px;
                    y: 0px;
                    width: 150px;
                    text: k.name;
                    font-size: 9.5px;
                    color: Theme.fg;
                    font-family: Theme.font-body;
                    overflow: elide;
                    vertical-alignment: TextVerticalAlignment.center;
                }
                Mono {
                    x: 156px;
                    y: 0px;
                    width: 60px;
                    text: k.reqs;
                    font-size: 8.5px;
                    color: Theme.fg;
                    vertical-alignment: TextVerticalAlignment.center;
                }
                Mono {
                    x: 220px;
                    y: 0px;
                    width: 50px;
                    text: k.share;
                    font-size: 8px;
                    color: Theme.muted;
                    vertical-alignment: TextVerticalAlignment.center;
                }
                Mono {
                    x: 0px;
                    width: 353px;
                    y: 0px;
                    text: k.cost;
                    font-size: 10px;
                    font-weight: 700;
                    color: Theme.emphasis;
                    horizontal-alignment: TextHorizontalAlignment.right;
                    vertical-alignment: TextVerticalAlignment.center;
                }
            }
        }

        Card {
            x: 0px;
            y: 280px;
            width: 381px;
            height: 124px;
            title: "网关与累计";
            Pill {
                y: 8px;
                x: parent.width - self.width - 12px;
                label: Tok.gw-state;
                fg: Tok.gw-state == "正常" ? Theme.success : (Tok.gw-state == "WS 断开" ? Theme.warning : Theme.error);
                bg: Theme.card-alt;
                horizontal-stretch: 0;
            }
            Rectangle {
                x: 14px;
                y: 28px;
                width: 353px;
                height: 22px;
                Text {
                    x: 0px;
                    text: "累计 tokens";
                    font-size: 9px;
                    color: Theme.muted;
                    font-family: Theme.font-body;
                    vertical-alignment: TextVerticalAlignment.center;
                }
                Mono {
                    x: 0px;
                    width: 353px;
                    text: Tok.lt-tokens;
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.emphasis;
                    horizontal-alignment: TextHorizontalAlignment.right;
                    vertical-alignment: TextVerticalAlignment.center;
                }
            }
            Rectangle {
                x: 14px;
                y: 52px;
                width: 353px;
                height: 22px;
                Text {
                    x: 0px;
                    text: "峰值日";
                    font-size: 9px;
                    color: Theme.muted;
                    font-family: Theme.font-body;
                    vertical-alignment: TextVerticalAlignment.center;
                }
                Mono {
                    x: 0px;
                    width: 353px;
                    text: Tok.lt-peak;
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.fg;
                    horizontal-alignment: TextHorizontalAlignment.right;
                    vertical-alignment: TextVerticalAlignment.center;
                }
            }
            Rectangle {
                x: 14px;
                y: 76px;
                width: 353px;
                height: 22px;
                Text {
                    x: 0px;
                    text: "连续 / 最长";
                    font-size: 9px;
                    color: Theme.muted;
                    font-family: Theme.font-body;
                    vertical-alignment: TextVerticalAlignment.center;
                }
                Mono {
                    x: 0px;
                    width: 353px;
                    text: Tok.lt-streak;
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.fg;
                    horizontal-alignment: TextHorizontalAlignment.right;
                    vertical-alignment: TextVerticalAlignment.center;
                }
            }
            Text {
                x: 14px;
                y: 106px;
                width: 353px;
                text: Tok.last-error == "" ? Tok.budget : Tok.last-error;
                font-size: 8px;
                color: Tok.last-error == "" ? Theme.muted : Theme.error;
                font-family: Theme.font-body;
                overflow: elide;
            }
        }
    }
}

// ── 竖屏版（540x1170）：单列/半宽混排，内容宽 484（半宽卡 223）──
export component PageTokenP inherits Rectangle {
    in property <int> idx: 1;
    x: (root.idx - Ui.page) * ((root.idx - Ui.page) <= 0 ? 256px : 512px);
    animate x {
        duration: 520ms;
        easing: ease-out;
    }
    width: 512px;
    height: 1028px;
    // 非激活页全透明（与横版一致）
    property <bool> act: Ui.page == root.idx;
    opacity: act ? 1.0 : 0.0;
    animate opacity {
        duration: 420ms;
        easing: ease-out;
        delay: 40ms;
    }

    // ── 今日用量（半宽）──
    Card {
        x: 0px;
        y: 0px;
        width: 251px;
        height: 184px;
        title: "今日用量";
        req_big := Mono {
            x: 14px;
            y: 24px;
            text: Tok.today-reqs;
            font-size: 34px;
            font-weight: 700;
            color: Theme.accent;
        }
        Text {
            x: req_big.x + req_big.preferred-width + 6px;
            y: 42px;
            text: "次请求";
            font-size: 10px;
            color: Theme.muted;
            font-family: Theme.font-body;
        }
        Rectangle {
            x: 14px;
            y: 64px;
            width: 223px;
            height: 22px;
            Text {
                x: 0px;
                text: "Tokens";
                font-size: 9px;
                color: Theme.muted;
                font-family: Theme.font-body;
                vertical-alignment: TextVerticalAlignment.center;
            }
            Mono {
                x: 0px;
                width: 223px;
                text: Tok.t-tokens;
                font-size: 12px;
                font-weight: 700;
                color: Theme.emphasis;
                horizontal-alignment: TextHorizontalAlignment.right;
                vertical-alignment: TextVerticalAlignment.center;
            }
        }
        Rectangle {
            x: 14px;
            y: 86px;
            width: 223px;
            height: 22px;
            Text {
                x: 0px;
                text: "缓存命中";
                font-size: 9px;
                color: Theme.muted;
                font-family: Theme.font-body;
                vertical-alignment: TextVerticalAlignment.center;
            }
            Mono {
                x: 0px;
                width: 223px;
                text: Tok.t-cached;
                font-size: 12px;
                font-weight: 700;
                color: Theme.info;
                horizontal-alignment: TextHorizontalAlignment.right;
                vertical-alignment: TextVerticalAlignment.center;
            }
        }
        Rectangle {
            x: 14px;
            y: 108px;
            width: 223px;
            height: 22px;
            Text {
                x: 0px;
                text: "费用";
                font-size: 9px;
                color: Theme.muted;
                font-family: Theme.font-body;
                vertical-alignment: TextVerticalAlignment.center;
            }
            Mono {
                x: 0px;
                width: 223px;
                text: Tok.t-cost;
                font-size: 12px;
                font-weight: 700;
                color: Theme.emphasis;
                horizontal-alignment: TextHorizontalAlignment.right;
                vertical-alignment: TextVerticalAlignment.center;
            }
        }
        Rectangle {
            x: 14px;
            y: 130px;
            width: 223px;
            height: 22px;
            Text {
                x: 0px;
                text: "缓存命中率";
                font-size: 9px;
                color: Theme.muted;
                font-family: Theme.font-body;
                vertical-alignment: TextVerticalAlignment.center;
            }
            Mono {
                x: 0px;
                width: 223px;
                text: Tok.t-hit;
                font-size: 12px;
                font-weight: 700;
                color: Theme.success;
                horizontal-alignment: TextHorizontalAlignment.right;
                vertical-alignment: TextVerticalAlignment.center;
            }
        }
        Rectangle {
            x: 14px;
            y: 156px;
            width: 223px;
            height: 1px;
            background: Theme.border;
        }
        Text {
            x: 14px;
            y: 160px;
            text: Tok.forecast;
            font-size: 8px;
            color: Theme.muted;
            font-family: Theme.font-body;
            overflow: elide;
        }
        Mono {
            x: 0px;
            width: parent.width - 14px;
            y: 160px;
            text: Tok.daily-avg;
            font-size: 8px;
            color: Theme.muted;
            horizontal-alignment: TextHorizontalAlignment.right;
        }
    }

    // ── 实时吞吐（半宽）──
    Card {
        x: 261px;
        y: 0px;
        width: 251px;
        height: 184px;
        title: "实时吞吐";
        Pill {
            y: 8px;
            x: parent.width - self.width - 12px;
            label: "活跃流 \{Tok.streams}";
            fg: Tok.streams > 0 ? Theme.success : Theme.muted;
            bg: Theme.card-alt;
            horizontal-stretch: 0;
        }
        tps_big := Mono {
            x: 14px;
            y: 20px;
            text: Tok.tps-str;
            font-size: 26px;
            font-weight: 700;
            color: Theme.info;
        }
        Text {
            x: tps_big.x + tps_big.preferred-width + 5px;
            y: 33px;
            text: "tokens/s";
            font-size: 8.5px;
            color: Theme.muted;
            font-family: Theme.font-body;
        }
        LiveDot {
            x: 206px;
            y: 30px;
            tint: Tok.ws-ok ? Theme.info : Theme.warning;
            on: Tok.ws-ok;
        }
        Rectangle {
            x: 14px;
            y: 52px;
            width: 223px;
            height: 72px;
            background: Theme.card-alt;
            border-radius: 8px;
            AreaChart {
                x: 0px;
                y: 0px;
                width: 223px;
                height: 72px;
                line-pts: Tok.tps-line-s;
                area-pts: Tok.tps-area-s;
                tint: Theme.info;
            }
        }
        Mono {
            x: 14px;
            y: 128px;
            width: 223px;
            text: Tok.tps-info;
            font-size: 7.5px;
            color: Theme.muted;
            overflow: elide;
        }
        Rectangle {
            x: 14px;
            y: 141px;
            width: 223px;
            height: 1px;
            background: Theme.border;
        }
        Text {
            x: 14px;
            y: 145px;
            text: "最近一次调用";
            font-size: 8px;
            color: Theme.muted;
            font-family: Theme.font-body;
        }
        Text {
            x: 14px;
            y: 156px;
            width: 223px;
            text: Tok.last-req;
            font-size: 8.5px;
            color: Theme.fg;
            font-family: Theme.font-body;
            overflow: elide;
        }
    }

    // ── 模型排行 ──
    Card {
        x: 0px;
        y: 194px;
        width: 512px;
        height: 176px;
        title: "模型排行（近 7 天）";
        if Tok.models.length == 0: Text {
            x: 14px;
            y: 40px;
            text: "无数据";
            font-size: 10px;
            color: Theme.muted;
            font-family: Theme.font-body;
        }
        for m[i] in Tok.models: Rectangle {
            x: 14px;
            y: 26px + i * 28px;
            width: 484px;
            height: 26px;
            Text {
                x: 0px;
                y: 0px;
                width: 170px;
                text: m.name;
                font-size: 10.5px;
                font-weight: 700;
                color: Theme.emphasis;
                font-family: Theme.font-body;
                overflow: elide;
            }
            Mono {
                x: 176px;
                y: 1px;
                width: 52px;
                text: m.reqs;
                font-size: 9px;
                color: Theme.fg;
            }
            Mono {
                x: 232px;
                y: 1px;
                width: 70px;
                text: m.tokens;
                font-size: 8px;
                color: Theme.muted;
            }
            Mono {
                x: 0px;
                width: 484px;
                y: 0px;
                text: m.cost;
                font-size: 10.5px;
                font-weight: 700;
                color: Theme.rank-color(i);
                horizontal-alignment: TextHorizontalAlignment.right;
            }
            StatBar {
                x: 0px;
                y: 16px;
                width: 400px;
                height: 4px;
                pct: m.share;
                tint: [Theme.accent, Theme.success, Theme.info, Theme.accent2, Theme.warning, Theme.error][Math.mod(i, 6)];
            }
            Mono {
                x: 406px;
                y: 12px;
                width: 34px;
                text: m.share-str;
                font-size: 8px;
                color: Theme.muted;
            }
        }
    }

    // ── 上游渠道与余额 ──
    Card {
        x: 0px;
        y: 380px;
        width: 512px;
        height: 186px;
        title: "上游渠道与余额";
        Text {
            x: 0px;
            width: parent.width - 14px;
            y: 11px;
            text: "按用量 Top · 条=平均延迟";
            font-size: 8px;
            color: Theme.muted;
            font-family: Theme.font-body;
            horizontal-alignment: TextHorizontalAlignment.right;
        }
        if Tok.chans.length == 0: Text {
            x: 14px;
            y: 40px;
            text: "无数据";
            font-size: 10px;
            color: Theme.muted;
            font-family: Theme.font-body;
        }
        for ch[i] in Tok.chans: Rectangle {
            x: 14px;
            y: 26px + i * 38px;
            width: 484px;
            height: 36px;
            Text {
                x: 0px;
                y: 0px;
                width: 110px;
                text: ch.name;
                font-size: 10px;
                color: Theme.fg;
                font-family: Theme.font-body;
                overflow: elide;
            }
            Mono {
                x: 114px;
                y: 1px;
                width: 44px;
                text: ch.reqs;
                font-size: 9px;
                color: Theme.fg;
            }
            Mono {
                x: 160px;
                y: 1px;
                width: 46px;
                text: ch.avg;
                font-size: 9px;
                color: ch.health < 3.0 ? Theme.success : (ch.health < 8.0 ? Theme.warning : Theme.error);
            }
            Text {
                x: 208px;
                y: 1px;
                width: 120px;
                text: ch.balance;
                font-size: 8px;
                color: ch.balance == "余额 —" ? Theme.muted : Theme.info;
                font-family: Theme.font-body;
                overflow: elide;
            }
            Mono {
                x: 0px;
                width: 484px;
                y: 0px;
                text: ch.cost;
                font-size: 10px;
                font-weight: 700;
                color: Theme.success;
                horizontal-alignment: TextHorizontalAlignment.right;
            }
            StatBar {
                x: 0px;
                y: 20px;
                width: 484px;
                height: 4px;
                pct: ch.share;
                tint: ch.health < 3.0 ? Theme.success : (ch.health < 8.0 ? Theme.warning : Theme.error);
            }
        }
    }

    // ── 质量指标 ──
    Card {
        x: 0px;
        y: 576px;
        width: 512px;
        height: 140px;
        title: "质量指标（近 7 天）";
        Rectangle {
            x: 14px;
            y: 24px;
            width: 150px;
            height: 40px;
            Text {
                x: 0px;
                y: 0px;
                height: 10px;
                vertical-alignment: TextVerticalAlignment.top;
                text: "错误率";
                font-size: 8px;
                color: Theme.muted;
                font-family: Theme.font-body;
            }
            Mono {
                x: 0px;
                y: 13px;
                height: 18px;
                vertical-alignment: TextVerticalAlignment.center;
                text: Tok.err-str + "%";
                font-size: 16px;
                font-weight: 700;
                color: Tok.err-pct < 3.0 ? Theme.success : (Tok.err-pct < 10.0 ? Theme.warning : Theme.error);
            }
        }
        Rectangle {
            x: 178px;
            y: 24px;
            width: 150px;
            height: 40px;
            Text {
                x: 0px;
                y: 0px;
                height: 10px;
                vertical-alignment: TextVerticalAlignment.top;
                text: "平均延迟";
                font-size: 8px;
                color: Theme.muted;
                font-family: Theme.font-body;
            }
            Mono {
                x: 0px;
                y: 13px;
                height: 18px;
                vertical-alignment: TextVerticalAlignment.center;
                text: Tok.avg-lat;
                font-size: 16px;
                font-weight: 700;
                color: Tok.avg-lat == "--" ? Theme.muted : (Tok.avg-lat-num < 3.0 ? Theme.success : (Tok.avg-lat-num < 8.0 ? Theme.warning : Theme.error));
            }
        }
        Rectangle {
            x: 342px;
            y: 24px;
            width: 154px;
            height: 40px;
            Text {
                x: 0px;
                y: 0px;
                height: 10px;
                vertical-alignment: TextVerticalAlignment.top;
                text: "缓存命中";
                font-size: 8px;
                color: Theme.muted;
                font-family: Theme.font-body;
            }
            Mono {
                x: 0px;
                y: 13px;
                height: 18px;
                vertical-alignment: TextVerticalAlignment.center;
                text: Tok.cache7;
                font-size: 16px;
                font-weight: 700;
                color: Tok.cache7-num >= 80.0 ? Theme.success : (Tok.cache7-num >= 50.0 ? Theme.warning : Theme.error);
            }
        }
        StatBar {
            x: 14px;
            y: 72px;
            width: 484px;
            height: 4px;
            pct: Tok.err-pct;
            tint: Tok.err-pct < 3.0 ? Theme.success : (Tok.err-pct < 10.0 ? Theme.warning : Theme.error);
        }
        Rectangle {
            x: 14px;
            y: 82px;
            width: 484px;
            height: 40px;
            background: Theme.card-alt;
            border-radius: 8px;
            AreaChart {
                x: 0px;
                y: 0px;
                width: 484px;
                height: 40px;
                line-pts: Tok.trend-line-p;
                area-pts: Tok.trend-area-p;
                tint: Theme.accent;
            }
        }
        Mono {
            x: 14px;
            y: 126px;
            width: 484px;
            text: Tok.trend-info;
            font-size: 8px;
            color: Theme.muted;
            overflow: elide;
        }
    }

    // ── 调用方（半宽）──
    Card {
        x: 0px;
        y: 726px;
        width: 251px;
        height: 130px;
        title: "调用方";
        if Tok.keys.length == 0: Text {
            x: 14px;
            y: 40px;
            text: "无数据";
            font-size: 10px;
            color: Theme.muted;
            font-family: Theme.font-body;
        }
        for k[i] in Tok.keys: Rectangle {
            x: 14px;
            y: 26px + i * 24px;
            width: 223px;
            height: 22px;
            Text {
                x: 0px;
                y: 0px;
                width: 100px;
                text: k.name;
                font-size: 9px;
                color: Theme.fg;
                font-family: Theme.font-body;
                overflow: elide;
                vertical-alignment: TextVerticalAlignment.center;
            }
            Mono {
                x: 104px;
                y: 0px;
                width: 46px;
                text: k.reqs;
                font-size: 8.5px;
                color: Theme.fg;
                vertical-alignment: TextVerticalAlignment.center;
            }
            Mono {
                x: 152px;
                y: 0px;
                width: 40px;
                text: k.share;
                font-size: 8px;
                color: Theme.muted;
                vertical-alignment: TextVerticalAlignment.center;
            }
            Mono {
                x: 0px;
                width: 223px;
                y: 0px;
                text: k.cost;
                font-size: 9.5px;
                font-weight: 700;
                color: Theme.fg;
                horizontal-alignment: TextHorizontalAlignment.right;
                vertical-alignment: TextVerticalAlignment.center;
            }
        }
    }

    // ── 网关与累计（半宽）──
    Card {
        x: 261px;
        y: 726px;
        width: 251px;
        height: 130px;
        title: "网关与累计";
        Pill {
            y: 8px;
            x: parent.width - self.width - 12px;
            label: Tok.gw-state;
            fg: Tok.gw-state == "正常" ? Theme.success : (Tok.gw-state == "WS 断开" ? Theme.warning : Theme.error);
            bg: Theme.card-alt;
            horizontal-stretch: 0;
        }
        Rectangle {
            x: 14px;
            y: 28px;
            width: 223px;
            height: 22px;
            Text {
                x: 0px;
                text: "累计 tokens";
                font-size: 9px;
                color: Theme.muted;
                font-family: Theme.font-body;
                vertical-alignment: TextVerticalAlignment.center;
            }
            Mono {
                x: 0px;
                width: 223px;
                text: Tok.lt-tokens;
                font-size: 11px;
                font-weight: 700;
                color: Theme.emphasis;
                horizontal-alignment: TextHorizontalAlignment.right;
                vertical-alignment: TextVerticalAlignment.center;
            }
        }
        Rectangle {
            x: 14px;
            y: 52px;
            width: 223px;
            height: 22px;
            Text {
                x: 0px;
                text: "峰值日";
                font-size: 9px;
                color: Theme.muted;
                font-family: Theme.font-body;
                vertical-alignment: TextVerticalAlignment.center;
            }
            Mono {
                x: 0px;
                width: 223px;
                text: Tok.lt-peak;
                font-size: 11px;
                font-weight: 700;
                color: Theme.fg;
                horizontal-alignment: TextHorizontalAlignment.right;
                vertical-alignment: TextVerticalAlignment.center;
            }
        }
        Rectangle {
            x: 14px;
            y: 76px;
            width: 223px;
            height: 22px;
            Text {
                x: 0px;
                text: "连续 / 最长";
                font-size: 9px;
                color: Theme.muted;
                font-family: Theme.font-body;
                vertical-alignment: TextVerticalAlignment.center;
            }
            Mono {
                x: 0px;
                width: 223px;
                text: Tok.lt-streak;
                font-size: 11px;
                font-weight: 700;
                color: Theme.fg;
                horizontal-alignment: TextHorizontalAlignment.right;
                vertical-alignment: TextVerticalAlignment.center;
            }
        }
        Text {
            x: 14px;
            y: 104px;
            width: 223px;
            text: Tok.last-error == "" ? Tok.budget : Tok.last-error;
            font-size: 8px;
            color: Tok.last-error == "" ? Theme.muted : Theme.error;
            font-family: Theme.font-body;
            overflow: elide;
        }
    }
}
