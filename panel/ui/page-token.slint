    Mono {
        x: 0px;
        y: 14px;
        height: 28px;
        text: root.v;
        font-size: 18px;
        font-weight: 700;
        color: root.tint;
        vertical-alignment: TextVerticalAlignment.center;
    }
}

export component PageTokenP inherits Rectangle {
    in property <int> idx: 1;
    x: (root.idx - Ui.page) * ((root.idx - Ui.page) <= 0 ? 256px : 508px);
    animate x {
        duration: 520ms;
        easing: ease-out;
    }
    width: 508px;
    height: 992px;
    property <bool> act: Ui.page == root.idx;
    opacity: act ? 1.0 : 0.0;
    animate opacity {
        duration: 420ms;
        easing: ease-out;
        delay: 40ms;
    }

    // ═══ 今日用量：主读数 ═══ 0–172
    SheetHead {
        x: 0px;
        y: 0px;
        width: 508px;
        title: "今日用量";
        meta: "近 24 小时";
    }
    req_big := Mono {
        x: 0px;
        y: 26px;
        text: Tok.today-reqs;
        font-size: 72px;
        height: 72px;
        vertical-alignment: TextVerticalAlignment.center;
        font-weight: 700;
        color: Theme.emphasis;
    }
    Text {
        x: req_big.x + req_big.preferred-width + 8px;
        y: 72px;
        text: "次请求";
        font-size: 11px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Text {
        x: 330px;
        y: 36px;
        width: 60px;
        height: 16px;
        text: "成功率";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 330px;
        y: 36px;
        width: 178px;
        height: 16px;
        text: Tok.success-str + "%";
        font-size: 10.5px;
        color: Theme.emphasis;
        horizontal-alignment: TextHorizontalAlignment.right;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 330px;
        y: 58px;
        width: 60px;
        height: 16px;
        text: "费用";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 330px;
        y: 58px;
        width: 178px;
        height: 16px;
        text: Tok.t-cost;
        font-size: 10.5px;
        color: Theme.emphasis;
        horizontal-alignment: TextHorizontalAlignment.right;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 330px;
        y: 80px;
        width: 60px;
        height: 16px;
        text: "缓存率";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 330px;
        y: 80px;
        width: 178px;
        height: 16px;
        text: Tok.t-hit;
        font-size: 10.5px;
        color: Theme.fg;
        horizontal-alignment: TextHorizontalAlignment.right;
        vertical-alignment: TextVerticalAlignment.center;
    }
    // 次级读数：两列
    Text {
        x: 0px;
        y: 122px;
        text: "Tokens";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Mono {
        x: 0px;
        y: 136px;
        width: 246px;
        text: Tok.t-tokens;
        font-size: 13px;
        font-weight: 700;
        color: Theme.emphasis;
    }
    Text {
        x: 262px;
        y: 122px;
        text: "缓存命中";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Mono {
        x: 262px;
        y: 136px;
        width: 246px;
        text: Tok.t-cached;
        font-size: 13px;
        font-weight: 700;
        color: Theme.fg;
    }
    // Rust 侧这两条是带标签的整句，作为脚注一左一右
    Text {
        x: 0px;
        y: 156px;
        text: Tok.daily-avg;
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Text {
        x: 0px;
        y: 156px;
        width: 508px;
        text: Tok.forecast;
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        horizontal-alignment: TextHorizontalAlignment.right;
    }
    Rectangle {
        x: 0px;
        y: 172px;
        width: 508px;
        height: 1px;
        background: Theme.border;
    }

    // ═══ 实时吞吐（示波器）═══ 180–356
    SheetHead {
        x: 0px;
        y: 180px;
        width: 508px;
        title: "实时吞吐";
        meta-w: 96px;
        meta: Tok.ws-ok ? "WS 在线" : "WS 断开";
        meta-tint: Tok.ws-ok ? Theme.success : Theme.warning;
    }
    tps_big := Mono {
        x: 0px;
        y: 206px;
        text: Tok.tps-str;
        font-size: 26px;
        height: 26px;
        vertical-alignment: TextVerticalAlignment.center;
        font-weight: 700;
        color: Theme.emphasis;
    }
    Text {
        x: tps_big.x + tps_big.preferred-width + 6px;
        y: 216px;
        text: "tokens/s";
        font-size: 9px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Tag {
        x: parent.width - self.width;
        y: 208px;
        label: "活跃流 \{Tok.streams}";
        tint: Tok.streams > 0 ? Theme.success : Theme.muted;
        dot: true;
    }
    Well {
        x: 0px;
        y: 242px;
        width: 508px;
        height: 80px;
    }
    AreaChart {
        x: 0px;
        y: 242px;
        width: 508px;
        height: 80px;
        line-pts: Tok.tps-line-p;
        area-pts: Tok.tps-area-p;
        tint: Theme.accent;
    }
    Mono {
        x: 0px;
        y: 328px;
        width: 508px;
        text: Tok.tps-info;
        font-size: 8px;
        color: Theme.muted;
        overflow: elide;
    }
    Text {
        x: 0px;
        y: 344px;
        text: "最近一次调用";
        font-size: 8px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    Text {
        x: 76px;
        y: 342px;
        width: 432px;
        text: Tok.last-req;
        font-size: 9.5px;
        color: Theme.fg;
        font-family: Theme.font-body;
        overflow: elide;
    }

    // ═══ 模型排行 ═══ 368–552
    SheetHead {
        x: 0px;
        y: 368px;
        width: 508px;
        title: "模型排行";
        meta: "近 7 天 · 按费用";
    }
    if Tok.models.length == 0: Text {
        x: 0px;
        y: 404px;
        text: "无数据";
        font-size: 10px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    for m[i] in Tok.models: ModelRow {
        x: 0px;
        y: 392px + i * 32px;
        visible: i < 5;
        name: m.name;
        reqs: m.reqs;
        tokens: m.tokens;
        cost: m.cost;
        share-str: m.share-str;
        share: m.share;
        idx: i;
    }

    // ═══ 上游渠道 ═══ 564–708
    SheetHead {
        x: 0px;
        y: 564px;
        width: 508px;
        title: "上游渠道";
        meta: "Top 4 · 条=平均延迟";
    }
    if Tok.chans.length == 0: Text {
        x: 0px;
        y: 600px;
        text: "无数据";
        font-size: 10px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    for ch[i] in Tok.chans: ChanRow {
        x: 0px;
        y: 588px + i * 30px;
        visible: i < 4;
        name: ch.name;
        reqs: ch.reqs;
        avg: ch.avg;
        balance: ch.balance;
        cost: ch.cost;
        share: ch.share;
        health: ch.health;
    }

    // ═══ 质量指标 ═══ 720–854
    SheetHead {
        x: 0px;
        y: 720px;
        width: 508px;
        title: "质量指标";
        meta: "近 7 天";
    }
    QStat {
        x: 0px;
        y: 748px;
        k: "错误率";
        v: Tok.err-str + "%";
        tint: Tok.err-pct < 3.0 ? Theme.emphasis : (Tok.err-pct < 10.0 ? Theme.warning : Theme.error);
    }
    QStat {
        x: 169px;
        y: 748px;
        k: "平均延迟";
        v: Tok.avg-lat;
        tint: Tok.avg-lat == "--" ? Theme.muted : (Tok.avg-lat-num < 3.0 ? Theme.emphasis : (Tok.avg-lat-num < 8.0 ? Theme.warning : Theme.error));
    }
    QStat {
        x: 338px;
        y: 748px;
        k: "缓存命中";
        v: Tok.cache7;
        tint: Tok.cache7-num >= 80.0 ? Theme.emphasis : (Tok.cache7-num >= 50.0 ? Theme.warning : Theme.error);
    }
    Well {
        x: 0px;
        y: 796px;
        width: 508px;
        height: 40px;
    }
    AreaChart {
        x: 0px;
        y: 796px;
        width: 508px;
        height: 40px;
        line-pts: Tok.trend-line-p;
        area-pts: Tok.trend-area-p;
        tint: Theme.accent;
    }
    Mono {
        x: 0px;
        y: 842px;
        width: 508px;
        text: Tok.trend-info;
        font-size: 8px;
        color: Theme.muted;
        overflow: elide;
    }

    // ═══ 调用方 / 网关与累计 ═══ 866–978
    SheetHead {
        x: 0px;
        y: 866px;
        width: 246px;
        title: "调用方";
    }
    SheetHead {
        x: 262px;
        y: 866px;
        width: 246px;
        title: "网关与累计";
        meta: Tok.gw-state;
        meta-w: 76px;
    }
    if Tok.keys.length == 0: Text {
        x: 0px;
        y: 898px;
        text: "无数据";
        font-size: 9px;
        color: Theme.muted;
        font-family: Theme.font-body;
    }
    for k[i] in Tok.keys: Rectangle {
        x: 0px;
        y: 892px + i * 22px;
        width: 246px;
        height: 20px;
        visible: i < 4;
        Text {
            x: 0px;
            y: 0px;
            width: 124px;
            height: 100%;
            text: k.name;
            font-size: 9.5px;
            color: Theme.fg;
            font-family: Theme.font-body;
            overflow: elide;
            vertical-alignment: TextVerticalAlignment.center;
        }
        Mono {
            x: 124px;
            y: 0px;
            width: 44px;
            height: 100%;
            text: k.reqs;
            font-size: 8.5px;
            color: Theme.muted;
            vertical-alignment: TextVerticalAlignment.center;
        }
        Mono {
            x: 170px;
            y: 0px;
            width: 36px;
            height: 100%;
            text: k.share;
            font-size: 8px;
            color: Theme.muted;
            vertical-alignment: TextVerticalAlignment.center;
        }
        Mono {
            x: 206px;
            y: 0px;
            width: 40px;
            height: 100%;
            text: k.cost;
            font-size: 9.5px;
            font-weight: 700;
            color: Theme.emphasis;
            horizontal-alignment: TextHorizontalAlignment.right;
            vertical-alignment: TextVerticalAlignment.center;
        }
    }
    Text {
        x: 262px;
        y: 892px;
        width: 90px;
        height: 20px;
        text: "累计 tokens";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 352px;
        y: 892px;
        width: 156px;
        height: 20px;
        text: Tok.lt-tokens;
        font-size: 10.5px;
        color: Theme.emphasis;
        horizontal-alignment: TextHorizontalAlignment.right;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 262px;
        y: 914px;
        width: 90px;
        height: 20px;
        text: "峰值日";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 352px;
        y: 914px;
        width: 156px;
        height: 20px;
        text: Tok.lt-peak;
        font-size: 10.5px;
        color: Theme.fg;
        horizontal-alignment: TextHorizontalAlignment.right;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 262px;
        y: 936px;
        width: 90px;
        height: 20px;
        text: "连续 / 最长";
        font-size: 8.5px;
        color: Theme.muted;
        font-family: Theme.font-body;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Mono {
        x: 352px;
        y: 936px;
        width: 156px;
        height: 20px;
        text: Tok.lt-streak;
        font-size: 10.5px;
        color: Theme.fg;
        horizontal-alignment: TextHorizontalAlignment.right;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 262px;
        y: 958px;
        width: 246px;
        height: 20px;
        text: Tok.last-error == "" ? Tok.budget : Tok.last-error;
        font-size: 8.5px;
        color: Tok.last-error == "" ? Theme.muted : Theme.error;
        font-family: Theme.font-body;
        overflow: elide;
        vertical-alignment: TextVerticalAlignment.center;
    }
}
