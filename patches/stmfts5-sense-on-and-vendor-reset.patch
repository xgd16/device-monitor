 static int stmfts_resume(struct device *dev)
 {
 	struct stmfts_data *sdata = dev_get_drvdata(dev);
+	int ret;
 
-	return stmfts_power_on(sdata);
+	ret = stmfts_power_on(sdata);
+	if (ret)
+		return ret;
+
+	/*
+	 * stmfts_power_on() resets and reconfigures the chip, but the input
+	 * device stays open across system suspend, so ->input_open() is not
+	 * called and the FTS5 scan engine remains stopped.  Restart scanning
+	 * if the device is logically open.
+	 */
+	if (sdata->running && sdata->ops->start_scan) {
+		ret = sdata->ops->start_scan(sdata);
+		if (ret)
+			dev_err(dev, "failed to restart scan after resume: %d\n", ret);
+	}
+
+	return ret;
 }
 
