+static void stmfts_shutdown(struct i2c_client *client)
+{
+	struct stmfts_data *sdata = i2c_get_clientdata(client);
+
+	/*
+	 * Perseus: make a warm reboot behave like a power cycle for the FTS5.
+	 * Assert reset and drop the touch rails; otherwise the chip can come
+	 * back with its scan engine stopped (STATUS_UPDATE only).  reset_gpio
+	 * is active-low on this board (see the vendor-property fallback).
+	 */
+	if (sdata->reset_gpio)
+		gpiod_set_value_cansleep(sdata->reset_gpio, 1);
+	stmfts_power_off(sdata);
+}
