+		if (IS_ERR(sdata->reset_gpio))
+			return dev_err_probe(dev, PTR_ERR(sdata->reset_gpio),
+					     "Failed to get GPIO 'st,reset'\n");
+		if (sdata->reset_gpio) {
+			/* Perseus wires this line active-low, but the vendor DT */
+			/* property has no GPIO_ACTIVE_LOW flag.  Flip the descriptor */
+			/* so gpiod_set_value(1) really asserts reset. */
+			gpiod_toggle_active_low(sdata->reset_gpio);
+			dev_info(dev, "using vendor reset GPIO 'st,reset-gpio' (active-low)\n");
+		}
