+static int stmfts5_start_scan(struct stmfts_data *sdata)
+{
+	int err;
+
+	err = stmfts5_set_scan_mode(sdata, 0xff);
+	if (err) {
+		dev_err(&sdata->client->dev,
+			"set_scan_mode(0xff) failed: %d (touch dead)\n", err);
+		return err;
+	}
+
+	/*
+	 * The FTS4 path uses MS_MT_SENSE_ON to actually start the analog
+	 * scan engine; FTS5 mainline only issues the 0xa0 scan-mode command.
+	 * On this unit the scan engine can stay stopped after a warm reboot
+	 * even though 0xa0/0xff was accepted, so issue the explicit sense-on
+	 * as well.
+	 */
+	err = i2c_smbus_write_byte(sdata->client, STMFTS_MS_MT_SENSE_ON);
+	if (err)
+		dev_warn(&sdata->client->dev,
+			 "MS_MT_SENSE_ON failed: %d\n", err);
+
+	return err;
+}
