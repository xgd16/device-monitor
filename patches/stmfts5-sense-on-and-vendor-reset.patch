+/*
+ * Perseus: the FTS5 can come out of a warm reboot with its scan engine
+ * stopped (only STATUS_UPDATE interrupts).  A longer reset pulse than the
+ * 20 ms datasheet minimum is sometimes needed; make it tunable so the
+ * minimum can be found at runtime without rebuilding the module.
+ */
+static unsigned int reset_hold_ms = 500;
+module_param(reset_hold_ms, uint, 0644);
+MODULE_PARM_DESC(reset_hold_ms, "Touch IC reset assert time in milliseconds");
+static unsigned int reset_release_ms = 100;
+module_param(reset_release_ms, uint, 0644);
+MODULE_PARM_DESC(reset_release_ms, "Touch IC reset release-to-I2C time in milliseconds");
